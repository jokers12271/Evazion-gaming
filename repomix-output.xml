          <NeonButton
            variant="orange"
            size="sm"
            onClick={() => {
              if (!p1 || !p2 || !winner) return toast.error("Tous les champs sont requis.");
              toast.success(`Victoire enregistrée pour @${winner} ! Classement mis à jour.`);
              setP1(''); setP2(''); setWinner('');
