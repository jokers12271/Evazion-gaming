          {isOpen ? 'Fermer' : '+ Enregistrer un résultat'}
        </button>
      </div>

      {isOpen && (
        <CyberCard variant="orange" hoverEffect={false} className="p-6">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
