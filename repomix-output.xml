<file path="src/components/ui/AmbientThemeSelector.tsx">
import React, { useState, useRef, useEffect } from 'react'
import { Palette, Zap, Sparkles, Crown } from 'lucide-react'
import { useAmbientTheme } from '@/hooks/useAmbientTheme'
import { cn } from '@blinkdotnew/ui'

export function AmbientThemeSelector() {
  const { theme, setTheme } = useAmbientTheme()
  const [isOpen, setIsOpen] = useState(false)
  const menuRef = useRef<HTMLDivElement>(null)

  useEffect(() => {
    const handleClickOutside = (e: MouseEvent) => {
      if (menuRef.current && !menuRef.current.contains(e.target as Node)) {
        setIsOpen(false)
      }
    }
    document.addEventListener('mousedown', handleClickOutside)
    return () => document.removeEventListener('mousedown', handleClickOutside)
  }, [])

  const themes = [
    { id: 'cyan', label: 'Evazion Cyan', icon: <Zap size={14} className="text-cyan-400" />, color: '#06b6d4' },
    { id: 'violet', label: 'Sanctuary Violet', icon: <Sparkles size={14} className="text-purple-400" />, color: '#a855f7' },
    { id: 'gold', label: 'Ragnarök Gold', icon: <Crown size={14} className="text-amber-400" />, color: '#f59e0b' },
    { id: 'matrix', label: 'Brazza Matrix', icon: <Zap size={14} className="text-emerald-400" />, color: '#22c55e' },
  ]

  return (
    <div className="relative" ref={menuRef}>
      <button
        onClick={() => setIsOpen(!isOpen)}
        className="p-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-secondary/50 text-white/70 hover:text-white transition-all flex items-center justify-center shadow-lg"
        title="Changer l'ambiance lumineuse"
      >
        <Palette size={18} className="text-secondary" />
      </button>

      {isOpen && (
        <div className="absolute right-0 mt-3 w-56 rounded-2xl bg-[#070810]/95 border border-white/10 backdrop-blur-2xl shadow-[0_10px_30px_rgba(0,0,0,0.8)] p-2 z-50 animate-fade-in text-left">
          <div className="px-3 py-2 border-b border-white/5 mb-1">
            <span className="text-[9px] font-mono font-black uppercase tracking-widest text-white/40">
              Ambiance Cyber
            </span>
          </div>
          {themes.map(t => (
            <button
              key={t.id}
              onClick={() => {
                setTheme(t.id as any)
                setIsOpen(false)
              }}
              className={cn(
                "w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all",
                theme === t.id
                  ? "bg-white/10 text-white border border-white/15 shadow-md"
                  : "text-white/60 hover:text-white hover:bg-white/5"
              )}
            >
              <span className="w-2.5 h-2.5 rounded-full shadow-lg" style={{ backgroundColor: t.color }} />
              <span className="flex-1">{t.label}</span>
              {theme === t.id && <span className="text-[10px] text-secondary font-mono">ACTIF</span>}
            </button>
          ))}
        </div>
      )}
    </div>
  )
}
</file>

<file path="src/components/ui/ConfirmDialog.tsx">
import { createPortal } from 'react-dom'
import { useEffect, useRef } from 'react'
import { TriangleAlert, X } from 'lucide-react'
import { CyberCard } from '@/components/ui/CyberCard'
import { NeonButton } from '@/components/ui/NeonButton'

export interface ConfirmOptions {
  title: string
  /** Nom de l'element concerne, affiche en dessous du titre. */
  subject?: string
  message?: string
  confirmLabel?: string
  cancelLabel?: string
  isPending?: boolean
  onConfirm: () => void
}

/**
 * Boite de confirmation de suppression, dans le style des autres modales du
 * projet (CyberCard + NeonButton en portal).
 *
 * Elle remplace les `window.confirm()` : ces derniers bloquent le thread,
 * s'affichent hors theme et ne permettent pas d'indiquer quel element est
 * reellement supprime.
 */
export function ConfirmDialog({
  title,
  subject,
  message,
  confirmLabel = 'SUPPRIMER',
  cancelLabel = 'ANNULER',
  isPending = false,
  onConfirm,
  onClose,
}: ConfirmOptions & { onClose: () => void }) {
  const confirmRef = useRef<HTMLButtonElement>(null)

  // Echap annule, Entree valide, et le focus part sur l'action principale.
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') onClose()
      if (e.key === 'Enter') onConfirm()
    }
    window.addEventListener('keydown', onKey)
    confirmRef.current?.focus()
    return () => window.removeEventListener('keydown', onKey)
  }, [onClose, onConfirm])

  return createPortal(
    <div className="fixed inset-0 bg-black/80 backdrop-blur-md z-[9999] flex items-center justify-center p-4 animate-fade-in text-center text-white font-display">
      <CyberCard
        accentColor="#ef4444"
        hoverEffect={false}
        className="p-10 max-w-md w-full"
        topRight={
          <button
            onClick={onClose}
            className="absolute top-6 right-6 text-white/40 hover:text-white transition-colors focus:outline-none"
            aria-label="Fermer"
          >
            <X size={20} />
          </button>
        }
      >
        <div className="w-16 h-16 bg-red-500/20 rounded-full flex items-center justify-center mx-auto mb-6 border border-red-500/30">
          <TriangleAlert className="text-red-400" size={32} />
        </div>

        <h3 className="text-2xl font-black uppercase mb-2">{title}</h3>
        {subject && (
          <p className="text-[10px] text-red-400 font-black uppercase tracking-widest mb-6 break-words">
            {subject}
          </p>
        )}

        <p className="text-[11px] text-white/60 tracking-normal leading-relaxed mb-8">
          {message ?? 'Cette action est definitive et ne peut pas etre annulee.'}
        </p>

        <div className="flex flex-col gap-4">
          <NeonButton
            ref={confirmRef}
            variant="danger"
            className="w-full py-4 text-xs font-black"
            onClick={onConfirm}
            disabled={isPending}
          >
            {isPending ? 'SUPPRESSION...' : confirmLabel}
          </NeonButton>
          <button
            onClick={onClose}
            disabled={isPending}
            className="text-[10px] font-black uppercase text-white/40 tracking-widest hover:text-white transition-colors focus:outline-none disabled:opacity-30"
          >
            {cancelLabel}
          </button>
        </div>
      </CyberCard>
    </div>,
    document.body
  )
}
</file>

