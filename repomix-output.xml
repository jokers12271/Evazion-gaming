import React from 'react';
import { Award, Lock, CheckCircle2, Sparkles, Coins } from 'lucide-react';
import { CyberCard } from '@/components/ui/CyberCard';
import { useCommunityStore, Achievement } from '@/lib/communityData';

export function AchievementsGrid() {
  const communityDataStore = useCommunityStore();
  const achievements: Achievement[] = communityDataStore.getAchievements();

  const unlockedCount = achievements.filter(a => a.unlocked).length;

  return (
    <div className="space-y-6 text-left font-display">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/10">
        <div>
          <h3 className="text-xl md:text-2xl font-black uppercase text-white flex items-center gap-2">
            <Award className="text-amber-400" size={24} /> Vitrine des Trophées & Badges de Légende
          </h3>
          <p className="text-xs text-white/50 font-sans mt-0.5">
            Accomplissez des exploits au Sanctuary pour débloquer ces insignes et encaisser vos primes en jetons MANI.
          </p>
        </div>

        <div className="px-4 py-2 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center gap-3 shrink-0">
          <Sparkles className="text-amber-400" size={18} />
          <div>
            <div className="text-[9px] font-mono uppercase text-amber-400 font-black">
              Badges Débloqués
            </div>
            <div className="text-sm font-black text-white">
              {unlockedCount} sur {achievements.length} complétés
            </div>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {achievements.map((ach) => (
          <div
            key={ach.id}
            className={`p-5 rounded-2xl border transition-all flex flex-col justify-between ${
              ach.unlocked
                ? 'bg-gradient-to-br from-white/[0.04] to-amber-500/[0.05] border-amber-500/40 shadow-lg'
                : 'bg-white/[0.02] border-white/10 opacity-70'
            }`}
          >
            <div>
              <div className="flex items-start justify-between gap-3 mb-3">
                <div className="w-12 h-12 rounded-2xl bg-black/50 border border-white/15 flex items-center justify-center text-2xl shadow-inner">
                  {ach.icon}
                </div>
                {ach.unlocked ? (
                  <span className="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[8px] font-mono uppercase font-black flex items-center gap-1">
                    <CheckCircle2 size={11} /> OBTENU
                  </span>
                ) : (
                  <span className="px-2.5 py-1 rounded-full bg-white/10 text-white/40 text-[8px] font-mono uppercase flex items-center gap-1">
                    <Lock size={10} /> BLOQUÉ
                  </span>
                )}
              </div>

              <h4 className="text-sm font-black uppercase text-white mb-1">
                {ach.title}
              </h4>
              <p className="text-xs text-white/60 font-sans mb-4">
                {ach.description}
              </p>
            </div>

            <div className="pt-3 border-t border-white/5 flex items-center justify-between text-xs font-mono">
              <span className="text-amber-400 font-black flex items-center gap-1">
                <Coins size={12} /> +{ach.mani_reward} MANI
              </span>
              {ach.max_progress && (
                <span className="text-[10px] text-white/40">
                  {ach.progress} / {ach.max_progress}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
