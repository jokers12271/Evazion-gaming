      if (error) {
        console.error("Erreur de récupération du classement :", error.message);
        throw error;
      }

      // Filtrage des comptes de test et des administrateurs
      const filtered = (data || []).filter((p: any) => {
        const name = p.display_name?.toLowerCase();
