<file path="src/components/ui/HoloGamerCard.tsx">
import React, { useState, useRef } from 'react';
import { Shield, Sparkles, QrCode, Crown, Zap, Flame, Award, Gamepad2 } from 'lucide-react';
import { getRank } from '@/lib/ranks';
import { cn } from '@/lib/utils';

interface HoloGamerCardProps {
  displayName: string;
  avatarUrl?: string;
  totalHours: number;
  maniBalance?: number;
  userId?: string;
  isVip?: boolean;
}

export function HoloGamerCard({
  displayName,
  avatarUrl,
  totalHours,
  maniBalance = 0,
  userId = 'GMR-BZV-2026',
  isVip = false
}: HoloGamerCardProps) {
  const cardRef = useRef<HTMLDivElement>(null);
  const [rotateX, setRotateX] = useState(0);
  const [rotateY, setRotateY] = useState(0);
  const [glareX, setGlareX] = useState(50);
  const [glareY, setGlareY] = useState(50);
  const [isHovered, setIsHovered] = useState(false);

  const rank = getRank(totalHours);
  const isGoldTier = rank.name === 'Légende' || rank.name === 'Ragnarök' || isVip;

  const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {
    if (!cardRef.current) return;
    const rect = cardRef.current.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    const centerX = rect.width / 2;
    const centerY = rect.height / 2;

    const rotX = ((y - centerY) / centerY) * -12;
    const rotY = ((x - centerX) / centerX) * 12;

    setRotateX(rotX);
    setRotateY(rotY);
    setGlareX((x / rect.width) * 100);
    setGlareY((y / rect.height) * 100);
  };

  const handleMouseLeave = () => {
    setIsHovered(false);
    setRotateX(0);
    setRotateY(0);
  };

  return (
    <div
      style={{ perspective: 1000 }}
      className="w-full max-w-md mx-auto py-2 font-display select-none"
    >
      <div
        ref={cardRef}
        onMouseMove={handleMouseMove}
        onMouseEnter={() => setIsHovered(true)}
        onMouseLeave={handleMouseLeave}
        style={{
          transform: `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`,
          transition: isHovered ? 'transform 0.08s ease-out' : 'transform 0.5s ease-out'
        }}
        className={cn(
          "relative aspect-[1.586/1] rounded-3xl p-6 sm:p-7 border overflow-hidden cursor-pointer shadow-2xl flex flex-col justify-between",
          isGoldTier
            ? "border-amber-400/40 bg-[#0c0904] shadow-[0_0_35px_rgba(234,179,8,0.25)]"
            : "border-white/20 bg-[#060810] shadow-[0_0_35px_rgba(6,182,212,0.2)]"
        )}
      >
        {/* Holographic Iridescent Foil Overlay */}
        <div
          className={cn(
            "absolute inset-0 pointer-events-none opacity-40 mix-blend-overlay transition-opacity",
            isGoldTier ? "holo-foil-gold" : "holo-foil",
            isHovered ? "opacity-70" : "opacity-35"
          )}
        />

        {/* Dynamic Light Glare */}
        <div
          className="absolute inset-0 pointer-events-none transition-opacity duration-300"
          style={{
            background: `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255,255,255,0.25) 0%, transparent 60%)`,
            opacity: isHovered ? 1 : 0
          }}
        />

        {/* Top Header of the Pass */}
        <div className="relative z-10 flex items-start justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-black/60 border border-white/20 flex items-center justify-center text-secondary">
              <Gamepad2 size={22} />
            </div>
            <div>
              <div className="text-[10px] font-mono tracking-[0.25em] text-white/50 uppercase">
                MEMBRE OFFICIEL
              </div>
              <div className="text-base sm:text-lg font-black text-white tracking-wider">
                THE SANCTUARY
              </div>
            </div>
          </div>

          <div className="text-right">
            <span
              className={cn(
                "px-2.5 py-1 rounded-full text-[9px] font-mono font-black uppercase tracking-wider border",
                isGoldTier
                  ? "bg-amber-500/20 text-amber-300 border-amber-400/40"
                  : "bg-secondary/20 text-secondary border-secondary/40"
              )}
            >
              {rank.name.toUpperCase()}
            </span>
            <div className="text-[8px] font-mono text-white/40 mt-1">
              BRAZZAVILLE · CONGO
            </div>
          </div>
        </div>

        {/* Center Chip & Security Hologram */}
        <div className="relative z-10 flex items-center justify-between my-2">
          {/* Smartcard Gold Chip */}
          <div className="w-11 h-8 rounded-lg bg-gradient-to-tr from-amber-600 via-amber-400 to-yellow-200 border border-amber-300/60 p-1 flex flex-col justify-between shadow-inner">
            <div className="w-full h-0.5 bg-black/30 rounded" />
            <div className="w-full h-0.5 bg-black/30 rounded" />
            <div className="w-full h-0.5 bg-black/30 rounded" />
          </div>

          {/* Member NFC / Hologram Icon */}
          <div className="flex items-center gap-2 text-white/40 text-[10px] font-mono">
            <Sparkles size={14} className={isGoldTier ? "text-amber-400" : "text-secondary"} />
            <span>PASS SÉCURISÉ NFC</span>
          </div>
        </div>

        {/* Bottom Details & QR Code */}
        <div className="relative z-10 flex items-end justify-between">
          <div>
            <div className="text-xs sm:text-sm font-black text-white tracking-wide truncate max-w-[180px]">
              {displayName || 'Gamer Élite'}
            </div>
            <div className="flex items-center gap-3 text-[10px] font-mono text-white/60 mt-1">
              <span>{totalHours}h de jeu</span>
              <span>·</span>
              <span className="text-amber-400 font-bold">{maniBalance} MANI</span>
            </div>
            <div className="text-[8.5px] font-mono text-white/30 tracking-widest mt-0.5">
              ID: {userId.slice(0, 14)}
            </div>
          </div>

          {/* Mini QR Code Stamp for Lounge Reception */}
          <div className="w-14 h-14 rounded-xl bg-white p-1 shadow-lg shrink-0 flex items-center justify-center">
            <QrCode size={46} className="text-black" />
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/ui/ImageUploadInput.tsx">
import React, { useRef, useState } from 'react';
import { Upload, Link as LinkIcon, Loader2, Check } from 'lucide-react';
import { toast } from 'react-hot-toast';

export function ImageUploadInput({
  value,
  onChange,
  label = "Affiche / Image (URL ou Fichier)"
}: {
  value: string;
  onChange: (url: string) => void;
  label?: string;
}) {
  const [mode, setMode] = useState<'url' | 'file'>('url');
  const [isUploading, setIsUploading] = useState(false);
  const fileRef = useRef<HTMLInputElement>(null);

  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    if (file.size > 2 * 1024 * 1024) {
      toast.error("Image trop lourde (2 Mo maximum)");
      return;
    }

    setIsUploading(true);
    const reader = new FileReader();
    reader.onload = (event) => {
      const res = event.target?.result as string;
      if (res) {
        onChange(res);
        toast.success("Image chargée avec succès !");
      } else {
        toast.error("Erreur lors de la lecture du fichier");
      }
      setIsUploading(false);
    };
    reader.onerror = () => {
      toast.error("Échec de chargement du fichier");
      setIsUploading(false);
    };
    reader.readAsDataURL(file);
  };

  return (
    <div className="space-y-1.5 text-left">
      <div className="flex items-center justify-between">
        <label className="text-[8.5px] uppercase font-black text-white/50 tracking-wider">
          {label}
        </label>
        <div className="flex gap-1 text-[8.5px] font-mono">
          <button
            type="button"
            onClick={() => setMode('url')}
            className={`px-2 py-0.5 rounded border transition-colors ${
              mode === 'url' ? 'border-primary bg-primary/20 text-primary' : 'border-white/10 text-white/40'
            }`}
          >
            URL
          </button>
          <button
            type="button"
            onClick={() => setMode('file')}
            className={`px-2 py-0.5 rounded border transition-colors ${
              mode === 'file' ? 'border-primary bg-primary/20 text-primary' : 'border-white/10 text-white/40'
            }`}
          >
            Fichier
          </button>
        </div>
      </div>

      {mode === 'url' ? (
        <div className="relative">
          <LinkIcon size={13} className="absolute left-3 top-1/2 -translate-y-1/2 text-white/30" />
          <input
            type="url"
            value={value}
            onChange={(e) => onChange(e.target.value)}
            placeholder="https://..."
            className="w-full bg-white/5 border border-white/10 rounded-lg py-2 pl-9 pr-3 text-xs text-white placeholder:text-white/20 focus:outline-none focus:border-primary"
          />
        </div>
      ) : (
        <div className="flex items-center gap-2">
          <input
            ref={fileRef}
            type="file"
            accept="image/*"
            onChange={handleFileUpload}
            className="hidden"
          />
          <button
            type="button"
            onClick={() => fileRef.current?.click()}
            disabled={isUploading}
            className="flex-1 py-2 px-3 bg-white/5 border border-white/10 hover:border-primary rounded-lg text-[11px] font-mono font-black uppercase text-white flex items-center justify-center gap-2 transition-all cursor-pointer"
          >
            {isUploading ? <Loader2 size={13} className="animate-spin" /> : <Upload size={13} />}
            {isUploading ? "Chargement..." : "Choisir depuis le stockage"}
          </button>
        </div>
      )}

      {value && (
        <div className="flex items-center gap-2.5 p-1.5 rounded-lg bg-white/[0.03] border border-white/10">
          <img src={value} alt="Preview" className="w-10 h-10 object-cover rounded-md" />
          <span className="text-[9px] text-white/60 font-mono truncate flex-1">{value.startsWith('data:') ? 'Image locale chargée' : value}</span>
          <span className="text-[8.5px] font-mono text-emerald-400 flex items-center gap-0.5 font-black">
            <Check size={11} /> OK
          </span>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/ui/ThemeSelector.tsx">
import React, { useState, useRef, useEffect } from 'react';
import { Palette, Check, Sparkles } from 'lucide-react';
import { useNeonTheme, THEMES, NeonThemeId } from '@/lib/theme';
import { cn } from '@/lib/utils';
import { cyberAudio } from '@/lib/cyberAudio';
import { toast } from 'react-hot-toast';

export function ThemeSelector() {
  const { currentTheme, setTheme, availableThemes } = useNeonTheme();
  const [isOpen, setIsOpen] = useState(false);
  const dropdownRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleClickOutside = (e: MouseEvent | TouchEvent) => {
      if (dropdownRef.current && !dropdownRef.current.contains(e.target as Node)) {
        setIsOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    document.addEventListener('touchstart', handleClickOutside);
    return () => {
      document.removeEventListener('mousedown', handleClickOutside);
      document.removeEventListener('touchstart', handleClickOutside);
    };
  }, []);

  const handleSelect = (th: typeof availableThemes[0]) => {
    setTheme(th.id);
    cyberAudio.playSuccess();
    toast.success(`Ambiance activée : ${th.name} ✨`, {
      id: 'theme-change-toast',
      position: 'bottom-center',
      icon: '🎨'
    });
    setIsOpen(false);
  };

  return (
    <div className="relative" ref={dropdownRef}>
      <button
        type="button"
        onClick={() => {
          setIsOpen(!isOpen);
          cyberAudio.playClick();
        }}
        title="Changer l'ambiance lumineuse néon"
        className="px-2.5 py-1.5 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 text-white/80 hover:text-white text-[9px] font-mono font-black uppercase tracking-wider flex items-center gap-1.5 cursor-pointer transition-all active:scale-95"
      >
        <span
          className="w-2.5 h-2.5 rounded-full border border-white/40 shadow-sm"
          style={{ backgroundColor: currentTheme.primary }}
        />
        <Palette size={12} />
        <span className="hidden md:inline">{currentTheme.name.split(' ')[0]}</span>
      </button>

      {isOpen && (
        <div className="absolute right-0 top-full mt-2 w-72 rounded-2xl border border-white/20 bg-[#07090e]/98 backdrop-blur-3xl p-3 shadow-[0_10px_40px_rgba(0,0,0,0.8)] z-[9999] animate-fade-in font-display">
          <div className="flex items-center justify-between pb-2.5 mb-2.5 border-b border-white/10 px-1">
            <div>
              <span className="text-[10px] font-mono uppercase tracking-widest text-white/80 block">
                Ambiance Néon Lounge
              </span>
              <span className="text-[8px] font-sans text-white/40">
                L'éclairage du Sanctuary s'adapte en direct
              </span>
            </div>
            <Sparkles size={14} className="text-secondary" />
          </div>

          <div className="space-y-1.5">
            {availableThemes.map((th) => {
              const isActive = th.id === currentTheme.id;
              return (
                <button
                  type="button"
                  key={th.id}
                  onClick={() => handleSelect(th)}
                  className={cn(
                    "w-full flex items-center justify-between p-2.5 rounded-xl text-left transition-all cursor-pointer select-none",
                    isActive
                      ? "bg-white/15 border border-white/30 text-white shadow-md"
                      : "hover:bg-white/5 text-white/70 hover:text-white border border-transparent"
                  )}
                >
                  <div className="flex items-center gap-3">
                    <div className="flex items-center gap-1">
                      <span
                        className="w-4 h-4 rounded-md shadow-sm border border-white/20"
                        style={{ backgroundColor: th.primary }}
                      />
                      <span
                        className="w-2.5 h-4 rounded-md opacity-80 border border-white/20"
                        style={{ backgroundColor: th.secondary }}
                      />
                    </div>
                    <div>
                      <div className="text-xs font-black tracking-tight text-white flex items-center gap-1.5">
                        {th.name}
                      </div>
                      <div className="text-[9px] font-mono text-white/40">
                        {th.tagline}
                      </div>
                    </div>
                  </div>
                  {isActive ? (
                    <span className="p-1 rounded-full bg-secondary/20 text-secondary">
                      <Check size={13} />
