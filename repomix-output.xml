          </h3>
          <p className="text-xs text-white/50 font-sans mt-0.5">
            Misez vos jetons MANI sur le vainqueur de la Grande Finale. Doublez votre mise en cas de victoire !
          </p>
        </div>
      </div>

      {liveFinal && (
        <CyberCard variant="violet" hoverEffect={false} className="p-6 md:p-8">
          <div className="flex items-center justify-between mb-4">
            <span className="px-2.5 py-1 rounded-full bg-red-500/20 text-red-400 border border-red-500/30 text-[9px] font-mono font-black uppercase tracking-widest animate-pulse">
              Match en Cours · Grande Finale EA FC 26
            </span>
            <span className="text-xs font-mono text-amber-400 font-bold">
              Cote de Gain : x2.0
            </span>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <button
              type="button"
              onClick={() => setSelectedWinner({ id: liveFinal.player1.id, name: liveFinal.player1.name })}
              className={`p-4 rounded-xl border text-left cursor-pointer transition-all ${
                selectedWinner?.id === liveFinal.player1.id
                  ? 'border-secondary bg-secondary/20 shadow-neon-cyan'
                  : 'border-white/10 bg-black/40 hover:border-white/30'
              }`}
            >
              <div className="text-[10px] font-mono uppercase text-white/40 mb-1">
                Finaliste 1 · {liveFinal.player1.team}
              </div>
              <div className="text-lg font-black uppercase text-white">
                {liveFinal.player1.name}
              </div>
              <div className="text-xs font-mono text-secondary mt-1">
                Score actuel : {liveFinal.player1.score}
              </div>
            </button>

            <button
              type="button"
              onClick={() => setSelectedWinner({ id: liveFinal.player2.id, name: liveFinal.player2.name })}
              className={`p-4 rounded-xl border text-left cursor-pointer transition-all ${
                selectedWinner?.id === liveFinal.player2.id
                  ? 'border-primary bg-primary/20 shadow-neon-violet'
                  : 'border-white/10 bg-black/40 hover:border-white/30'
              }`}
            >
              <div className="text-[10px] font-mono uppercase text-white/40 mb-1">
