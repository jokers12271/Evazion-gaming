<file path="src/hooks/usePrivileges.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from './useAuth'

export function usePrivileges() {
  const { user } = useAuth()
  const queryClient = useQueryClient()

  // 1. Lire toutes les réclamations de privilèges du joueur (historique à vie)
  const myClaims = useQuery({
    queryKey: ['my_privilege_claims', user?.id],
    queryFn: async () => {
      if (!user) return []
      const { data, error } = await supabase
        .from('user_privilege_claims')
        .select('*')
        .eq('user_id', user.id)
      if (error) throw error
      return data || []
    },
    enabled: !!user
  })

  // 2. Lire toutes les réclamations en attente (Admin seulement)
  const pendingClaims = useQuery({
    queryKey: ['all_pending_privilege_claims'],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('user_privilege_claims')
        .select('*, users_metadata(display_name)')
        .eq('status', 'pending')
        .order('claimed_at', { ascending: true })
      if (error) throw error
      return data || []
    }
  })

  // 3. Soumettre une demande de consommation de privilège (Joueur)
  const claimPrivilege = useMutation({
    mutationFn: async ({ privilegeKey, message }: { privilegeKey: string, message: string }) => {
      if (!user) throw new Error("Vous devez être connecté.")

      const { error: claimErr } = await supabase
        .from('user_privilege_claims')
        .insert([{
          user_id: user.id,
          privilege_key: privilegeKey,
          status: 'pending'
        }])

      if (claimErr) throw claimErr

      const { data: admins } = await supabase
        .from('users_metadata')
        .select('user_id')
        .eq('is_admin', true)

      if (admins && admins.length > 0) {
        const notifs = admins.map(admin => ({
          user_id: admin.user_id,
          message: message
        }))
        await supabase.from('notifications').insert(notifs)
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['my_privilege_claims', user?.id] })
    }
  })

  // 4. Valider la distribution d'un privilège (Admin)
  const approveClaim = useMutation({
    mutationFn: async ({ claimId, userId, privilegeTitle }: { claimId: string, userId: string, privilegeTitle: string }) => {
      const { error } = await supabase
        .from('user_privilege_claims')
        .update({ status: 'approved', approved_at: new Date().toISOString() })
        .eq('id', claimId)

      if (error) throw error

      await supabase.from('notifications').insert([{
        user_id: userId,
        message: `Votre privilège "${privilegeTitle}" a bien été validé et consommé !`
      }])
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['all_pending_privilege_claims'] })
      queryClient.invalidateQueries({ queryKey: ['my_privilege_claims'] })
    }
  })

  // 5. CORRIGÉ : Vérifier si le joueur a déjà eu son bonus de minutes précis cette semaine (avec support d'ID cible)
  const checkWeeklyBonusUsed = (bonusMinutes: number, targetUserId?: string) => {
    const finalUserId = targetUserId || user?.id; // Utilise le joueur ciblé s'il est fourni
    return useQuery({
      queryKey: ['weekly_bonus_used', finalUserId, bonusMinutes],
      queryFn: async () => {
        if (!finalUserId || bonusMinutes <= 0) return false

        // Calcul du lundi de la semaine civile en cours
        const now = new Date()
        const day = now.getDay()
        const diff = now.getDate() - day + (day === 0 ? -6 : 1)
        const monday = new Date(now.setDate(diff))
        monday.setHours(0, 0, 0, 0)

        // Cherche s'il existe une réservation non annulée de ce joueur cette semaine avec ce bonus précis
        const { data, error } = await supabase
          .from('reservations')
          .select('id')
          .eq('user_id', finalUserId)
          .neq('status', 'annulé')
          .eq('bonus_minutes_applied', bonusMinutes)
          .gte('start_time', monday.toISOString())

        if (error) throw error
        return (data || []).length > 0
      },
      enabled: !!finalUserId && bonusMinutes > 0
    })
  }

  return { myClaims, pendingClaims, claimPrivilege, approveClaim, checkWeeklyBonusUsed }
}
</file>

<file path="src/hooks/useRagnarok.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from './useAuth'
import { getRank, RANKS } from '@/lib/ranks'

export interface Challenge {
  id: string
  challenger_id: string
  challenged_id: string
  currency_type: 'MANI' | 'Hours'
  amount: number
  challenged_wager: number
  scheduled_at: string
  status: 'pending' | 'active' | 'completed' | 'cancelled'
  winner_id: string | null
  created_at: string
  challenger_metadata?: { display_name: string; avatar_url: string; community_team: string }
  challenged_metadata?: { display_name: string; avatar_url: string; community_team: string }
}

export function useRagnarok() {
  const { user } = useAuth()
  const queryClient = useQueryClient()

  // 1. Lire mes défis actifs (Avec masquage automatique à 48h des duels clos)
  const myChallenges = useQuery({
    queryKey: ['ragnarok_challenges', user?.id],
    queryFn: async () => {
      if (!user) return []
      const { data, error } = await (supabase.from('ragnarok_challenges') as any)
        .select(`
          *,
          challenger_metadata:users_metadata!challenger_id ( display_name, avatar_url, community_team ),
          challenged_metadata:users_metadata!challenged_id ( display_name, avatar_url, community_team )
        `)
        .or(`challenger_id.eq.${user.id},challenged_id.eq.${user.id}`)
        .order('created_at', { ascending: false })

      if (error) throw error

      // Appliquer le masquage de 48 heures pour les défis terminés ou annulés
      const now = new Date();
      const fortyEightHoursAgo = new Date(now.getTime() - 48 * 60 * 60 * 1000);

      return (data || []).filter((c: any) => {
        // Toujours afficher si le défi est actif ou en attente
        if (c.status === 'pending' || c.status === 'active') {
          return true;
        }
        const createdAt = new Date(c.created_at);
        return createdAt >= fortyEightHoursAgo;
      });
    },
    enabled: !!user,
    refetchInterval: 10000 
  })

  // 2. MODIFIÉ : Créer (lancer) un défi Ragnarok (Avec enregistrement de l'arène de la Team pour les victoires mensuelles)
  const createChallenge = useMutation({
    mutationFn: async ({ challengedId, currencyType, amount, scheduledAt, teamId }: {
      challengedId: string,
      currencyType: 'MANI' | 'Hours',
      amount: number,
      scheduledAt: string,
      teamId: string // AJOUTÉ
    }) => {
      if (!user) throw new Error("Vous devez être connecté.")

      // A. Récupérer les métadonnées de profil du Challenger (Moi)
      const { data: challengerMeta, error: cMetaErr } = await supabase
        .from('users_metadata')
        .select('*')
        .eq('user_id', user.id)
        .maybeSingle()

      if (cMetaErr) throw cMetaErr;

      // B. Récupérer séparément les heures réelles du Challenger
      const { data: challengerLp, error: cLpErr } = await supabase
        .from('loyalty_points')
        .select('total_hours')
        .eq('user_id', user.id)
        .maybeSingle()

      if (cLpErr) throw cLpErr;

      // C. Récupérer les métadonnées de profil du défié (Challenged)
      const { data: challengedMeta, error: dMetaErr } = await supabase
        .from('users_metadata')
        .select('*')
        .eq('user_id', challengedId)
        .maybeSingle()

      if (dMetaErr) throw dMetaErr;

      // D. Récupérer séparément les heures réelles du défié
      const { data: challengedLp, error: dLpErr } = await supabase
        .from('loyalty_points')
        .select('total_hours')
        .eq('user_id', challengedId)
        .maybeSingle()

      if (dLpErr) throw dLpErr;

      if (!challengerMeta || !challengedMeta) {
        throw new Error("Profils de joueurs introuvables.");
      }

      // E. Vérifier la conformité de l'équipe (Multi-teams 3 Max)
      // Charger les teams approuvées de chaque joueur
      const { data: challengerTeams } = await supabase
        .from('team_membership_requests')
        .select('team_id')
        .eq('user_id', user.id)
        .eq('status', 'approved');

      const { data: challengedTeams } = await supabase
        .from('team_membership_requests')
        .select('team_id')
        .eq('user_id', challengedId)
        .eq('status', 'approved');

      const challengerTeamList = challengerTeams?.map(t => t.team_id) || [];
      const challengedTeamList = challengedTeams?.map(t => t.team_id) || [];

      // RÈGLE 2 : Seul ceux qui sont dans une communauté validée peuvent défier
      if (challengerTeamList.length === 0) {
        throw new Error("Vous devez rejoindre au moins une Team validée pour lancer des défis.");
      }

      // RÈGLE 3 : Un joueur ne peut défier que celui qui partage au moins une Team en commun avec lui
      const sharedTeams = challengerTeamList.filter(t => challengedTeamList.includes(t));
      if (sharedTeams.length === 0) {
        throw new Error("Vous ne pouvez défier que des joueurs de votre propre Team.");
      }

      // RÈGLE 1 : Restriction de rangs
      const challengerHours = challengerLp?.total_hours || 0;
      const challengedHours = challengedLp?.total_hours || 0;

      const challengerRank = getRank(challengerHours);
      const challengedRank = getRank(challengedHours);

      const cIdx = RANKS.findIndex(r => r.name === challengerRank.name);
      const dIdx = RANKS.findIndex(r => r.name === challengedRank.name);

      const rankDiff = dIdx - cIdx;
      const hasTwoRanksRight = challengerMeta.has_two_ranks_challenge_right === true;
      const maxAllowedDiff = hasTwoRanksRight ? 2 : 1;

      if (rankDiff < 0) {
        // Le défié est de rang inférieur : autorisé
      } else if (rankDiff > maxAllowedDiff) {
        throw new Error(`Vous ne pouvez défier qu'un joueur de même rang ou du rang supérieur suivant (${hasTwoRanksRight ? '2' : '1'} max).`);
      }

      // RÈGLE 4 : Prorata asymétrique (50% de mise si le défié est de rang supérieur)
      const isChallengedHigher = dIdx > cIdx;
      const challengedWager = isChallengedHigher ? amount * 0.5 : amount;

      // F. Insérer la demande de défi (Inclusion de l'arène de la Team)
        const { error: insertErr } = await supabase
          .from('ragnarok_challenges')
          .insert([{
            challenger_id: user.id,
            challenged_id: challengedId,
            currency_type: currencyType,
            amount,
            challenged_wager: challengedWager,
            scheduled_at: scheduledAt,
            status: 'pending',
            team_id: teamId // AJOUTÉ
          }])

      if (insertErr) throw insertErr
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['ragnarok_challenges', user?.id] })
    }
  })

  // 3. Répondre à un défi (Fight ou Fuir)
  const respondToChallenge = useMutation({
    mutationFn: async ({ challengeId, action }: { challengeId: string, action: 'Fight' | 'Fuir' }) => {
      if (!user) throw new Error("Vous devez être connecté.")

      const status = action === 'Fight' ? 'active' : 'cancelled';

      const { error } = await supabase
        .from('ragnarok_challenges')
        .update({ status })
        .eq('id', challengeId)

      if (error) throw error

      // Si refusé (Fuir), envoyer une notification d'alerte au challenger
      if (action === 'Fuir') {
        const { data: challenge } = await supabase
          .from('ragnarok_challenges')
          .select('challenger_id, challenged_id')
          .eq('id', challengeId)
          .single();

        const { data: refuser } = await supabase
          .from('users_metadata')
          .select('display_name')
          .eq('user_id', user.id)
          .single();

        if (challenge && refuser) {
          await supabase.from('notifications').insert([{
            user_id: challenge.challenger_id,
            message: `Le joueur @${refuser.display_name} a fui votre défi Ragnarok.`
          }]);
        }
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['ragnarok_challenges', user?.id] })
      queryClient.invalidateQueries({ queryKey: ['notifications', user?.id] })
      queryClient.invalidateQueries({ queryKey: ['news'] })
    }
  })

  return { myChallenges, createChallenge, respondToChallenge }
}

// AJOUTÉ : Mutation de résolution administrative d'un défi (Désignation du vainqueur)
export function useResolveChallenge() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async ({ challengeId, winnerId }: { challengeId: string, winnerId: string }) => {
      // Clôturer le duel et enregistrer le vainqueur
      const { error } = await supabase
        .from('ragnarok_challenges')
        .update({ 
          status: 'completed',
          winner_id: winnerId
        })
        .eq('id', challengeId);

      if (error) throw error
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['ragnarok_challenges'] })
      queryClient.invalidateQueries({ queryKey: ['all_active_challenges'] })
      queryClient.invalidateQueries({ queryKey: ['loyalty_points'] })
      queryClient.invalidateQueries({ queryKey: ['news'] })
    }
  })
}
</file>

<file path="src/hooks/useReservations.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from './useAuth'

export function useReservations() {
  const { user } = useAuth()
  const queryClient = useQueryClient()

  const { data: reservations, isLoading } = useQuery({
    queryKey: ['reservations', user?.id],
    queryFn: async () => {
      if (!user) return [];
      
      const { data: profile, error: profileError } = await supabase
        .from('users_metadata')
        .select('is_admin')
        .eq('user_id', user.id)
        .maybeSingle();

      if (profileError) {
        console.error("Erreur de profil dans useReservations :", profileError.message);
      }

      // Requête de base
      let query = supabase.from('reservations').select('*, loyalty_points(points, total_hours)');
      
      // Si l'utilisateur n'est PAS admin, il ne voit que les siennes
      if (!profile?.is_admin) {
        query = query.eq('user_id', user.id);
      }

      const { data, error } = await query.order('start_time', { ascending: false });
      if (error) {
        console.error("Erreur de chargement des réservations :", error.message);
        throw error;
      }

      // Appliquer la barrière temporelle de 48h sur les réservations closes pour le joueur
      if (profile && !profile.is_admin) {
        const now = new Date();
        const fortyEightHoursAgo = new Date(now.getTime() - 48 * 60 * 60 * 1000);

        return (data || []).filter((res: any) => {
          // Toujours afficher si la session est active, en attente ou interrompue
          if (res.status === 'en cours' || res.status === 'pending' || res.status === 'interrompu') {
            return true;
          }
          const startTime = new Date(res.start_time);
          return startTime >= fortyEightHoursAgo;
        });
      }

      return data || [];
    },
    enabled: !!user,
    refetchInterval: 10000
  });

  const updateStatus = useMutation({
    mutationFn: async ({ id, status, end_time, started_at }: { id: string, status: string, end_time?: string, started_at?: string }) => {
      const updateData: any = { status };
      if (end_time) updateData.end_time = end_time;
      if (started_at) updateData.started_at = started_at;
      const { error } = await supabase.from('reservations').update(updateData).eq('id', id);
      if (error) throw error;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['reservations'] });
      queryClient.invalidateQueries({ queryKey: ['loyalty_points'] });
      queryClient.invalidateQueries({ queryKey: ['admin_stats'] });
    }
  });

  const deleteReservation = useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.from('reservations').delete().eq('id', id);
      if (error) throw error; // MODIFIÉ (Intercepte et lève l'erreur)
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['reservations'] })
  });

  // MUTATION DE CRÉATION DE RÉSERVATION (CORRIGÉE)
  const createReservation = useMutation({
    mutationFn: async (newRes: { 
      station_id: string; 
      start_time: string; 
      end_time: string; 
      display_name: string; 
      status: string;
      user_id?: string;
      bonus_minutes_applied?: number; // <-- AJOUTÉ
    }) => {
      const finalUserId = newRes.user_id || user?.id;
      if (!finalUserId) throw new Error("Aucun ID utilisateur disponible pour la réservation.");

      const { error } = await supabase.from('reservations').insert([
        {
          station_id: newRes.station_id,
          start_time: newRes.start_time,
          end_time: newRes.end_time,
          display_name: newRes.display_name,
          status: newRes.status,
          user_id: finalUserId,
          bonus_minutes_applied: newRes.bonus_minutes_applied || 0 // <-- ENREGISTRE LE BONUS EN BASE
        }
      ]);
      if (error) throw error;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['reservations'] });
    }
  });

  // AJOUTÉ : Mutation de mise en pause d'une réservation individuelle
  const pauseReservation = useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.rpc('pause_reservation', { res_id: id });
      if (error) throw error;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['reservations'] });
    }
  });

  // AJOUTÉ : Mutation de reprise de pause d'une réservation individuelle
  const resumeReservation = useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.rpc('resume_reservation', { res_id: id });
      if (error) throw error;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['reservations'] });
    }
  });

  // MISE À JOUR DU RETOUR POUR INCLURE TOUTES LES MUTATIONS
  return { 
    reservations, 
    isLoading, 
    updateStatus, 
    deleteReservation, 
    createReservation, 
    pauseReservation, 
    resumeReservation // AJOUTÉS AU RETOUR
  };
}
</file>

<file path="src/hooks/useRewards.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { toast } from 'react-hot-toast'

export interface Reward {
  id: string
  name: string
  description: string
  mani_cost: number
  category: string
  image_url: string
  created_at: string
  action_type?: string // AJOUTÉ : Type d'action/effet
  action_value?: string | null // AJOUTÉ : Valeur numérique associée
}

export function useRewards() {
  const queryClient = useQueryClient()

  // 1. Lire les articles
  const rewards = useQuery({
    queryKey: ['rewards'],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('rewards')
        .select('*')
        .order('mani_cost', { ascending: true })
      if (error) throw error
      return data as Reward[]
    }
  })

  // 2. Ajouter un article
  const addReward = useMutation({
    mutationFn: async (newItem: Omit<Reward, 'id' | 'created_at'>) => {
      const { error } = await supabase.from('rewards').insert([newItem])
      if (error) throw error
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['rewards'] })
      toast.success("Article ajouté à la boutique !")
    }
  })

  // 3. Modifier un article
  const updateReward = useMutation({
    mutationFn: async (updatedItem: Reward) => {
      const { error } = await supabase
        .from('rewards')
        .update(updatedItem)
        .eq('id', updatedItem.id)
      if (error) throw error
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['rewards'] })
      toast.success("Article mis à jour !")
    }
  })

  // 4. Supprimer un article
  const deleteReward = useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.from('rewards').delete().eq('id', id)
      if (error) throw error
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['rewards'] })
      toast.success("Article supprimé")
    }
  })

  // 5. Acheter (Réclamer) une récompense (Avec détection automatique des droits immatériels)
  const claimReward = useMutation({
    mutationFn: async ({ rewardId, userId, displayName }: { rewardId: string, userId: string, displayName: string }) => {
      // A. Récupérer les détails de la récompense
      const { data: reward, error: fetchErr } = await supabase
        .from('rewards')
        .select('*')
        .eq('id', rewardId)
        .single();

      if (fetchErr) throw fetchErr;

      // B. Vérifier le solde de l'acheteur
      const { data: lp, error: lpErr } = await supabase
        .from('loyalty_points')
        .select('points')
        .eq('user_id', userId)
        .single();

      if (lpErr || !lp) throw new Error("Compte fidélité introuvable.");

      // C. Calculer le coût réel si le joueur bénéficie du droit de réduction globale de 10%
      const { data: meta } = await supabase
        .from('users_metadata')
        .select('discount_perk_until')
        .eq('user_id', userId)
        .maybeSingle();

      const hasGlobalDiscount = meta?.discount_perk_until && new Date(meta.discount_perk_until) > new Date();
      const realCost = hasGlobalDiscount ? Math.round(reward.mani_cost * 0.9) : reward.mani_cost;

      if (lp.points < realCost) {
        throw new Error(`MANI insuffisants. Prix requis : ${realCost} MANI.`);
      }

      // D. Déduire les MANI du solde du joueur
      const { error: deductErr } = await supabase
        .from('loyalty_points')
        .update({ points: lp.points - realCost })
        .eq('user_id', userId);

      if (deductErr) throw deductErr;

      // E. Traiter l'attribution automatique des droits virtuels achetés
      const now = new Date();
      const actionType = reward.action_type || 'none';
      const actionValueNum = reward.action_value ? parseInt(reward.action_value) : 0;

      if (actionType === 'challenge_two_ranks') {
        // Droit d'affronter un joueur de 2 rangs supérieurs
        await supabase.from('users_metadata').update({ has_two_ranks_challenge_right: true }).eq('user_id', userId);
      } 
      else if (actionType === 'global_discount_10') {
        // 10% de réduction sur tout pendant 1 semaine
        const oneWeekFromNow = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
        await supabase.from('users_metadata').update({ discount_perk_until: oneWeekFromNow.toISOString() }).eq('user_id', userId);
      } 
      else if (actionType === 'pack_4h') {
        // Acheter un pack 4h (Ajoute 240 minutes de crédit temps)
        const { data: currentLp } = await supabase.from('loyalty_points').select('time_credit_minutes').eq('user_id', userId).single();
        await supabase.from('loyalty_points').update({ time_credit_minutes: (currentLp?.time_credit_minutes || 0) + 240 }).eq('user_id', userId);
      } 
      else if (actionType === 'buy_mani') {
        // Acheter des MANI (ex: recharge de 10 MANI ou 5 MANI)
        const amountOfMani = actionValueNum || 10;
        // On crédite les MANI sur le solde déduit
        await supabase.from('loyalty_points').update({ points: lp.points - realCost + amountOfMani }).eq('user_id', userId);
      } 
      else if (actionType === 'buy_minutes') {
        // Acheter des minutes (ex: recharge de 60 minutes)
        const amountOfMins = actionValueNum || 60;
        const { data: currentLp } = await supabase.from('loyalty_points').select('time_credit_minutes').eq('user_id', userId).single();
        await supabase.from('loyalty_points').update({ time_credit_minutes: (currentLp?.time_credit_minutes || 0) + amountOfMins }).eq('user_id', userId);
      } 
      else if (actionType === 'weekend_priority') {
        // Droit de priorité de réservation pendant 1 week-end (Valide 1 semaine pour couvrir le week-end)
        const oneWeekFromNow = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
        await supabase.from('users_metadata').update({ weekend_priority_until: oneWeekFromNow.toISOString() }).eq('user_id', userId);
      } 
      else if (actionType === 'community_discount') {
        // Réduction sur frais de communauté (50%, 25%, 10%)
        const percent = actionValueNum || 10;
        const oneMonthFromNow = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
        await supabase.from('users_metadata').update({ community_discount_percent: percent, community_discount_until: oneMonthFromNow.toISOString() }).eq('user_id', userId);
      } 
      else if (actionType === 'tournament_discount') {
        // Réduction sur inscription de tournoi (50%, 25%, 10%)
        const percent = actionValueNum || 10;
        const oneMonthFromNow = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
        await supabase.from('users_metadata').update({ tournament_discount_percent: percent, tournament_discount_until: oneMonthFromNow.toISOString() }).eq('user_id', userId);
      }

      // F. Enregistrer la transaction : 'en attente' pour les objets physiques (none), 'livré' pour les effets virtuels/droits
      const finalStatus = actionType === 'none' ? 'en attente' : 'livré';

      const { error } = await supabase.from('reward_claims').insert([
        { reward_id: rewardId, user_id: userId, display_name: displayName, status: finalStatus }
      ])
      if (error) throw error
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['loyalty_points'] })
      queryClient.invalidateQueries({ queryKey: ['user_metadata'] })
      queryClient.invalidateQueries({ queryKey: ['reward_claims'] })
      toast.success("Achat d'un article : validé ! Privilège activé.", {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid hsl(180, 100%, 50%)', // Bordure Néon Cyan
          borderRadius: '1rem',
          boxShadow: '0 0 15px hsl(180, 100%, 50%, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      });
    },
    onError: (error: any) => {
      toast.error(error.message || "Échec de l'achat")
    }
  })

  return { rewards, addReward, updateReward, deleteReward, claimReward }
}
</file>

<file path="src/hooks/useTeamSessions.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from './useAuth'

// Interface de typage des membres d'une équipe
export interface TeamMember {
  team_session_id: string
  user_id: string
  contribution_amount: number
  allocated_minutes: number
  status: 'pending' | 'validated' | 'refused'
  users_metadata?: {
    display_name: string
    avatar_url: string
  }
}

// Interface de typage de la session d'équipe
export interface TeamSession {
  id: string
  creator_id: string
  station_id: string
  start_time: string
  end_time: string
  pack_name: string
  total_price: number
  total_minutes: number
  status: 'pending_consensus' | 'pending' | 'en cours' | 'consommé' | 'cancelled'
  created_at: string
  team_session_members?: TeamMember[]
}

export function useTeamSessions() {
  const { user } = useAuth()
  const queryClient = useQueryClient()

  // 1. Créer une nouvelle session d'équipe (Leader)
  const createTeamSession = useMutation({
    mutationFn: async ({ stationId, startTime, endTime, packName, totalPrice, totalMinutes, members }: {
      stationId: string,
      startTime: string,
      endTime: string,
      packName: string,
      totalPrice: number,
      totalMinutes: number,
      members: { user_id: string, contribution_amount: number, allocated_minutes: number }[]
    }) => {
      if (!user) throw new Error("Vous devez être connecté.")

      // A. Insérer la session générale
      const { data: session, error: sessionErr } = await supabase
        .from('team_sessions')
        .insert([{
          creator_id: user.id,
          station_id: stationId,
          start_time: startTime,
          end_time: endTime,
          pack_name: packName,
          total_price: totalPrice,
          total_minutes: totalMinutes,
          status: 'pending_consensus'
        }])
        .select()
        .single()

      if (sessionErr) throw sessionErr

      // B. Préparer les données des membres d'équipe (le créateur est validé d'office)
      const membersToInsert = [
        {
          team_session_id: session.id,
          user_id: user.id,
          contribution_amount: members.find(m => m.user_id === user.id)?.contribution_amount || 0,
          allocated_minutes: members.find(m => m.user_id === user.id)?.allocated_minutes || 0,
          status: 'validated' as const
        },
        ...members.filter(m => m.user_id !== user.id).map(m => ({
          team_session_id: session.id,
          user_id: m.user_id,
          contribution_amount: m.contribution_amount,
          allocated_minutes: m.allocated_minutes,
          status: 'pending' as const
        }))
      ]

      // C. Insérer les membres
      const { error: membersErr } = await supabase
        .from('team_session_members')
        .insert(membersToInsert)

      if (membersErr) throw membersErr
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['notifications', user?.id] })
    }
  })

  // 2. Valider ou Refuser une invitation à rejoindre une équipe
  const respondToInvitation = useMutation({
    mutationFn: async ({ teamSessionId, status }: { teamSessionId: string, status: 'validated' | 'refused' }) => {
      if (!user) throw new Error("Vous devez être connecté.")

      // Mettre à jour l'état de vote du membre
      const { error } = await supabase
        .from('team_session_members')
        .update({ status })
        .eq('team_session_id', teamSessionId)
        .eq('user_id', user.id)

      if (error) throw error

      // Supprimer la notification d'invitation d'origine après action
      await supabase
        .from('notifications')
        .delete()
        .eq('team_session_id', teamSessionId)
        .eq('user_id', user.id)
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['notifications', user?.id] })
    }
  })

  return { createTeamSession, respondToInvitation }
}

// AJOUTÉ : Mutation pour mettre en PAUSE une session d'équipe (Admin)
export function usePauseTeamSession() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.rpc('pause_team_session', { team_session_id_param: id });
      if (error) throw error;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['all_team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['active_team_session'] })
    }
  })
}

// AJOUTÉ : Mutation pour RELANCER (Play) une session d'équipe en pause (Admin)
export function useResumeTeamSession() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.rpc('resume_team_session', { team_session_id_param: id });
      if (error) throw error;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['all_team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['active_team_session'] })
    }
  })
}

// AJOUTÉ : Mutation de suppression d'une session d'équipe (Admin - Avec nettoyage des clés étrangères)
export function useDeleteTeamSession() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async (id: string) => {
      // A. Supprimer d'abord les membres liés pour éviter la violation de clé étrangère
      const { error: membersErr } = await supabase
        .from('team_session_members')
        .delete()
        .eq('team_session_id', id)

      if (membersErr) throw membersErr

      // B. Supprimer ensuite la session d'équipe parente
      const { error } = await supabase
        .from('team_sessions')
        .delete()
        .eq('id', id)

      if (error) throw error
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['all_team_sessions'] })
    }
  })
}

// AJOUTÉ : Mutation d'action de l'administrateur (Démarrer / Clôturer les cagnottes)
export function useUpdateTeamSessionStatus() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async ({ id, status, start_time, end_time }: { id: string, status: string, start_time?: string, end_time?: string }) => {
      const updateData: any = { status }
      if (start_time) updateData.start_time = start_time
      if (end_time) updateData.end_time = end_time

      const { error } = await supabase
        .from('team_sessions')
        .update(updateData)
        .eq('id', id)

      if (error) throw error
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['all_team_sessions'] })
      queryClient.invalidateQueries({ queryKey: ['active_team_session'] })
      queryClient.invalidateQueries({ queryKey: ['loyalty_points'] })
    }
  })
}

// 3. Charger la session d'équipe active ('en cours') pour le chronomètre partagé en direct
export function useActiveTeamSession() {
  const { user } = useAuth()

  return useQuery({
    queryKey: ['active_team_session', user?.id],
    queryFn: async () => {
      if (!user) return null

      // Chercher si l'utilisateur est membre d'une session
      const { data: memberships } = await supabase
        .from('team_session_members')
        .select('team_session_id')
        .eq('user_id', user.id)

      if (!memberships || memberships.length === 0) return null
      const sessionIds = memberships.map(m => m.team_session_id)

      // Récupérer la session d'équipe active correspondante
      const { data, error } = await supabase
        .from('team_sessions')
        .select(`
          *,
          team_session_members (
            *,
            users_metadata ( display_name )
          )
        `)
        .in('id', sessionIds)
        .eq('status', 'en cours')
        .maybeSingle()

      if (error) throw error
      return data as TeamSession | null
    },
    enabled: !!user,
    refetchInterval: 10000 // Actualisation dynamique toutes les 10 secondes
  })
}
</file>

<file path="src/hooks/useTournaments.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'

export interface Tournament {
  id: string
  title: string
  game: string
  date: string
  description: string
  status: string
  image_url: string
  is_paid?: boolean       // AJOUTÉ (Déclaré pour la base de données)
  fee_amount?: number     // AJOUTÉ (Déclaré pour la base de données)
  payment_phone?: string   // AJOUTÉ (Déclaré pour la base de données)
}

export function useTournaments() {
  const queryClient = useQueryClient();

  const query = useQuery({
    queryKey: ['tournaments'],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('tournaments')
        .select('*')
        .order('date', { ascending: true })

      if (error) throw error
      return data as Tournament[]
    }
  })

  const addTournament = useMutation({
    mutationFn: async (newTourney: Omit<Tournament, 'id'>) => {
      const { error } = await supabase.from('tournaments').insert([newTourney]);
      if (error) throw error;
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['tournaments'] })
  });

  const updateTournament = useMutation({
    mutationFn: async (updatedTourney: Tournament) => {
      const { error } = await supabase
        .from('tournaments')
        .update(updatedTourney)
        .eq('id', updatedTourney.id);
      if (error) throw error;
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['tournaments'] })
  });

  const deleteTournament = useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.from('tournaments').delete().eq('id', id);
      if (error) throw error;
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['tournaments'] })
  });

  return { 
    tournaments: query.data ?? [],
    isLoading: query.isLoading,
    isError: query.isError,
    addTournament, 
    updateTournament, 
    deleteTournament 
  };
}
</file>

