@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root, html {
    --background: #050608;
    --foreground: #f8fafc;
    --primary: #06b6d4;
    --primary-rgb: 6, 182, 212;
    --secondary: #a855f7;
    --secondary-rgb: 168, 85, 247;
    --accent: #f97316;
    --accent-rgb: 249, 115, 22;
    --muted: #1e293b;
    --muted-foreground: #94a3b8;
    --glow-color: rgba(6, 182, 212, 0.45);

    /* ── Typographies (voir index.html) ─────────────────────────────────── */
    --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-display: 'Rajdhani', 'Inter', system-ui, sans-serif;
    --font-heading: 'Rajdhani', 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;

    /* ── Rayons : courbes douces et cohérentes (fini le "carré") ────────── */
    --radius-sm: 0.5rem;
    --radius-md: 0.75rem;
    --radius-lg: 1rem;
    --radius-xl: 1.25rem;
    --radius-full: 9999px;

    /* ── Tailles de texte fluides ───────────────────────────────────────── */
    --font-size-xs: 0.75rem;
    --font-size-sm: 0.8125rem;
    --font-size-base: 0.9375rem;
    --font-size-lg: 1.0625rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --line-height-tight: 1.2;
    --line-height-normal: 1.55;
    --line-height-relaxed: 1.7;
    --line-height-heading: 1.18;

    /* ── Ombres & profondeur ────────────────────────────────────────────── */
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.45);
    --shadow-md: 0 6px 18px -4px rgba(0, 0, 0, 0.55);
    --shadow-lg: 0 16px 40px -12px rgba(0, 0, 0, 0.7);
    --shadow-xl: 0 28px 60px -18px rgba(0, 0, 0, 0.8);
    --shadow-card: 0 10px 32px -10px rgba(0, 0, 0, 0.6), inset 0 1px 0 0 rgba(255, 255, 255, 0.05);

    /* ── Transitions ────────────────────────────────────────────────────── */
    --duration-fast: 150ms;
    --duration-normal: 260ms;
    --duration-slow: 420ms;
    --easing-default: cubic-bezier(0.4, 0, 0.2, 1);
    --easing-smooth: cubic-bezier(0.16, 1, 0.3, 1);
    --easing-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :root[data-theme="evazion"], html[data-theme="evazion"] {
    --primary: #06b6d4;
    --primary-rgb: 6, 182, 212;
    --secondary: #a855f7;
    --secondary-rgb: 168, 85, 247;
    --accent: #f97316;
    --accent-rgb: 249, 115, 22;
    --glow-color: rgba(6, 182, 212, 0.45);
  }

  :root[data-theme="sanctuary"], html[data-theme="sanctuary"] {
    --primary: #c084fc;
    --primary-rgb: 192, 132, 252;
    --secondary: #ec4899;
    --secondary-rgb: 236, 72, 153;
    --accent: #38bdf8;
    --accent-rgb: 56, 189, 248;
    --glow-color: rgba(192, 132, 252, 0.45);
  }

  :root[data-theme="ragnarok"], html[data-theme="ragnarok"] {
    --primary: #eab308;
    --primary-rgb: 234, 179, 8;
    --secondary: #ef4444;
    --secondary-rgb: 239, 68, 68;
    --accent: #f97316;
    --accent-rgb: 249, 115, 22;
    --glow-color: rgba(234, 179, 8, 0.45);
  }

  :root[data-theme="neon"], html[data-theme="neon"] {
    --primary: #22c55e;
    --primary-rgb: 34, 197, 94;
    --secondary: #06b6d4;
    --secondary-rgb: 6, 182, 212;
    --accent: #a855f7;
    --accent-rgb: 168, 85, 247;
    --glow-color: rgba(34, 197, 94, 0.45);
  }
}

body {
  background-color: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans);
  font-size: var(--font-size-base);
  line-height: var(--line-height-normal);
  letter-spacing: -0.01em;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

/* Titres : police d'affichage + resserrage pour un rendu premium */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  line-height: var(--line-height-heading);
  letter-spacing: 0.005em;
}

/* Chiffres alignés partout où l'on affiche des stats */
.tabular-nums,
.font-mono {
  font-variant-numeric: tabular-nums;
}

.glass {
  background: rgba(10, 11, 15, 0.7);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.glass-card {
  background: rgba(18, 20, 28, 0.6);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.07);
}

.text-glow-violet {
  text-shadow: 0 0 20px rgba(168, 85, 247, 0.6);
}

.text-glow-cyan {
  text-shadow: 0 0 20px rgba(6, 182, 212, 0.6);
}

.text-glow-orange {
  text-shadow: 0 0 20px rgba(249, 115, 22, 0.6);
}

.shadow-neon-violet {
  box-shadow: 0 0 25px -5px rgba(168, 85, 247, 0.4);
}

.shadow-neon-cyan {
  box-shadow: 0 0 25px -5px rgba(6, 182, 212, 0.4);
}

.shadow-neon-orange {
  box-shadow: 0 0 25px -5px rgba(249, 115, 22, 0.4);
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-8px); }
}

.animate-float {
  animation: float 4s ease-in-out infinite;
}

/* ── Réduction de la taille de toutes les box sur version mobile ── */
@media (max-width: 768px) {
  .glass:not(.p-0),
  .glass-card:not(.p-0),
  .cyber-card:not(.p-0) {
    padding: 1.125rem !important;
    border-radius: 1.25rem !important;
  }
  
  /* Réduction des marges et espacements internes des grands conteneurs sur mobile */
  section.glass,
  div.glass,
  div.glass-card {
    margin-bottom: 1rem !important;
  }
}

/* ── Réduction de la taille de toutes les box / cartes pour la version mobile uniquement ── */
@media (max-width: 768px) {
  .glass, 
  .glass-card {
    padding: 1rem !important;
    border-radius: 1.25rem !important;
  }

  .p-5 { padding: 0.875rem !important; }
  .p-6 { padding: 1rem !important; }
  .p-8 { padding: 1.25rem !important; }
  .p-10 { padding: 1.5rem !important; }
  .p-12 { padding: 1.75rem !important; }
}
