              "px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all flex items-center gap-2 cursor-pointer select-none",
              activeTab === 'achievements'
                ? "bg-purple-500 text-white shadow-neon-violet"
