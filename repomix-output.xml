function readLocal<T>(key: string, fallback: T): T {
  try {
    const raw = localStorage.getItem(key);
    return raw ? (JSON.parse(raw) as T) : fallback;
  } catch {
    return fallback;
  }
}

function writeLocal(key: string, value: unknown) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
  } catch {
    /* quota / mode prive : on ignore, Supabase reste la source de verite */
  }
}

const LOCAL_KEYS = {
  clan_wars: 'sanctuary_clan_wars',
  social_posts: 'sanctuary_social_posts',
  lfg_posts: 'sanctuary_lfg_posts',
  community_events: 'sanctuary_community_events',
  achievements: 'sanctuary_achievements',
  monthly_hours_target: 'sanctuary_monthly_hours_target'
} as const;

type CommunityKey = keyof typeof LOCAL_KEYS;

// --- Etat memoire -----------------------------------------------------------
const cache = {
  clan_wars: readLocal<ClanWarScore[]>(LOCAL_KEYS.clan_wars, DEFAULT_CLAN_WARS),
  social_posts: readLocal<SocialPost[]>(LOCAL_KEYS.social_posts, DEFAULT_SOCIAL_POSTS),
  lfg_posts: readLocal<LfgPost[]>(LOCAL_KEYS.lfg_posts, DEFAULT_LFG_POSTS),
  community_events: readLocal<CommunityEvent[]>(LOCAL_KEYS.community_events, DEFAULT_COMMUNITY_EVENTS),
  achievements: readLocal<Achievement[]>(LOCAL_KEYS.achievements, DEFAULT_ACHIEVEMENTS),
  monthly_hours_target: readLocal<typeof DEFAULT_MONTHLY_HOURS_TARGET>(
    LOCAL_KEYS.monthly_hours_target,
    DEFAULT_MONTHLY_HOURS_TARGET
  )
};

let version = 0;
let currentUserId: string | null = null;
let hydratedFor: string | null = null;
const listeners = new Set<() => void>();

function notify() {
  version += 1;
  listeners.forEach((l) => l());
}

export function subscribeCommunity(listener: () => void) {
  listeners.add(listener);
  return () => listeners.delete(listener);
}

export function getCommunityVersion() {
  return version;
}

// --- Persistance Supabase ---------------------------------------------------
function persistCommunity(key: CommunityKey, value: unknown) {
  supabase
    .from('community_config')
    .upsert({ key, value }, { onConflict: 'key' })
    .then(({ error }) => {
      if (error) console.error(`[community] echec upsert "${key}" :`, error.message);
    });
}

function commit<K extends CommunityKey>(key: K, value: (typeof cache)[K]) {
  cache[key] = value;
  writeLocal(LOCAL_KEYS[key], value);
  notify();
  persistCommunity(key, value);
}

export function setCurrentUser(userId: string | null) {
  currentUserId = userId;
}

export async function hydrateCommunity(userId: string | null) {
  if (hydratedFor === userId) return;
  hydratedFor = userId;
  currentUserId = userId;

  try {
    const { data: rows } = await supabase.from('community_config').select('key, value');
    (rows || []).forEach((row: { key: string; value: unknown }) => {
      switch (row.key) {
        case 'clan_wars':
          cache.clan_wars = row.value as ClanWarScore[];
          break;
        case 'social_posts':
          cache.social_posts = row.value as SocialPost[];
          break;
        case 'lfg_posts':
          cache.lfg_posts = row.value as LfgPost[];
          break;
        case 'community_events':
          cache.community_events = row.value as CommunityEvent[];
          break;
        case 'achievements':
          cache.achievements = row.value as Achievement[];
          break;
        case 'monthly_hours_target':
          cache.monthly_hours_target = { ...DEFAULT_MONTHLY_HOURS_TARGET, ...(row.value as object) };
          break;
      }
    });
    notify();
  } catch (e) {
    console.error('[community] hydratation impossible :', e);
  }
}

/** Hook React : s'abonne au store et declenche l'hydratation Supabase. */
export function useCommunityStore() {
  const { user } = useAuth();
  const userId = user?.id ?? null;

  useSyncExternalStore(subscribeCommunity, getCommunityVersion, getCommunityVersion);

  useEffect(() => {
    hydrateCommunity(userId);
  }, [userId]);

  return communityDataStore;
}

// --- Store ------------------------------------------------------------------
export const communityDataStore = {
  getClanWars(): ClanWarScore[] {
    return cache.clan_wars;
  },

  getSocialPosts(): SocialPost[] {
    return cache.social_posts;
  },

  addSocialPost(post: Omit<SocialPost, 'id' | 'created_at' | 'likes'>): SocialPost {
    const newPost: SocialPost = {
      ...post,
      id: `post_${Date.now()}`,
      created_at: new Date().toISOString(),
      likes: { fire: 0, goat: 0, bolt: 0, clutch: 0 }
    };
    commit('social_posts', [newPost, ...cache.social_posts]);
    return newPost;
  },

  reactToPost(postId: string, reaction: 'fire' | 'goat' | 'bolt' | 'clutch', userId: string) {
    const posts = cache.social_posts.map((p) => {
      if (p.id !== postId) return p;
      const likes = { ...(p.likes || { fire: 0, goat: 0, bolt: 0, clutch: 0 }) };
      const userReactions = { ...(p.user_reactions || {}) };
      const prevReaction = userReactions[userId];

      if (prevReaction === reaction) {
        likes[reaction] = Math.max(0, likes[reaction] - 1);
        delete userReactions[userId];
      } else {
        if (prevReaction && likes[prevReaction as keyof typeof likes] > 0) {
          likes[prevReaction as keyof typeof likes]--;
        }
        likes[reaction]++;
        userReactions[userId] = reaction;
      }
      return { ...p, likes, user_reactions: userReactions };
    });
    commit('social_posts', posts);
  },

  getLfgPosts(): LfgPost[] {
    return cache.lfg_posts;
  },

  addLfgPost(post: Omit<LfgPost, 'id' | 'created_at' | 'is_active'>): LfgPost {
    const newPost: LfgPost = {
      ...post,
      id: `lfg_${Date.now()}`,
      created_at: new Date().toISOString(),
      is_active: true
    };
    commit('lfg_posts', [newPost, ...cache.lfg_posts]);
    return newPost;
  },

  deleteLfgPost(id: string) {
    commit('lfg_posts', cache.lfg_posts.filter((p) => p.id !== id));
  },

  getCommunityEvents(): CommunityEvent[] {
    return cache.community_events;
  },

  toggleEventAttendance(eventId: string) {
    const events = cache.community_events.map((e) => {
      if (e.id !== eventId) return e;
      const registered = !e.user_is_registered;
      return {
        ...e,
        user_is_registered: registered,
        participants_count: e.participants_count + (registered ? 1 : -1)
      };
    });
    commit('community_events', events);
  },

  getAchievements(): Achievement[] {
    return cache.achievements;
  },

  deleteSocialPost(postId: string) {
    commit('social_posts', cache.social_posts.filter((p) => p.id !== postId));
  },

  saveClanWars(scores: ClanWarScore[]) {
    commit('clan_wars', scores);
  },

  updateClanWar(teamId: string, points: number, duelsWon: number, hoursLogged: number) {
    const scores = cache.clan_wars.map((s) =>
      s.team_id === teamId ? { ...s, points, duels_won: duelsWon, hours_logged: hoursLogged } : s
    );
    commit('clan_wars', scores);
  },

  resetClanWars() {
    commit('clan_wars', DEFAULT_CLAN_WARS);
  },

  saveCommunityEvents(events: CommunityEvent[]) {
    commit('community_events', events);
  },

  addCommunityEvent(
    event: Omit<CommunityEvent, 'id' | 'participants_count' | 'user_is_registered'>
  ): CommunityEvent {
    const newEvt: CommunityEvent = {
      ...event,
      id: `evt_${Date.now()}`,
      participants_count: 0,
      user_is_registered: false
    };
    commit('community_events', [...cache.community_events, newEvt]);
    return newEvt;
  },

  deleteCommunityEvent(id: string) {
    commit('community_events', cache.community_events.filter((e) => e.id !== id));
  },

  updateCommunityEvent(event: CommunityEvent) {
    commit('community_events', cache.community_events.map((e) => (e.id === event.id ? event : e)));
  },

  saveAchievements(achievements: Achievement[]) {
    commit('achievements', achievements);
  },

  addAchievement(ach: Omit<Achievement, 'id'>): Achievement {
    const newAch: Achievement = { ...ach, id: `ach_${Date.now()}` };
    commit('achievements', [...cache.achievements, newAch]);
    return newAch;
  },

  deleteAchievement(id: string) {
    commit('achievements', cache.achievements.filter((a) => a.id !== id));
  },

  updateMonthlyHoursTarget(current: number, target: number, rewardText: string) {
    commit('monthly_hours_target', { current, target, daysLeft: 12, rewardText });
  },

  getMonthlyHoursTarget() {
    return cache.monthly_hours_target;
  }
};
