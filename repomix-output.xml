              <div>
                <label className="block text-xs font-mono uppercase text-white/70 mb-1">Format du match</label>
                <input
                  type="text"
                  value={form.format}
                  onChange={(e) => setForm({ ...form, format: e.target.value })}
                  placeholder="Ex: First to 5, Match 10 min, Pas de prolongation"
