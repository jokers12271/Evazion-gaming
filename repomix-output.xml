import React from 'react';
import { Swords, Shield, Trophy, Flame, Zap } from 'lucide-react';
import { CyberCard } from '@/components/ui/CyberCard';
import { NeonButton } from '@/components/ui/NeonButton';
import { useCommunityStore, ClanWarScore } from '@/lib/communityData';
import { toast } from 'react-hot-toast';
import { cyberAudio } from '@/lib/cyberAudio';

export function ClanWarCard({ teams }: { teams: any[] }) {
  const communityDataStore = useCommunityStore();
  const scores: ClanWarScore[] = communityDataStore.getClanWars();

  const sortedScores = [...scores].sort((a, b) => b.points - a.points);
  const leadingTeamId = sortedScores[0]?.team_id;
  const leadingTeam = teams.find(t => t.id === leadingTeamId);

  const handleCheer = (teamId: string) => {
    cyberAudio.playSuccess();
    const next = scores.map(s => s.team_id === teamId ? { ...s, points: s.points + 5 } : s);
    communityDataStore.saveClanWars(next);
    toast.success("Cri de ralliement envoyé ! +5 Points pour votre Team ⚡", { position: 'bottom-center' });
  };

  return (
    <CyberCard
      variant="violet"
      hoverEffect={false}
      className="p-6 md:p-8 relative overflow-hidden text-left mb-10"
    >
      <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-white/10">
        <div>
          <div className="flex items-center gap-2 mb-2">
            <span className="px-2.5 py-1 rounded-full bg-red-500/20 text-red-400 border border-red-500/40 text-[9px] font-mono font-black uppercase tracking-widest flex items-center gap-1.5 animate-pulse">
              <Swords size={12} /> Guerre des Clans Hebdomadaire
            </span>
            <span className="text-[10px] font-mono text-white/40 uppercase">
              Fin dans 3 jours
            </span>
          </div>
          <h3 className="text-2xl md:text-3xl font-black uppercase text-white font-display">
            CLASH DES ARMOIRIES : SEMAINE #40
          </h3>
          <p className="text-xs text-white/60 font-sans mt-1 max-w-xl">
            Chaque heure passée sur les PS5 Pro du Sanctuary et chaque victoire 1v1 d'un membre rapporte des points de clan.
            La Team en tête décroche le <span className="text-amber-400 font-bold">Bouclier d'Or</span> et <span className="text-secondary font-bold">-15% au Lounge Bar</span> pour tous ses membres.
          </p>
        </div>

        {leadingTeam && (
          <div className="px-5 py-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center gap-4 shrink-0 shadow-neon-orange">
            <div className="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/40">
              <Trophy size={26} />
            </div>
            <div>
              <div className="text-[9px] font-mono uppercase tracking-widest text-amber-400 font-black">
                Clan Leader Actuel
              </div>
              <div className="text-lg font-black uppercase text-white font-display">
                {leadingTeam.name}
              </div>
              <div className="text-[10px] font-mono text-white/50">
                {sortedScores[0]?.points} Pts de Puissance
              </div>
            </div>
          </div>
        )}
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 pt-6">
        {sortedScores.map((score, index) => {
          const team = teams.find(t => t.id === score.team_id);
          if (!team) return null;
          const isLeader = index === 0;

          return (
            <div
              key={score.team_id}
              className={`p-4 rounded-xl border transition-all ${
                isLeader 
                  ? 'bg-amber-500/5 border-amber-500/40 shadow-lg' 
                  : 'bg-white/[0.02] border-white/10 hover:border-white/20'
              }`}
            >
              <div className="flex items-center justify-between mb-3">
                <div className="flex items-center gap-2.5">
                  <span
                    className="w-3.5 h-3.5 rounded-full"
                    style={{ backgroundColor: team.color }}
                  />
                  <span className="font-display font-black text-sm uppercase text-white">
                    {team.name}
                  </span>
                </div>
                <span className="text-xs font-mono font-black text-amber-400">
                  #{index + 1}
                </span>
              </div>

              <div className="grid grid-cols-2 gap-2 text-center py-2 mb-3 bg-black/40 rounded-lg border border-white/5">
                <div>
                  <div className="text-[9px] font-mono uppercase text-white/40">Duels Gagnés</div>
                  <div className="text-sm font-black text-white">{score.duels_won} ⚔️</div>
                </div>
                <div>
                  <div className="text-[9px] font-mono uppercase text-white/40">Heures Hub</div>
                  <div className="text-sm font-black text-secondary">{score.hours_logged}h ⏳</div>
                </div>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-xs font-mono font-black text-white">
                  {score.points} <span className="text-[9px] text-white/50 font-normal">PTS</span>
                </span>
                <button
                  type="button"
                  onClick={() => handleCheer(score.team_id)}
                  className="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-[9px] font-mono uppercase font-black text-white/80 hover:text-white flex items-center gap-1 cursor-pointer transition-all active:scale-95"
                >
                  <Zap size={11} className="text-amber-400" /> Encourager (+5)
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </CyberCard>
  );
}
</file>

<file path="src/components/community/CommunityQuestsEvents.tsx">
import React from 'react';
import { Target, Calendar, Clock, Trophy, Users, Check, Sparkles, Flame, CheckCircle2 } from 'lucide-react';
import { CyberCard } from '@/components/ui/CyberCard';
import { NeonButton } from '@/components/ui/NeonButton';
import { useCommunityStore, CommunityEvent } from '@/lib/communityData';
import { useAuth } from '@/hooks/useAuth';
import { toast } from 'react-hot-toast';
import { cyberAudio } from '@/lib/cyberAudio';

export function CommunityQuestsEvents() {
  const { user } = useAuth();
  const communityDataStore = useCommunityStore();
  const events: CommunityEvent[] = communityDataStore.getCommunityEvents();
  const hoursTarget = communityDataStore.getMonthlyHoursTarget();

  const percentage = Math.min(100, Math.round((hoursTarget.current / hoursTarget.target) * 100));

  const handleToggleAttendance = (eventId: string) => {
    if (!user) {
      toast.error("Connectez-vous pour confirmer votre présence !");
      return;
    }
    cyberAudio.playSuccess();
    communityDataStore.toggleEventAttendance(eventId);
    toast.success("Statut d'inscription mis à jour pour la soirée ! 🎉", { position: 'bottom-center' });
  };

  return (
    <div className="space-y-10 text-left font-display">
      {/* 1. Jauge Collective de la Salle (World Boss Goal) */}
      <CyberCard variant="violet" hoverEffect={false} className="p-6 md:p-8 relative overflow-hidden">
        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-6 pb-6 border-b border-white/10">
          <div>
            <div className="flex items-center gap-2 mb-2">
              <span className="px-2.5 py-1 rounded-full bg-primary/20 text-primary border border-primary/40 text-[9px] font-mono font-black uppercase tracking-widest flex items-center gap-1.5 animate-pulse">
                <Target size={12} /> Objectif Communautaire d'Octobre
              </span>
              <span className="text-[10px] font-mono text-white/40 uppercase">
                {hoursTarget.daysLeft} Jours Restants
              </span>
            </div>
            <h3 className="text-2xl md:text-3xl font-black uppercase text-white tracking-tight">
              LE GRAND PALIER DES 1 000 HEURES DU SANCTUARY
            </h3>
