export function getRank(hours: number): Rank {
  return RANKS.find((r) => hours >= r.min && (r.max === 0 || hours <= r.max)) || RANKS[0]
}

export function getNextRank(hours: number): Rank | null {
  const currentIndex = RANKS.findIndex((r) => hours >= r.min && (r.max === 0 || hours <= r.max))
  if (currentIndex === -1 || currentIndex === RANKS.length - 1) return null
  return RANKS[currentIndex + 1]
}

/** Progression detaillee vers le prochain rang (barre, heures restantes). */
export function getRankProgress(hours: number) {
  const current = getRank(hours)
  const next = getNextRank(hours)
  const safeHours = Math.max(0, hours || 0)

  if (!next) {
    return { current, next: null, progress: 100, hoursRemaining: 0 }
  }

  const span = Math.max(0.0001, next.min - current.min)
  const progress = Math.max(0, Math.min(100, Math.round(((safeHours - current.min) / span) * 100)))
  const hoursRemaining = Math.max(0, Math.ceil((next.min - safeHours) * 10) / 10)

  return { current, next, progress, hoursRemaining }
}
