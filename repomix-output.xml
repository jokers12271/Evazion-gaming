                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full text-left border-collapse">
                    <thead>
                      <tr className="border-b border-white/5 text-[9px] font-black uppercase tracking-widest text-white/40">
                        <th className="py-4 px-6">#</th>
                        <th className="py-4 px-6">Gamer</th>
                        <th className="py-4 px-6">Rang Actuel</th>
                        <th className="py-4 px-6">Temps Joué</th>
                        <th className="py-4 px-6 text-right">Mani Collecté</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-white/5 text-xs font-mono">
                      {leaders?.slice(0, 10).map((leader: any, idx: number) => {
                        const rank = getRank(leader.total_hours || 0);
                        return (
                          <tr key={leader.user_id || idx} className="hover:bg-white/[0.02] transition-colors">
                            <td className="py-4 px-6 font-black text-secondary">
                              #{idx + 1}
                            </td>
                            <td className="py-4 px-6 font-bold text-white font-display uppercase">
                              {leader.display_name || 'Gamer'}
                            </td>
                            <td className="py-4 px-6">
                              <span className="px-2 py-0.5 rounded text-[9px] font-black uppercase border border-white/10" style={{ color: rank.color }}>
                                {rank.name}
                              </span>
                            </td>
                            <td className="py-4 px-6 text-white/80">
                              {(leader.total_hours || 0).toFixed(1)}h
                            </td>
                            <td className="py-4 px-6 text-right font-black text-amber-400">
                              {Math.floor((leader.total_hours || 0) / 4)} MANI
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </CyberCard>

            <TeamLeaderboard />
            <HallOfFame />
          </div>
        )}

        {/* ONGLET 3 : MUR SOCIAL & LFG */}
        {activeTab === 'social_lfg' && (
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div className="lg:col-span-5">
              <SocialFeedWall />
            </div>
            <div className="lg:col-span-7">
              <LfgMatchmakingBoard />
            </div>
          </div>
        )}

        {/* ONGLET 4 : QUÊTES & SOIRÉES */}
        {activeTab === 'quests' && (
          <CommunityQuestsEvents />
        )}

        {/* ONGLET 5 : BADGES */}
        {activeTab === 'achievements' && (
          <AchievementsGrid />
        )}

      </div>

      {/* Modal Adhésion Team */}
      {targetJoinTeam && (
        <TeamMembershipModal
          onClose={() => setTargetJoinTeam(null)}
          teamId={targetJoinTeam.teamId}
          config={targetJoinTeam.config}
          onConfirm={handleConfirmRequest}
          isPending={createRequest.isPending}
        />
      )}

      {/* Modal QG de Clan */}
      {hqTeam && (
        <TeamHqModal
          team={hqTeam.team}
          members={hqTeam.members}
          config={hqTeam.config}
          isMember={approvedTeams.some((r: any) => r.team_id === hqTeam.team.id)}
          onClose={() => setHqTeam(null)}
          onJoin={() => {
            const tId = hqTeam.team.id;
            setHqTeam(null);
            handleJoinTeam(tId);
          }}
        />
      )}

      {/* Modal Créer une Team pour Admin */}
      <CreateTeamModal
        isOpen={isCreateTeamOpen}
        onClose={() => setIsCreateTeamOpen(false)}
        onSuccess={() => {
          refetchMembers();
          window.location.reload();
        }}
      />

      {isAdmin && (
        <AdminMasterControlModal
          isOpen={isMasterModalOpen}
          onClose={() => setIsMasterModalOpen(false)}
        />
      )}
    </div>
  );
}
