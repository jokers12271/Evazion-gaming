import { useState } from 'react'
import { useAuth } from '@/hooks/useAuth'
import { NeonButton } from '@/components/ui/NeonButton'
import { Link, useNavigate } from '@tanstack/react-router'
import { UserPlus, Mail, Lock, User, ArrowRight, ImageIcon } from 'lucide-react'
import { toast } from 'react-hot-toast'

export function Register() {
  const { signUp } = useAuth()
  const navigate = useNavigate()
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [displayName, setDisplayName] = useState('')
  const [avatarUrl, setAvatarUrl] = useState('') // Nouvel état
  const [loading, setLoading] = useState(false)

  // AJOUTÉ : Fonction de validation de la complexité du mot de passe
  const validatePasswordStrength = (pass: string): string | null => {
    const hasUppercase = /[A-Z]/.test(pass);
    const hasLowercase = /[a-z]/.test(pass);
    const hasDigit = /[0-9]/.test(pass);
    const hasSpecial = /[^A-Za-z0-9]/.test(pass);
    const isAtLeast6Char = pass.length >= 6;

    if (!isAtLeast6Char) return "Le mot de passe doit faire au moins 6 caractères.";
    if (!hasUppercase) return "Le mot de passe doit contenir au moins une lettre majuscule (A-Z).";
    if (!hasLowercase) return "Le mot de passe doit contenir au moins une lettre minuscule (a-z).";
    if (!hasDigit) return "Le mot de passe doit contenir au moins un chiffre (0-9).";
    if (!hasSpecial) return "Le mot de passe doit contenir au moins un caractère spécial (ex: @, $, !, %).";

    return null; // Mot de passe conforme !
  }

  const handleRegister = async (e: React.FormEvent) => {
    e.preventDefault()

    // 1. Validation de la force du mot de passe
    const passwordError = validatePasswordStrength(password);
    if (passwordError) {
      toast.error(passwordError, { position: "bottom-center" });
      return;
    }

    setLoading(true)
    try {
      await signUp(email, password, displayName, avatarUrl)
      toast.success("Inscription confirmée pour le nouveau gamer !", {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid hsl(180, 100%, 50%)', // Bordure Néon Cyan
          borderRadius: '1rem',
          boxShadow: '0 0 15px hsl(180, 100%, 50%, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      });
      navigate({ to: '/dashboard' });
    } catch (error: any) {
      console.error(error);
      toast.error(error.message || "Erreur d'inscription")
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="pt-40 pb-24 min-h-screen flex items-center justify-center bg-background px-4">
      <div className="max-w-md w-full glass p-10 rounded-[2.5rem] border-white/5 relative">
        
        <div className="text-center mb-10">
          {/* APERÇU DE L'AVATAR EN TEMPS RÉEL */}
          <div className="w-24 h-24 rounded-full mx-auto mb-6 border-2 border-primary shadow-neon-violet overflow-hidden bg-white/5 flex items-center justify-center">
            {avatarUrl ? (
              <img src={avatarUrl} alt="Preview" className="w-full h-full object-cover" />
            ) : (
              <UserPlus className="text-primary/40" size={40} />
            )}
          </div>
          <h1 className="text-3xl font-display uppercase tracking-tighter text-white">Rejoindre l'Elite</h1>
        </div>

        <form onSubmit={handleRegister} className="space-y-5 text-left">
          <div>
            <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Nom de Gamer</label>
            <input required className="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-white mt-1" value={displayName} onChange={(e) => setDisplayName(e.target.value)} />
          </div>

          <div>
            <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Lien de ta photo (Avatar)</label>
            <div className="relative mt-1">
              <ImageIcon className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
              <input 
                placeholder="https://..." 
                className="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 text-white" 
                value={avatarUrl} 
                onChange={(e) => setAvatarUrl(e.target.value)} 
              />
            </div>
          </div>

          <div>
            <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Email</label>
            <input required type="email" className="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-white mt-1" value={email} onChange={(e) => setEmail(e.target.value)} />
          </div>

          <div>
            <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Mot de passe</label>
            <input required type="password" className="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-white mt-1" value={password} onChange={(e) => setPassword(e.target.value)} />
            
            {/* AJOUTÉ : Consignes de sécurité du mot de passe visiblement détaillées */}
            <div className="mt-2.5 ml-1 space-y-1 text-[8px] uppercase font-black text-white/40 tracking-wider">
              <span className="text-primary font-black block mb-1">Critères de sécurité requis :</span>
              <ul className="list-disc pl-3.5 space-y-1">
                <li>Au moins 6 caractères</li>
                <li>Au moins une lettre majuscule (A-Z)</li>
                <li>Au moins une lettre minuscule (a-z)</li>
                <li>Au moins un chiffre (0-9)</li>
                <li>Au moins un caractère spécial (ex: @, $, !, %)</li>
              </ul>
            </div>
          </div>

          <NeonButton disabled={loading} className="w-full py-4 mt-4">
            {loading ? "Chargement..." : "Créer ma carte de membre"}
          </NeonButton>
        </form>
      </div>
    </div>
  )
}
</file>

<file path="src/pages/Reservation.tsx">
import { useState } from 'react'
import { useReservations } from '@/hooks/useReservations'
import { useUserMetadata } from '@/hooks/useUserMetadata' 
import { NeonButton } from '@/components/ui/NeonButton'
import { useAuth } from '@/hooks/useAuth'
import { Clock, Monitor, AlertCircle, Power, PowerOff, CheckCircle2, Activity, Users } from 'lucide-react' // MODIFIÉ
import { cn } from '@blinkdotnew/ui'
import { toast } from 'react-hot-toast'
import { useStationsStatus } from '@/hooks/useStationsStatus'
import { useStationManagement } from '@/hooks/useStationManagement'
import { useQuery } from '@tanstack/react-query' // AJOUTÉ
import { supabase } from '@/lib/supabase' // AJOUTÉ

const DURATIONS = [
  { label: '⚡ 15 min', value: 15, price: 500 },
  { label: '🔥 30 min', value: 30, price: 1000 },
  { label: '🎮 1h', value: 60, price: 1500 },
  { label: '🏆 1h30', value: 90, price: 2000 },
  { label: '📦 Pack 4h', value: 240, price: 5000 },
];

export function Reservation() {
  const { isAuthenticated, user } = useAuth()
  const { reservations, createReservation } = useReservations()
  const { data: metadata } = useUserMetadata() 
  const { data: occupiedStations } = useStationsStatus(); 
  const { manualStates, toggleStation } = useStationManagement();

  const stations = Array.from({ length: 10 }, (_, i) => ({
    id: `PS5_${i + 1}`,
    name: `Station ${i + 1}`,
  }))

  // AJOUTÉ : Calcul du taux d'occupation des consoles du Sanctuary (en direct)
  const totalOccupied = stations.filter(station => {
    const isManuallyOccupied = manualStates?.find(s => s.station_id === station.id)?.is_manual_occupied;
    const isAutoOccupied = occupiedStations?.includes(station.id);
    return isAutoOccupied || isManuallyOccupied;
  }).length;
  const occupancyRate = Math.round((totalOccupied / 10) * 100);

  // AJOUTÉ : Filtrer les réservations actuellement en cours (solo)
  const activeSessions = reservations?.filter((res: any) => res.status === 'en cours') || [];
  
  const [selectedStation, setSelectedStation] = useState<string | null>(null)
  const [selectedDuration, setSelectedDuration] = useState<number>(60)
  const [totalPrice, setTotalPrice] = useState<number>(1500)
  const [selectedDate, setSelectedDate] = useState<string>(new Date().toISOString().split('T')[0])
  const [selectedTime, setSelectedTime] = useState<string>('14:00')
  const [showSuccessModal, setShowSuccessModal] = useState<boolean>(false) // AJOUTÉ

  const isAdmin = (metadata as any)?.is_admin;

  const handleBooking = async () => {
    if (!isAuthenticated || !user) { 
      toast.error("Connexion requise pour réserver une session");
      window.location.href = '/login'; 
      return; 
    }
    if (!selectedStation) { toast.error('Choisissez un poste'); return; }

    const startTime = new Date(`${selectedDate}T${selectedTime}`)
    const endTime = new Date(startTime.getTime() + selectedDuration * 60000)

    const hasConflict = reservations?.some((res: any) => {
      if (res.station_id !== selectedStation || res.status === 'annulé') return false;
      const resStart = new Date(res.start_time);
      const resEnd = new Date(res.end_time);
      return (startTime < resEnd && endTime > resStart);
    });

    if (hasConflict) {
      toast.error("Ce créneau est déjà réservé sur ce poste.");
      return;
    }

    try {
      await createReservation.mutateAsync({
        station_id: selectedStation,
        start_time: startTime.toISOString(),
        end_time: endTime.toISOString(),
        display_name: metadata?.display_name || user?.email || 'Gamer',
        status: 'pending'
      })
      setShowSuccessModal(true); // MODIFIÉ : Ouvre la modale de réussite
    } catch (error: any) {
      console.error("Détails de l'erreur de réservation :", error);
      toast.error(`Erreur de réservation : ${error.message || error}`); // MODIFIÉ (Affiche l'erreur exacte)
    }
  }

  return (
    <div className="pt-40 pb-24 min-h-screen bg-background text-center relative overflow-hidden animate-fade-in">
      {/* Fond d'écran immersif de la page */}
      <div className="absolute inset-0 z-0 pointer-events-none">
        <div className="absolute inset-0 bg-gradient-to-b from-background/10 via-background/80 to-background z-10" />
        <img 
          src="https://images.unsplash.com/photo-1606144042614-b2417e99c4e3?q=80&w=1600" 
          className="w-full h-full object-cover opacity-20" 
          alt="reservation gaming backdrop"
        />
      </div>
      <div className="container mx-auto px-4 text-white relative z-20">
        <div className="max-w-6xl mx-auto">
          
          <header className="mb-16">
            <h1 className="text-5xl md:text-7xl font-display font-black uppercase tracking-tighter mb-4 text-white">
              {isAdmin ? 'GESTION DES' : 'RÉSERVER VOTRE'} <span className="text-primary italic">{isAdmin ? 'POSTES' : 'SESSION'}</span>
            </h1>
            <p className="text-muted-foreground text-lg max-w-2xl mx-auto uppercase text-xs tracking-widest font-bold">
              {isAdmin ? 'Contrôlez l\'état des stations en temps réel' : 'Choisissez votre poste et votre temps de jeu.'}
            </p>
          </header>

          <div className="grid grid-cols-1 lg:grid-cols-3 gap-12 text-white text-left">
            
            <div className="lg:col-span-2 space-y-12">
              
              {/* SECTION SÉLECTION POSTE (TOUJOURS VISIBLE) */}
              <section>
                <div className={cn("flex items-center mb-8", isAdmin ? "justify-center" : "justify-between")}>
                  <div className="flex items-center gap-3">
                    <Monitor className="text-primary" />
                    <h2 className="text-2xl font-display uppercase tracking-wider text-white text-center">
                      {isAdmin ? 'État des Stations du Hub' : 'Sélectionner un poste'}
                    </h2>
                  </div>
                  {isAdmin && (
                    <span className="text-[10px] font-black uppercase tracking-widest text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20 animate-pulse">
                      Mode Administrateur
                    </span>
                  )}
                </div>

                <div className="grid grid-cols-2 sm:grid-cols-5 gap-4">
                  {stations.map((station) => {
                    const isManuallyOccupied = manualStates?.find(s => s.station_id === station.id)?.is_manual_occupied;
                    const isAutoOccupied = occupiedStations?.includes(station.id);
                    const isOccupied = isAutoOccupied || isManuallyOccupied;

                    return (
                      <div key={station.id} className="flex flex-col gap-2">
                        <button
                          onClick={() => !isAdmin && !isOccupied && setSelectedStation(station.id)}
                          disabled={!isAdmin && isOccupied}
                          className={cn(
                            'w-full aspect-square rounded-xl glass border-white/5 p-4 flex flex-col items-center justify-center gap-3 transition-all relative overflow-hidden',
                            !isAdmin && selectedStation === station.id && 'border-primary bg-primary/10 shadow-neon-violet',
                            isOccupied && 'border-orange-500/50 bg-orange-500/5'
                          )}
                        >
                          <div className={cn(
                            "absolute top-3 right-3 w-2.5 h-2.5 rounded-full",
                            isOccupied ? "bg-orange-500 animate-pulse shadow-[0_0_8px_#f97316]" : "bg-green-500 shadow-[0_0_8px_#22c55e]"
                          )} />

                          <div className={cn(
                            'w-12 h-12 rounded-lg bg-white/5 flex items-center justify-center transition-colors',
                            !isAdmin && selectedStation === station.id && 'bg-primary/20 text-primary',
                            isOccupied && 'text-orange-500'
                          )}>
                            <Monitor size={24} />
                          </div>
                          <span className={cn(
                            "text-[10px] font-display font-black uppercase tracking-widest",
                            isOccupied ? "text-orange-500" : "text-white/60"
                          )}>
                            {isOccupied ? (isManuallyOccupied ? 'BLOQUÉ' : 'OCCUPÉ') : station.name}
                          </span>
                        </button>

                        {/* --- ACTIONS ADMIN (Affichées en dessous de chaque station) --- */}
                        {isAdmin && (
                          <div className="flex flex-col gap-1.5 mt-1 animate-fade-in">
                            <button 
                              onClick={(e) => { e.stopPropagation(); toggleStation.mutate({ id: station.id, status: true }) }}
                              className="w-full flex items-center justify-center gap-2 text-[9px] font-black uppercase bg-orange-600 text-white py-2 rounded-lg hover:bg-orange-500 transition-all shadow-md"
                            >
                              <PowerOff size={10} /> Bloquer
                            </button>
                            <button 
                              onClick={(e) => { e.stopPropagation(); toggleStation.mutate({ id: station.id, status: false }) }}
                              className="w-full flex items-center justify-center gap-2 text-[9px] font-black uppercase bg-green-600 text-white py-2 rounded-lg hover:bg-green-500 transition-all shadow-md"
                            >
                              <Power size={10} /> Libérer
                            </button>
                          </div>
                        )}
                      </div>
                    )
                  })}
                </div>
              </section>

              {/* --- SECTION CACHÉE POUR L'ADMIN --- */}
              {!isAdmin && (
                <>
                  <section>
                    <div className="flex items-center gap-3 mb-8">
                      <Clock className="text-secondary" />
                      <h2 className="text-2xl font-display uppercase tracking-wider text-white">Durée & Tarif</h2>
                    </div>
                    <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
                      {DURATIONS.map((dur) => (
                        <button
                          key={dur.value}
                          onClick={() => { setSelectedDuration(dur.value); setTotalPrice(dur.price); }}
                          className={cn(
                            'py-4 px-2 rounded-xl glass border-white/5 flex flex-col items-center gap-2 transition-all',
                            selectedDuration === dur.value && 'border-secondary bg-secondary/10 shadow-neon-cyan'
                          )}
                        >
                          <span className="text-sm font-bold text-white uppercase">{dur.label}</span>
                          <span className="text-[9px] font-black uppercase text-muted-foreground">{dur.price} FCFA</span>
                        </button>
                      ))}
                    </div>
                  </section>

                  <section className="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div className="space-y-4">
                      <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Heure de début</label>
                      <input type="time" value={selectedTime} onChange={(e) => setSelectedTime(e.target.value)} className="w-full bg-white/5 border border-white/10 rounded-xl py-4 px-4 text-white focus:outline-none focus:border-primary text-center font-bold" />
                    </div>
                    <div className="space-y-4">
                      <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Date</label>
                      <input type="date" value={selectedDate} onChange={(e) => setSelectedDate(e.target.value)} className="w-full bg-white/5 border border-white/10 rounded-xl py-4 px-4 text-white focus:outline-none focus:border-primary text-center font-bold" />
                    </div>
                  </section>
                </>
              )}
            </div>

            {/* --- BARRE LATÉRALE CONDITIONNELLE (TICKET OU PANNEAU DE CONTRÔLE ADMIN) --- */}
            <div className="lg:col-span-1">
              {!isAdmin ? (
                // A. BARRE DU JOUEUR (TICKET)
                <div className="glass border-white/10 rounded-3xl p-8 sticky top-32 shadow-2xl">
                  <h3 className="text-xl font-display font-black uppercase tracking-widest mb-8 pb-4 border-b border-white/5 text-center text-white">VOTRE TICKET</h3>
                  <div className="space-y-6 mb-12">
                    <div className="flex justify-between items-center text-sm">
                      <span className="text-muted-foreground uppercase font-black tracking-widest text-[10px]">Poste</span>
                      <span className="text-white font-black uppercase tracking-widest">{selectedStation || 'Non choisi'}</span>
                    </div>
                    <div className="flex justify-between items-center text-sm">
                      <span className="text-muted-foreground uppercase font-black tracking-widest text-[10px]">Temps</span>
                      <span className="text-white font-black uppercase tracking-widest">{selectedDuration} min</span>
                    </div>
                    <div className="flex justify-between items-center pt-6 border-t border-white/5">
                      <span className="text-primary font-display font-black uppercase tracking-widest">TOTAL</span>
                      {(() => {
                        const hasGlobalDiscount = (metadata as any)?.discount_perk_until && new Date((metadata as any).discount_perk_until) > new Date();
                        const realPrice = hasGlobalDiscount ? Math.round(totalPrice * 0.9) : totalPrice;

                        return (
                          <span className="text-3xl font-display font-black text-white">
                            {hasGlobalDiscount ? (
                              <span className="flex items-baseline gap-3 mr-1">
                                <span className="line-through opacity-30 text-sm">{totalPrice}</span>
                                <span className="text-secondary text-glow-cyan font-black">{realPrice}</span>
                              </span>
                            ) : totalPrice}
                            <span className="text-sm font-normal"> FCFA</span>
                          </span>
                        );
                      })()}
                    </div>
                  </div>
                  <NeonButton onClick={handleBooking} className="w-full py-5 text-base font-black uppercase tracking-[0.2em]">Confirmer</NeonButton>
                </div>
              ) : (
                // B. BARRE DE L'ADMINISTRATEUR (PANNEAU DE CONTRÔLE LIVE)
                <div className="glass border-white/10 rounded-3xl p-8 sticky top-32 shadow-2xl text-left">
                  <h3 className="text-xl font-display font-black uppercase tracking-widest mb-8 pb-4 border-b border-white/5 text-center text-secondary text-glow-cyan flex items-center justify-center gap-2">
                    <Activity size={18} /> LIVE CONTROLE
                  </h3>
                  
                  {/* Taux d'occupation en direct du Hub */}
                  <div className="space-y-3 mb-8">
                    <div className="flex justify-between items-center text-xs font-black uppercase tracking-widest text-white/50">
                      <span>Occupation du Hub</span>
                      <span className="text-secondary text-glow-cyan">{occupancyRate}%</span>
                    </div>
                    <div className="h-2.5 w-full bg-white/5 rounded-full p-0.5 border border-white/5 overflow-hidden">
                      <div className="h-full rounded-full bg-secondary shadow-neon-cyan transition-all duration-500" style={{ width: `${occupancyRate}%` }} />
                    </div>
                    <p className="text-[9px] uppercase font-bold text-white/20 tracking-wider text-center">{totalOccupied} / 10 consoles allumées</p>
                  </div>

                  {/* Liste des Sessions Solo en cours */}
                  <div className="space-y-3 mb-8 border-t border-white/5 pt-6">
                    <p className="text-[10px] font-black uppercase text-white/40 tracking-widest">Sessions en cours :</p>
                    <div className="space-y-2.5 max-h-[180px] overflow-y-auto pr-1 custom-scrollbar">
                      {activeSessions && activeSessions.length > 0 ? (
                        activeSessions.map((res: any) => (
                          <div key={res.id} className="p-3.5 rounded-2xl bg-white/5 border border-white/5 flex items-center justify-between text-white">
                            <div>
                              <p className="text-xs font-black uppercase tracking-wider">{res.station_id}</p>
                              <p className="text-[9px] text-muted-foreground uppercase font-bold" translate="no">@{res.display_name}</p>
                            </div>
                            <span className="text-[8px] font-black uppercase px-2.5 py-1 rounded-full bg-secondary/10 text-secondary border border-secondary/20">Solo Active</span>
                          </div>
                        ))
                      ) : (
                        <p className="text-[10px] italic text-white/15 uppercase tracking-widest text-center py-4">Aucune session solo active</p>
                      )}
                    </div>
                  </div>

                  {/* Raccourcis Terminal Admin */}
                  <div className="space-y-3 border-t border-white/5 pt-6">
                    <p className="text-[10px] font-black uppercase text-white/40 tracking-widest">Raccourcis Terminal :</p>
                    <button 
                      onClick={() => window.location.href = '/salon'}
                      className="w-full py-3 bg-white/5 border border-white/10 hover:border-primary text-white rounded-xl text-[9px] font-black uppercase tracking-widest transition-all text-center"
                    >
                      Consulter le Salon Live
                    </button>
                    <button 
                      onClick={() => window.location.href = '/scanner'}
                      className="w-full py-3 bg-primary/20 border border-primary/30 hover:border-primary text-white rounded-xl text-[9px] font-black uppercase tracking-widest transition-all text-center shadow-neon-violet"
                    >
                      Lancer le Scanner
                    </button>
                  </div>
                </div>
              )}
            </div>

          </div>
        </div>
      </div>

      {/* AJOUTÉ : Pop-up centré de confirmation de réservation */}
      {showSuccessModal && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-md z-[100] flex items-center justify-center p-4 animate-fade-in text-center">
          <div className="glass p-10 rounded-[2.5rem] border-2 border-primary shadow-neon-violet max-w-md w-full relative">
            <div className="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <CheckCircle2 className="text-primary animate-pulse" size={40} />
            </div>
            <h3 className="text-2xl font-display font-black uppercase text-white mb-4">Réservation Enregistrée !</h3>
            <p className="text-sm text-muted-foreground leading-relaxed mb-8">
              Félicitations ! Votre créneau de jeu sur le poste <span className="text-primary font-bold">{selectedStation}</span> a bien été réservé. Retrouvez tous les détails sur votre espace de membre.
            </p>
            <div className="flex flex-col gap-4">
              <button 
                onClick={() => window.location.href = '/dashboard'}
                className="w-full py-4 bg-primary text-white rounded-xl text-xs font-black uppercase tracking-widest hover:scale-105 transition-all shadow-neon-violet"
              >
                Accéder à mon espace
              </button>
              <button 
                onClick={() => { setShowSuccessModal(false); setSelectedStation(null); }}
                className="text-[10px] font-black uppercase text-white/40 tracking-widest hover:text-white transition-colors"
              >
                Fermer
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  )
}
</file>

<file path="src/pages/Salon.tsx">
import { useQuery, useQueryClient } from '@tanstack/react-query' // MODIFIÉ
import { supabase } from '@/lib/supabase'
import { Users, Loader2, Star, Clock } from 'lucide-react'
import { getRank } from '@/lib/ranks'
import { cn } from '@blinkdotnew/ui'
import { formatDistanceToNow } from 'date-fns'
import { fr } from 'date-fns/locale'
import { useUserMetadata } from '@/hooks/useUserMetadata' // AJOUTÉ
import { toast } from 'react-hot-toast' // AJOUTÉ
import { NeonButton } from '@/components/ui/NeonButton' // AJOUTÉ

export function Salon() {
  const { data: metadata } = useUserMetadata() // AJOUTÉ
  const isAdmin = metadata?.is_admin || false; // AJOUTÉ
  const queryClient = useQueryClient(); // AJOUTÉ

  // AJOUTÉ : Fonction d'administration pour réinitialiser le salon à la fermeture
  const handleClearAllPresences = async () => {
    if (!confirm("Voulez-vous vraiment vider toutes les présences du salon (fermeture de la salle) ?")) return;
    
    try {
      const { error } = await supabase
        .from('users_metadata')
        .update({ is_present: false })
        .eq('is_present', true);

      if (error) throw error;
      toast.success("Salon vidé avec succès !", {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid #ef4444',
          borderRadius: '1rem',
          boxShadow: '0 0 15px rgba(239, 68, 68, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      });
      queryClient.invalidateQueries({ queryKey: ['present_users'] });
    } catch (e) {
      toast.error("Erreur lors de la fermeture administrative", { position: "bottom-center" });
    }
  };

  // Charger la liste des joueurs dont la colonne 'is_present' est égale à TRUE
  const { data: presentUsers, isLoading } = useQuery({
    queryKey: ['present_users'],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('users_metadata')
        .select('*, loyalty_points(points, total_hours)')
        .eq('is_present', true)
        .order('last_scanned_at', { ascending: false });

      if (error) {
        console.error("Erreur de chargement de la salle :", error.message);
        throw error;
      }
      return data || [];
    },
    refetchInterval: 10000 // Actualisation automatique toutes les 10 secondes
  });

  return (
    <div className="pt-40 pb-24 min-h-screen bg-background text-center font-display relative overflow-hidden animate-fade-in">
      {/* Fond d'écran immersif cyberpunk */}
      <div className="absolute inset-0 z-0 pointer-events-none">
        <div className="absolute inset-0 bg-gradient-to-b from-background/10 via-background/80 to-background z-10" />
        <img 
          src="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1600" 
          className="w-full h-full object-cover opacity-20" 
          alt="salon backdrop"
        />
      </div>

      <div className="container mx-auto px-4 max-w-5xl relative z-20">
        
        {/* HEADER */}
        <header className="mb-16">
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full glass border-white/10 mb-6 text-white">
            <Users className="text-secondary" size={14} />
            <span className="text-[10px] uppercase tracking-[0.2em] font-black">LE SALON LIVE</span>
          </div>
          <h1 className="text-6xl md:text-8xl font-black uppercase tracking-tighter text-white leading-none">
            JOUEURS <br /><span className="text-secondary text-glow-cyan italic">EN SALLE</span>
          </h1>
          <p className="text-muted-foreground uppercase text-[10px] font-bold tracking-[0.3em] mt-4">
            Liste actualisée en direct • {presentUsers?.length || 0} joueur(s) présent(s)
          </p>
        </header>

        {/* LISTE DES JOUEURS ACTUELLEMENT DANS LA SALLE */}
        <section className="glass border-white/5 rounded-[2.5rem] overflow-hidden text-left shadow-2xl">
          <div className="p-8 border-b border-b-white/5 bg-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <h3 className="font-black uppercase tracking-widest text-sm flex items-center gap-3 text-white">
              <Star className="text-secondary" size={20} /> ACTUELLEMENT DANS LE COCON
            </h3>
            <div className="flex items-center gap-4">
              <span className="text-[9px] font-black text-white/30 uppercase tracking-widest italic animate-pulse">LIVE</span>
              {isAdmin && (
                <NeonButton 
                  variant="orange" 
                  size="sm" 
                  className="text-[9px] font-black tracking-widest py-2 px-4 shadow-neon-orange"
                  onClick={handleClearAllPresences}
                >
                  VIDER LE SALON (FERMETURE)
                </NeonButton>
              )}
            </div>
          </div>

          {isLoading ? (
            <div className="p-32 flex flex-col items-center justify-center">
              <Loader2 className="animate-spin text-secondary mb-4" size={40} />
              <p className="text-[10px] uppercase font-black tracking-widest text-white/40">Détection de présence en cours...</p>
            </div>
          ) : (
            <div className="p-0">
              {presentUsers && presentUsers.length > 0 ? (
                presentUsers.map((player: any) => {
                  const lp = Array.isArray(player.loyalty_points) ? player.loyalty_points[0] : player.loyalty_points;
                  const rankInfo = getRank(lp?.total_hours || 0);

                  return (
                    <div 
                      key={player.user_id} 
                      className="group flex items-center gap-6 p-8 border-b border-white/5 hover:bg-white/5 transition-all duration-300 text-white"
                    >
                      {/* Avatar du Joueur */}
                      <div className="w-14 h-14 rounded-2xl overflow-hidden border border-white/10 bg-white/5 flex items-center justify-center relative">
                        {player.avatar_url ? (
                          <img src={player.avatar_url} className="w-full h-full object-cover" alt="avatar" />
                        ) : (
                          <Star size={20} className="text-white/10" />
                        )}
                        <div className={cn("absolute bottom-0 left-0 right-0 h-1")} style={{ backgroundColor: rankInfo.color }} />
                      </div>

                      {/* Identité & Team */}
                      <div className="flex-1">
                        <div translate="no" className="font-black text-2xl uppercase tracking-tighter text-white group-hover:text-secondary transition-colors leading-none mb-1">
                          {player.display_name}
                        </div>
                        <div className="flex items-center gap-2 text-[9px] font-black uppercase tracking-widest">
                          <span style={{ color: rankInfo.color }}>Rang {rankInfo.name}</span>
                          {player.community_team && (
                            <>
                              <span className="opacity-30">•</span>
                              <span className="text-primary">Team {player.community_team}</span>
                            </>
                          )}
                        </div>
                      </div>

                      {/* Temps depuis l'arrivée */}
                      <div className="text-right flex items-center gap-2 text-xs font-bold text-muted-foreground uppercase tracking-widest">
                        <Clock size={14} className="text-secondary shrink-0" />
                        <span>
                          Arrivé il y a {player.last_scanned_at ? formatDistanceToNow(new Date(player.last_scanned_at), { locale: fr }) : "quelques instants"}
                        </span>
                      </div>
                    </div>
                  );
                })
              ) : (
                <div className="p-32 text-center">
                  <p className="text-sm uppercase font-black tracking-[0.4em] text-white/15 leading-relaxed">
                    Le cocon est calme... <br />Aucun joueur n'a encore validé sa présence à l'accueil.
                  </p>
                </div>
              )}
            </div>
          )}
        </section>
      </div>
    </div>
  );
}
</file>

<file path="src/pages/Scanner.tsx">
import { useState } from 'react'
import BarcodeScannerComponent from 'react-qr-barcode-scanner'
import { useNavigate } from '@tanstack/react-router'
import { X, Camera, ShieldCheck } from 'lucide-react'
import { useAuth } from '@/hooks/useAuth' // AJOUTÉ
import { useUserMetadata, useUpdatePresence } from '@/hooks/useUserMetadata' // AJOUTÉ
import { toast } from 'react-hot-toast' // AJOUTÉ

export function Scanner() {
  const navigate = useNavigate()
  const { user } = useAuth() // AJOUTÉ
  const { data: metadata } = useUserMetadata() // AJOUTÉ
  const updatePresenceMutation = useUpdatePresence() // AJOUTÉ
  const [stopStream, setStopStream] = useState(false)

  const isAdmin = metadata?.is_admin || false;

  // AJOUTÉ : Logique de routage dynamique du scan
  const handleScanUpdate = async (scannedText: string) => {
    setStopStream(true);

    if (scannedText === 'EVAZION_ENTREE') {
      // 1. SCAN D'ENTRÉE SALLE PAR LE JOUEUR
      if (!user) {
        toast.error("Veuillez vous connecter pour valider votre entrée", { position: "bottom-center" });
        navigate({ to: '/login' });
        return;
      }

      try {
        await updatePresenceMutation.mutateAsync('entree');
        toast.success("Présence validée ! Bienvenue au Sanctuary.", {
          position: "bottom-center",
          style: {
            background: '#040405',
            color: '#ffffff',
            border: '2px solid #22c55e', // Bordure verte
            borderRadius: '1rem',
            boxShadow: '0 0 15px rgba(34, 197, 94, 0.4)',
            fontSize: '11px',
            fontWeight: '900',
            textTransform: 'uppercase',
            letterSpacing: '0.15em',
            padding: '12px 24px'
          }
        });
        navigate({ to: '/dashboard' });
      } catch (err) {
        toast.error("Erreur de validation de présence", { position: "bottom-center" });
        setStopStream(false);
      }

    } else if (scannedText === 'EVAZION_SORTIE') {
      // 2. SCAN DE SORTIE SALLE PAR LE JOUEUR
      if (!user) {
        toast.error("Veuillez vous connecter", { position: "bottom-center" });
        navigate({ to: '/login' });
        return;
      }

      try {
        await updatePresenceMutation.mutateAsync('sortie');
        toast.success("Départ validé ! À bientôt au Sanctuary.", {
          position: "bottom-center",
          style: {
            background: '#040405',
            color: '#ffffff',
            border: '2px solid #ef4444', // Bordure rouge
            borderRadius: '1rem',
            boxShadow: '0 0 15px rgba(239, 68, 68, 0.4)',
            fontSize: '11px',
            fontWeight: '900',
            textTransform: 'uppercase',
            letterSpacing: '0.15em',
            padding: '12px 24px'
          }
        });
        navigate({ to: '/dashboard' });
      } catch (err) {
        toast.error("Erreur de validation de départ", { position: "bottom-center" });
        setStopStream(false);
      }

    } else {
      // 3. SCAN DE CARTES DE MEMBRES (ADMIN SEULEMENT)
      if (isAdmin) {
        window.location.href = `/dashboard/player/${scannedText}`;
      } else {
        toast.error("Code QR non reconnu ou réservé à l'administration", { position: "bottom-center" });
        setStopStream(false);
      }
    }
  }

  return (
    <div className="fixed inset-0 bg-black z-[100] flex flex-col items-center justify-center p-6 animate-fade-in">
      {/* Bouton pour fermer et revenir au Dashboard */}
      <button 
        onClick={() => navigate({ to: '/dashboard' })} 
        className="absolute top-10 right-10 text-white/50 hover:text-white transition-colors"
      >
        <X size={40} />
      </button>

      <div className="text-center mb-10">
        <div className="w-16 h-16 bg-cyan-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-cyan-500/50">
          <Camera className="text-cyan-400 animate-pulse" size={32} />
        </div>
        <h2 className="text-3xl font-display font-black uppercase text-white tracking-widest">Scanner de Pass</h2>
        <p className="text-cyan-500/60 text-[10px] font-black uppercase mt-2 tracking-[0.2em]">Pointez l'objectif vers un QR code d'accès ou de salle</p>
      </div>

      {/* ZONE DE LA CAMÉRA */}
      <div className="relative w-full max-w-sm aspect-square rounded-[3rem] overflow-hidden border-4 border-cyan-500 shadow-[0_0_50px_rgba(6,182,212,0.3)] bg-black">
        <BarcodeScannerComponent
          width="100%"
          height="100%"
          stopStream={stopStream}
          onUpdate={(err, result) => {
            if (result) {
              handleScanUpdate(result.getText());
            }
          }}
        />
        
        {/* Viseur décoratif "Cyber" */}
        <div className="absolute inset-12 border-2 border-cyan-500/30 rounded-3xl border-dashed animate-pulse" />
        <div className="absolute top-0 left-0 w-full h-1 bg-cyan-500/50 shadow-neon-cyan animate-[scan_2s_linear_infinite]" />
      </div>

      <div className="mt-12 flex items-center gap-3 text-white/20 uppercase font-black text-[10px] tracking-[0.3em]">
        <ShieldCheck size={14} />
        Terminal Sécurisé Evazion
      </div>

      <style>{`
        @keyframes scan {
          0% { top: 0; }
          100% { top: 100%; }
        }
      `}</style>
    </div>
  )
}
</file>

<file path="src/pages/Store.tsx">
import { useState } from 'react'
import { useRewards, Reward } from '@/hooks/useRewards'
import { useLoyalty } from '@/hooks/useLoyalty'
import { useUserMetadata } from '@/hooks/useUserMetadata'
import { useAuth } from '@/hooks/useAuth'
import { NeonButton } from '@/components/ui/NeonButton'
import { Star, Loader2, ShoppingBag, Plus, X, Trash2, Edit2, ImageIcon } from 'lucide-react'
import { cn } from '@blinkdotnew/ui'
import { getRank } from '@/lib/ranks'
import { toast } from 'react-hot-toast'

export function Store() {
  const { user } = useAuth()
  const { data: loyalty } = useLoyalty()
  const { data: metadata } = useUserMetadata()
  const { rewards, addReward, updateReward, deleteReward, claimReward } = useRewards()

  const isAdmin = (metadata as any)?.is_admin
  const points = loyalty?.points || 0
  const currentRank = getRank(points)
  const [purchasedItem, setPurchasedItem] = useState<any | null>(null) // AJOUTÉ

  // États pour la gestion Admin
  const [showForm, setShowForm] = useState(false)
  const [editingId, setEditingId] = useState<string | null>(null)
  const [formData, setFormData] = useState({
    name: '', description: '', mani_cost: 0, category: 'Consommable', image_url: '',
    action_type: 'none', action_value: '' // AJOUTÉS
  })

  const handleEdit = (item: Reward) => {
    setFormData({
      name: item.name,
      description: item.description,
      mani_cost: item.mani_cost,
      category: item.category,
      image_url: item.image_url,
      action_type: item.action_type || 'none', // AJOUTÉ
      action_value: item.action_value || '' // AJOUTÉ
    })
    setEditingId(item.id)
    setShowForm(true)
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    try {
      if (editingId) {
        await updateReward.mutateAsync({ ...formData, id: editingId } as Reward)
      } else {
        await addReward.mutateAsync(formData)
      }
      setShowForm(false); setEditingId(null)
      setFormData({ name: '', description: '', mani_cost: 0, category: 'Consommable', image_url: '', action_type: 'none', action_value: '' })
    } catch (err) {
      toast.error("Erreur de sauvegarde")
    }
  }

  const handleBuy = (reward: any) => {
    if (!user) return
    
    // Vérifier si la réduction de 10% globale est active sur son compte
    const hasGlobalDiscount = (metadata as any)?.discount_perk_until && new Date((metadata as any).discount_perk_until) > new Date();
    const realCost = hasGlobalDiscount ? Math.round(reward.mani_cost * 0.9) : reward.mani_cost;

    if (confirm(`Échanger ${realCost} MANI contre "${reward.name}" ?`)) {
      claimReward.mutate({
        rewardId: reward.id,
        userId: user.id,
        displayName: metadata?.display_name || user.email || 'Gamer'
      }, {
        onSuccess: () => {
          setPurchasedItem(reward); // Ouvre la modale de réussite
        }
      })
    }
  }

  const ManiIcon = ({ size = "w-5 h-5" }) => (
    <div className={cn("rounded-full overflow-hidden border border-primary/40 bg-background shadow-neon-violet", size)}>
      <img src="/mani.jpg" alt="M" className="w-full h-full object-cover scale-110" />
    </div>
  )

  return (
    <div className="pt-40 pb-24 min-h-screen bg-background text-center relative overflow-hidden animate-fade-in">
      {/* Fond d'écran immersif de la page */}
      <div className="absolute inset-0 z-0 pointer-events-none">
        <div className="absolute inset-0 bg-gradient-to-b from-background/10 via-background/80 to-background z-10" />
        <img 
          src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=1600" 
          className="w-full h-full object-cover opacity-20" 
          alt="store gear backdrop"
        />
      </div>
      <div className="container mx-auto px-4 max-w-6xl relative z-20">
        
        <header className="mb-16">
          <h1 className="text-6xl md:text-8xl font-display font-black uppercase tracking-tighter text-white">
            EVAZION <span className="text-primary italic">STORE</span>
          </h1>
          
          {/* LE SOLDE EST DÉSORMAIS MASQUÉ POUR L'ADMINISTRATEUR OU REQUALIFIÉ POUR VISITEUR ANONYME */}
          {user ? (
            !isAdmin && (
              <div className="mt-8 inline-flex items-center gap-6 glass px-10 py-5 rounded-full border-white/5 shadow-2xl animate-fade-in">
                <div className="flex items-baseline gap-4 font-display font-black uppercase tracking-widest text-white">
                  <span className="text-3xl opacity-80">SOLDE =</span>
                  <span className="text-5xl flex items-center gap-3" style={{ color: currentRank.color }}>
                    {points}
                    <div className="w-12 h-12 rounded-full overflow-hidden border-2 border-primary shadow-neon-violet">
                       <img src="/mani.jpg" alt="M" className="w-full h-full object-cover scale-110" />
                    </div>
                  </span>
                </div>
              </div>
            )
          ) : (
            <div className="mt-8 inline-flex items-center gap-6 glass px-8 py-4 rounded-full border-white/5 shadow-2xl animate-fade-in text-white/60 text-[10px] font-black uppercase tracking-widest">
              <span>Connectez-vous pour voir vos MANI et échanger des récompenses !</span>
            </div>
          )}

          {isAdmin && (
            <button 
              onClick={() => { setShowForm(!showForm); setEditingId(null); }}
              className="mt-12 flex items-center gap-2 mx-auto bg-white text-black px-8 py-4 rounded-full font-black uppercase text-xs hover:bg-primary transition-all shadow-xl"
            >
              {showForm ? <X size={18}/> : <Plus size={18}/>}
              {showForm ? "Fermer l'éditeur" : "Ajouter un article"}
            </button>
          )}
        </header>

        {/* FORMULAIRE ADMIN */}
        {isAdmin && showForm && (
          <div className="mb-20 glass p-10 rounded-[3rem] border-primary/20 text-left max-w-4xl mx-auto animate-fade-in shadow-2xl">
            <h2 className="text-2xl font-black uppercase mb-8 text-primary flex items-center gap-3">
              <ShoppingBag size={24}/> {editingId ? 'Modifier l\'article' : 'Nouvel Article Store'}
            </h2>
            <form onSubmit={handleSubmit} className="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div className="space-y-2">
                <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Nom de l'article</label>
                <input required className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary transition-all" value={formData.name} onChange={e => setFormData({...formData, name: e.target.value})} />
              </div>
              <div className="space-y-2">
                <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Catégorie</label>
                <select className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary transition-all" value={formData.category} onChange={e => setFormData({...formData, category: e.target.value})}>
                  <option value="Consommable">Consommable</option>
                  <option value="Temps de jeu">Temps de jeu</option>
                  <option value="Équipement">Équipement</option>
                  <option value="Boisson">Boisson</option>
                </select>
              </div>
              <div className="space-y-2">
                <label className="text-[10px] uppercase font-black text-muted-foreground ml-1 text-primary">Coût en MANI</label>
                <input required type="number" className="w-full bg-white/5 border border-primary/20 rounded-2xl p-4 text-white focus:border-primary transition-all" value={formData.mani_cost} onChange={e => setFormData({...formData, mani_cost: parseInt(e.target.value)})} />
              </div>
              <div className="space-y-2">
                <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">URL de l'image</label>
                <input className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary transition-all" placeholder="https://..." value={formData.image_url} onChange={e => setFormData({...formData, image_url: e.target.value})} />
              </div>

              {/* AJOUTÉ : Sélection de l'effet virtuel de l'article de Boutique */}
              <div className="space-y-2 col-span-1 md:col-span-2">
                <label className="text-[10px] uppercase font-black text-muted-foreground ml-1 text-primary">Effet Spécial (Droit / Action d'activation)</label>
                <select 
                  className="w-full bg-white/5 border border-primary/20 rounded-2xl p-4 text-white focus:border-primary focus:outline-none"
                  value={formData.action_type} 
                  onChange={e => setFormData({...formData, action_type: e.target.value, action_value: ''})}
                >
                  <option value="none" className="bg-background">Aucun effet (Objet physique standard)</option>
                  <option value="challenge_two_ranks" className="bg-background">Droit d'affronter un joueur de 2 rangs supérieurs (PVP)</option>
                  <option value="global_discount_10" className="bg-background">10% de réduction sur tout pendant 1 semaine</option>
                  <option value="pack_4h" className="bg-background">Créditer un Pack de temps de 4 heures (240 min)</option>
                  <option value="buy_mani" className="bg-background">Acheter / Recharger des jetons MANI</option>
                  <option value="buy_minutes" className="bg-background">Acheter / Recharger du crédit temps minutes</option>
                  <option value="weekend_priority" className="bg-background">Droit de priorité de réservation de week-end</option>
                  <option value="community_discount" className="bg-background">Réduction sur frais de communauté mensuels</option>
                  <option value="tournament_discount" className="bg-background">Réduction sur inscription de tournoi</option>
                </select>
              </div>

              {/* AJOUTÉ : Saisie de la valeur numérique de l'effet (ex: le pourcentage de réduction) */}
              {formData.action_type !== 'none' && formData.action_type !== 'challenge_two_ranks' && formData.action_type !== 'global_discount_10' && formData.action_type !== 'pack_4h' && formData.action_type !== 'weekend_priority' && (
                <div className="space-y-2 col-span-1 md:col-span-2 animate-fade-in">
                  <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Valeur numérique de l'effet (ex: Saisir '50' pour 50%, ou '60' pour 60 Min/MANI)</label>
                  <input 
                    required
                    type="number"
                    placeholder="Ex: 50"
                    className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary" 
                    value={formData.action_value || ''} 
                    onChange={e => setFormData({...formData, action_value: e.target.value})} 
                  />
                </div>
              )}

              <textarea placeholder="Description de la récompense..." className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white col-span-1 md:col-span-2 h-32" value={formData.description} onChange={e => setFormData({...formData, description: e.target.value})} />
              <NeonButton className="col-span-1 md:col-span-2 py-5 font-black uppercase tracking-widest">
                {editingId ? 'Mettre à jour l\'article' : 'Ajouter au Store'}
              </NeonButton>
            </form>
          </div>
        )}

        {/* LISTE DES ARTICLES */}
        {rewards.isLoading ? (
          <div className="py-20 flex flex-col items-center gap-4">
            <Loader2 className="mx-auto animate-spin text-primary" size={40} />
            <p className="text-[10px] uppercase font-black tracking-widest text-white/40">Synchronisation...</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 text-left">
            {rewards.data?.map((item: any) => (
              <div key={item.id} className="glass border-white/5 p-6 rounded-[2.5rem] flex flex-col relative overflow-hidden group hover:border-primary/30 transition-all duration-500">
                
                {isAdmin && (
                  <div className="absolute top-4 right-4 flex gap-2 z-20">
                    <button onClick={() => handleEdit(item)} className="p-2 bg-blue-500/20 text-blue-400 rounded-lg hover:bg-blue-500 hover:text-white transition-all backdrop-blur-md border border-blue-500/20"><Edit2 size={14}/></button>
                    <button onClick={() => { if(confirm("Supprimer cet article ?")) deleteReward.mutate(item.id) }} className="p-2 bg-red-500/20 text-red-400 rounded-lg hover:bg-red-500 hover:text-white transition-all backdrop-blur-md border border-red-500/20"><Trash2 size={14}/></button>
                  </div>
                )}

                <div className="aspect-square rounded-3xl overflow-hidden mb-6 bg-white/5">
                  <img src={item.image_url || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=400'} className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 opacity-80 group-hover:opacity-100" alt={item.name} />
                </div>

                <div className="flex-1 px-2">
                  <span className="text-[9px] font-black uppercase tracking-[0.2em] text-primary/60">{item.category}</span>
                  <h3 className="text-2xl font-display font-black text-white mt-1 uppercase tracking-tighter leading-none">{item.name}</h3>
                  <p className="text-xs text-muted-foreground mt-3 line-clamp-2 leading-relaxed font-medium">{item.description}</p>
                </div>

                <div className="mt-8 pt-6 border-t border-white/5 flex items-center justify-between px-2 text-white">
                  {/* AJOUTÉ : Évaluation de la réduction globale en direct */}
                  {(() => {
                    const hasGlobalDiscount = (metadata as any)?.discount_perk_until && new Date((metadata as any).discount_perk_until) > new Date();
                    const realCost = hasGlobalDiscount ? Math.round(item.mani_cost * 0.9) : item.mani_cost;

                    return (
                      <div className="flex flex-col text-left">
                        <span className="text-[9px] font-black opacity-40 uppercase tracking-widest">Coût</span>
                        <span className="text-2xl font-display font-black flex items-center gap-2">
                          {hasGlobalDiscount ? (
                            <span className="flex items-center gap-2">
                              <span className="line-through opacity-30 text-xs">{item.mani_cost}</span>
                              <span className="text-secondary text-glow-cyan font-black">{realCost}</span>
                            </span>
                          ) : item.mani_cost} 
                          <ManiIcon size="w-5 h-5" />
                        </span>
                      </div>
                    );
                  })()}
                  
                  <NeonButton 
                    variant={user ? (points >= item.mani_cost ? "violet" : "ghost") : "violet"}
                    disabled={user ? (!loyalty || points < item.mani_cost || claimReward.isPending || isAdmin) : false}
                    onClick={() => {
                      if (!user) {
                        window.location.href = '/login';
                      } else {
                        handleBuy(item);
                      }
                    }}
                    className="px-6 py-2 text-[10px] font-black tracking-widest uppercase"
                  >
                    {isAdmin ? "MODE ADMIN" : (!user ? "ÉCHANGER" : (points >= item.mani_cost ? "ÉCHANGER" : "SOLDE BAS"))}
                  </NeonButton>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* AJOUTÉ : Pop-up de confirmation d'achat de la boutique */}
      {purchasedItem && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-md z-[100] flex items-center justify-center p-4 animate-fade-in text-center">
          <div className="glass p-10 rounded-[2.5rem] border-2 border-secondary shadow-neon-cyan max-w-md w-full relative">
            <div className="w-16 h-16 bg-secondary/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <ShoppingBag className="text-secondary animate-pulse" size={40} />
            </div>
            <h3 className="text-2xl font-display font-black uppercase text-white mb-4">Achat Validé !</h3>
            <p className="text-sm text-muted-foreground leading-relaxed mb-8">
              Félicitations ! Vous avez échangé vos MANI contre l'article <span className="text-secondary font-bold">{purchasedItem.name}</span>. Présentez-vous à l'accueil de la salle de jeux pour le récupérer.
            </p>
            <NeonButton 
              variant="cyan"
              className="w-full py-4 text-xs font-black tracking-widest"
              onClick={() => setPurchasedItem(null)}
            >
              Fermer
            </NeonButton>
          </div>
        </div>
      )}

    </div>
  )
}
</file>

<file path="src/pages/Tournaments.tsx">
import { useState } from 'react'
import { useTournaments, Tournament } from '@/hooks/useTournaments'
import { useTournamentParticipation, useMyTournamentRequest } from '@/hooks/useTournamentParticipation' // MODIFIÉ
import { useUserMetadata } from '@/hooks/useUserMetadata'
import { useAuth } from '@/hooks/useAuth'
import { NeonButton } from '@/components/ui/NeonButton'
import { Trophy, Calendar, Gamepad2, Users, ShieldAlert, Plus, X, Trash2, Edit2, Loader2, Image as ImageIcon, CheckCircle, CheckCircle2 } from 'lucide-react'
import { format } from 'date-fns'
import { fr } from 'date-fns/locale'
import { cn } from '@blinkdotnew/ui'
import { toast } from 'react-hot-toast'
import { TournamentRegisterModal } from '@/components/community/TournamentRegisterModal' // AJOUTÉ
import { TournamentRequestsAdmin } from '@/components/community/TournamentRequestsAdmin' // AJOUTÉ

// --- COMPOSANT CARTE DE TOURNOI ---
function TournamentCard({ tourney, isAdmin, onDelete, onEdit }: { 
  tourney: Tournament, 
  isAdmin: boolean, 
  onDelete: (id: string) => void, 
  onEdit: (t: Tournament) => void 
}) {
  const { user } = useAuth();
  const [showConditions, setShowConditions] = useState(false);
  const [showRegModal, setShowRegModal] = useState(false); // Pop-up de réussite
  const [showPayModal, setShowPayModal] = useState(false); // Modale de règlement d'entrée
  const { participants, register } = useTournamentParticipation(tourney.id);
  const { data: myRequest } = useMyTournamentRequest(tourney.id); // État de ma demande d'inscription

  // --- LOGIQUE : VÉRIFIER SI LE USER EST DÉJÀ DANS LA LISTE ---
  const isAlreadyRegistered = participants?.some((p: any) => p.user_id === user?.id);

  const { data: metadata } = useUserMetadata(); 

  const handleRegister = async () => {
    if (!user) return toast.error("Connectez-vous pour vous inscrire");
    
    try {
      await register.mutateAsync({ 
        userId: user.id, 
        displayName: metadata?.display_name || user.email || 'Gamer' 
      });
      setShowRegModal(true); // Ouvre la modale de réussite
      setShowPayModal(false);
    } catch (e: any) {
      console.error("Erreur d'inscription au tournoi :", e);
      toast.error(`Erreur d'inscription : ${e.message || e}`, { position: "bottom-center" });
    }
  };

  return (
    <div className="glass border-white/5 p-8 rounded-[2.5rem] text-left relative overflow-hidden group transition-all duration-500 hover:border-primary/30 min-h-[400px] flex flex-col justify-end">
      
      {/* 1. IMAGE DE FOND DU TOURNOI */}
      <div className="absolute inset-0 z-0">
        <img 
          src={tourney.image_url || 'https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800'} 
          className="w-full h-full object-cover opacity-30 group-hover:opacity-50 transition-opacity duration-700"
          alt={tourney.title}
        />
        <div className="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent" />
      </div>

      {/* 2. ACTIONS ADMIN */}
      {isAdmin && !showConditions && (
        <div className="absolute top-6 right-6 flex gap-2 z-20">
          <button onClick={() => onEdit(tourney)} className="p-2 bg-blue-500/20 text-blue-400 rounded-lg hover:bg-blue-500 hover:text-white transition-all backdrop-blur-md border border-blue-500/20 shadow-lg">
            <Edit2 size={16}/>
          </button>
          <button onClick={() => { if(confirm("Supprimer ce tournoi ?")) onDelete(tourney.id) }} className="p-2 bg-red-500/20 text-red-400 rounded-lg hover:bg-red-500 hover:text-white transition-all backdrop-blur-md border border-red-500/20 shadow-lg">
            <Trash2 size={16}/>
          </button>
        </div>
      )}

      {/* 3. CONTENU DE LA CARTE */}
      {!showConditions ? (
        <div className="relative z-10">
          <div className="flex justify-between items-start mb-6">
            <div className="w-12 h-12 rounded-xl bg-primary text-black flex items-center justify-center shadow-neon-violet">
              <Gamepad2 size={24} />
            </div>
            <span className="text-[10px] font-black border border-primary/50 bg-primary/10 text-primary px-3 py-1 rounded-full uppercase tracking-[0.2em]">
              {tourney.status}
            </span>
          </div>

          <h3 className="text-3xl font-display font-black uppercase mb-2 leading-none text-white drop-shadow-md">
            {tourney.title}
          </h3>
          <p className="text-secondary font-black text-xs uppercase tracking-[0.2em] mb-6">
            Discipline : {tourney.game}
          </p>

          <div className="flex flex-wrap gap-6 mb-8 text-[10px] uppercase font-black text-white/70 tracking-widest">
            <span className="flex items-center gap-2">
              <Calendar size={14} className="text-primary"/> 
              {tourney.date ? format(new Date(tourney.date), 'dd MMMM yyyy', { locale: fr }) : 'À CONFIRMER'}
            </span>
            <span className="flex items-center gap-2">
              <Users size={14} className="text-primary"/> 
              {participants?.length || 0} JOUEURS
            </span>
          </div>

          {/* Affichage dynamique des frais de tournoi sur chaque carte */}
          <div className="relative z-10 mb-6 flex justify-between items-center text-[9px] font-black uppercase text-white/40 tracking-wider">
            <span>Type : {(tourney as any).is_paid ? 'Payant' : 'Gratuit'}</span>
            {(tourney as any).is_paid && <span>Frais : {(tourney as any).fee_amount} FCFA</span>}
          </div>

          {/* --- BOUTON DYNAMIQUE SELON INSCRIPTION (Intégration du consensus de validation) --- */}
          {!isAdmin && (
            <NeonButton 
              className={cn(
                "w-full py-4 transition-all duration-500",
                user && myRequest?.status === 'approved' && "opacity-50 pointer-events-none grayscale"
              )} 
              onClick={() => {
                if (!user) {
                  window.location.href = '/login';
                } else {
                  setShowConditions(true); // Ouvre d'abord le règlement
                }
              }}
              variant={user && myRequest?.status === 'approved' ? "ghost" : "violet"}
            >
              {!user ? (
                <span>Se connecter pour s'inscrire</span>
              ) : myRequest?.status === 'pending' ? (
                <span className="text-yellow-500 animate-pulse">Demande en attente</span>
              ) : myRequest?.status === 'approved' ? (
                <span className="flex items-center justify-center gap-2">
                  <CheckCircle size={18} /> Déjà Inscrit
                </span>
              ) : (
                <span translate="no">S'inscrire au tournoi</span>
              )}
            </NeonButton>
          )}

          {isAdmin && (
            <div className="w-full py-3 text-center border border-white/10 rounded-xl bg-white/5 text-[10px] font-black uppercase tracking-[0.2em] text-white/40">
              Mode Gestion Admin
            </div>
          )}
        </div>
      ) : (
        /* 4. VUE INSCRIPTION (RÈGLEMENT DE LA SALLE) */
        <div className="relative z-10 animate-fade-in h-full flex flex-col">
          <button onClick={() => setShowConditions(false)} className="absolute -top-2 -right-2 text-white/50 hover:text-white transition-colors">
            <X size={28}/>
          </button>
          
          <h4 className="font-display text-primary text-xl mb-6 uppercase font-black tracking-tighter text-glow-violet">Arène d'inscription</h4>
          
          <div className="mb-6 flex-1">
            <p className="text-[10px] uppercase font-black text-white/40 mb-3 tracking-widest">Compétiteurs confirmés :</p>
            <div className="flex flex-wrap gap-2 max-h-32 overflow-y-auto pr-2 custom-scrollbar">
              {participants?.map((p: any, i: number) => (
                <span key={i} translate="no" className="text-[10px] font-black bg-white/10 px-3 py-1.5 rounded-lg border border-white/10 text-white uppercase tracking-widest">
                  @{p.display_name || 'Gamer'}
                </span>
              ))}
              {participants?.length === 0 && (
                <p className="text-[10px] italic text-white/40 uppercase tracking-widest">Ouverture de la liste...</p>
              )}
            </div>
          </div>

          <div className="bg-black/60 border border-primary/30 p-5 rounded-2xl mb-8 backdrop-blur-md">
            <p className="text-[10px] uppercase text-primary font-black mb-3 flex items-center gap-2 tracking-widest">
              <ShieldAlert size={14}/> Règlement du Hub :
            </p>
            <ul className="text-[9px] text-white/80 space-y-2 font-bold uppercase tracking-tighter">
              <li className="flex items-center gap-2"><div className="w-1 h-1 rounded-full bg-primary"/> Fair-play et respect strict</li>
              <li className="flex items-center gap-2"><div className="w-1 h-1 rounded-full bg-primary"/> Présence physique 15 min avant</li>
            </ul>
          </div>

          <NeonButton 
            className="w-full py-5 text-base font-black" 
            variant="violet" 
            onClick={() => {
              if ((tourney as any).is_paid) {
                setShowPayModal(true); // Si payant, ouvre la modale de paiement
              } else {
                handleRegister(); // Si gratuit, s'inscrit directement
              }
            }} 
            disabled={register.isPending || isAlreadyRegistered}
          >
            {register.isPending ? "TRANSMISSION..." : isAlreadyRegistered ? "INSCRIPTION EFFECTUÉE" : "VALIDER MON ENTRÉE (GO)"}
          </NeonButton>
        </div>
      )}

      {/* AJOUTÉ : Pop-up centré de confirmation d'inscription au tournoi (Réussite) */}
      {showRegModal && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-md z-[100] flex items-center justify-center p-4 animate-fade-in text-center">
          <div className="glass p-10 rounded-[2.5rem] border-2 border-primary shadow-neon-violet max-w-md w-full relative">
            <div className="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <CheckCircle2 className="text-primary animate-pulse" size={40} />
            </div>
            <h3 className="text-2xl font-display font-black uppercase text-white mb-4">Inscription Soumise !</h3>
            <p className="text-sm text-muted-foreground leading-relaxed mb-8">
              Félicitations ! Votre demande d'inscription pour le tournoi <span className="text-primary font-bold">{tourney.title}</span> a bien été envoyée. Attendez la validation de l'administration.
            </p>
            <NeonButton 
              variant="violet"
              className="w-full py-4 text-xs font-black tracking-widest"
              onClick={() => { setShowRegModal(false); setShowConditions(false); }}
            >
              Fermer
            </NeonButton>
          </div>
        </div>
      )}

      {/* AJOUTÉ : Modale de règlement d'inscription de tournoi payant */}
      {showPayModal && (
        <TournamentRegisterModal 
          tourney={tourney}
          onClose={() => setShowPayModal(false)}
          onConfirm={handleRegister}
          isPending={register.isPending}
        />
      )}

    </div>
  );
}

// --- COMPOSANT PAGE PRINCIPALE ---
export function Tournaments() {
  const { tournaments, addTournament, updateTournament, deleteTournament, isLoading } = useTournaments();
  const { data: metadata } = useUserMetadata();
  const isAdmin = (metadata as any)?.is_admin;

  const [showForm, setShowForm] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [formData, setFormData] = useState({
    title: '', game: '', date: '', status: 'Upcoming', description: '', image_url: '',
    is_paid: false, fee_amount: 0, payment_phone: '+242 06 000 00 00'
  });

  const handleEdit = (t: Tournament) => {
    setFormData({
      ...t,
      date: t.date ? t.date.split('T')[0] : '',
      is_paid: (t as any).is_paid ?? false,
      fee_amount: (t as any).fee_amount ?? 0,
      payment_phone: (t as any).payment_phone ?? '+242 06 000 00 00'
    });
    setEditingId(t.id);
    setShowForm(true);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      if (editingId) {
        await updateTournament.mutateAsync({ ...formData, id: editingId });
        toast.success("Tournoi mis à jour");
      } else {
        await addTournament.mutateAsync(formData);
        toast.success("Tournoi publié");
      }
      setShowForm(false);
      setEditingId(null);
      setFormData({
        title: '', game: '', date: '', status: 'Upcoming', description: '', image_url: '',
        is_paid: false, fee_amount: 0, payment_phone: '+242 06 000 00 00'
      });
    } catch (err) {
      toast.error("Erreur de sauvegarde");
    }
  };

  return (
    <div className="pt-40 pb-24 min-h-screen bg-background text-center relative overflow-hidden animate-fade-in">
       {/* Fond d'écran immersif de la page */}
       <div className="absolute inset-0 z-0 pointer-events-none">
         <div className="absolute inset-0 bg-gradient-to-b from-background/10 via-background/80 to-background z-10" />
         <img 
           src="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1600" 
           className="w-full h-full object-cover opacity-25" 
           alt="tournaments esports backdrop"
         />
       </div>
       <div className="container mx-auto px-4 max-w-7xl relative z-20">
          
          <header className="mb-20 text-center">
             <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full glass border-white/10 mb-6">
                <Trophy className="text-primary" size={14} />
                <span className="text-[10px] uppercase tracking-[0.3em] font-black text-white">Esports Hub Brazzaville</span>
             </div>
             <h1 className="text-6xl md:text-9xl font-black uppercase tracking-tighter text-white leading-none" translate="no">
               Tournois <span className="text-primary italic">& Events</span>
             </h1>
             
             {isAdmin && (
               <button 
                 onClick={() => { setShowForm(!showForm); setEditingId(null); }} 
                 className="mt-12 flex items-center gap-2 mx-auto bg-white text-black px-8 py-4 rounded-full font-black uppercase text-xs hover:bg-primary transition-all shadow-xl"
               >
                 {showForm ? <X size={18}/> : <Plus size={18}/>}
                 {showForm ? "Fermer l'éditeur" : "Créer un événement"}
               </button>
             )}
          </header>

          {/* AJOUTÉ : Panneau de validation des inscriptions aux tournois (Visible uniquement Admin) */}
          {isAdmin && <TournamentRequestsAdmin />}

          {isAdmin && showForm && (
            <div className="mb-20 glass p-10 rounded-[3rem] border-primary/20 text-left animate-fade-in max-w-4xl mx-auto shadow-2xl">
              <h2 className="text-2xl font-black uppercase mb-8 text-primary flex items-center gap-3">
                <ImageIcon size={24}/> {editingId ? 'Modifier les données' : 'Configuration Événement'}
              </h2>
              <form onSubmit={handleSubmit} className="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div className="space-y-2">
                  <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Titre de la compétition</label>
                  <input required className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary transition-all" value={formData.title} onChange={e => setFormData({...formData, title: e.target.value})} />
                </div>
                <div className="space-y-2">
                  <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Jeu / Catégorie</label>
                  <input required className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary transition-all" value={formData.game} onChange={e => setFormData({...formData, game: e.target.value})} />
                </div>
                <div className="space-y-2">
                  <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Date</label>
                  <input required type="date" className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary transition-all text-center" value={formData.date} onChange={e => setFormData({...formData, date: e.target.value})} />
                </div>
                <div className="space-y-2">
                  <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Statut</label>
                  <select className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary transition-all" value={formData.status} onChange={e => setFormData({...formData, status: e.target.value})}>
                    <option value="Upcoming">À Venir</option>
                    <option value="Active">En cours</option>
                    <option value="Finished">Terminé</option>
                  </select>
                </div>
                
                {/* AJOUTÉ : Configuration de paiement de tournoi */}
                <div className="space-y-2 col-span-1 md:col-span-2">
                  <label className="text-[10px] uppercase font-black text-muted-foreground ml-1 text-primary">Type d'entrée</label>
                  <select 
                    className="w-full bg-white/5 border border-primary/20 rounded-2xl p-4 text-white focus:border-primary focus:outline-none"
                    value={formData.is_paid ? 'true' : 'false'}
                    onChange={e => setFormData({...formData, is_paid: e.target.value === 'true', fee_amount: e.target.value === 'true' ? 1000 : 0})}
                  >
                    <option value="false" className="bg-background">Entrée Gratuite (Consensus requis)</option>
                    <option value="true" className="bg-background">Entrée Payante ( validation sous condition de règlement )</option>
                  </select>
                </div>

                {formData.is_paid && (
                  <>
                    <div className="space-y-2 animate-fade-in">
                      <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Frais d'inscription (FCFA)</label>
                      <input 
                        required 
                        type="number" 
                        className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white" 
                        value={formData.fee_amount} 
                        onChange={e => setFormData({...formData, fee_amount: parseInt(e.target.value) || 0})} 
                      />
                    </div>
                    <div className="space-y-2 animate-fade-in">
                      <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">Téléphone de Paiement</label>
                      <input 
                        required 
                        type="text" 
                        className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white" 
                        value={formData.payment_phone || '+242 06 000 00 00'} 
                        onChange={e => setFormData({...formData, payment_phone: e.target.value})} 
                      />
                    </div>
                  </>
                )}

                <div className="space-y-2 col-span-1 md:col-span-2">
                  <label className="text-[10px] uppercase font-black text-muted-foreground ml-1">URL de l'image</label>
                  <input className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary transition-all" placeholder="https://..." value={formData.image_url} onChange={e => setFormData({...formData, image_url: e.target.value})} />
                </div>
                <textarea placeholder="Description..." className="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white col-span-1 md:col-span-2 h-32" value={formData.description} onChange={e => setFormData({...formData, description: e.target.value})} />
                <NeonButton className="col-span-1 md:col-span-2 py-5 text-base font-black" disabled={addTournament.isPending || updateTournament.isPending}>
                  {editingId ? 'METTRE À JOUR' : 'PUBLIER LE TOURNOI'}
                </NeonButton>
              </form>
            </div>
          )}

          {isLoading ? (
            <div className="flex flex-col items-center justify-center py-32 text-primary">
              <Loader2 className="w-16 h-16 animate-spin" />
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
              {tournaments.map((t) => (
                <TournamentCard 
                  key={t.id} 
                  tourney={t} 
                  isAdmin={!!isAdmin} 
                  onDelete={(id) => deleteTournament.mutate(id)} 
                  onEdit={handleEdit} 
                />
              ))}
            </div>
          )}
       </div>
    </div>
  );
}
</file>

