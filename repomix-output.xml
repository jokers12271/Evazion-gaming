<file path="src/components/dashboard/AdminSessionManager.tsx">
import { Play, CheckCircle2, Timer, X, Trash2, Pause } from 'lucide-react' // AJOUTÉ Pause et Trash2
import { useReservations } from '@/hooks/useReservations'
import { supabase } from '@/lib/supabase'
import { LiveCountdown } from './LiveCountdown'
import { toast } from 'react-hot-toast'
import { cn } from '@blinkdotnew/ui'

interface Props {
  reservation: any
}

export function AdminSessionManager({ reservation }: Props) {
  // Extraction des nouvelles fonctions de pause/reprise
  const { updateStatus, deleteReservation, pauseReservation, resumeReservation } = useReservations()

  const handleStart = async () => {
    try {
      const originalDurationMs = new Date(reservation.end_time).getTime() - new Date(reservation.start_time).getTime();
      const newEndTime = new Date(Date.now() + originalDurationMs).toISOString();

      // CORRECTIF BUG : Mise à jour de start_time à l'instant du démarrage réel
      const { error } = await supabase
        .from('reservations')
        .update({ 
          status: 'en cours', 
          started_at: new Date().toISOString(),
          start_time: new Date().toISOString(), // MODIFIÉ : Fixe l'heure de début au clic de lecture
          end_time: newEndTime 
        })
        .eq('id', reservation.id);

      if (error) throw error;
      toast.success("Session démarrée !");
      window.location.reload(); 
    } catch (e) {
      toast.error("Erreur au démarrage");
    }
  }

  const handleStopWithCredit = async () => {
    if (reservation.status !== 'en cours') {
      return toast.error("La session doit être 'en cours' pour calculer un reste.");
    }
    if (!confirm("Arrêter la session et sauvegarder le temps restant en crédit ?")) return
    
    const { error } = await supabase.rpc('stop_session_and_calculate_credit', { 
      res_id: reservation.id 
    })
    
    if (error) toast.error("Erreur technique sur le crédit");
    else {
      toast.success("Crédit temps sauvegardé !");
      window.location.reload();
    }
  }

  const handleComplete = async () => {
    try {
      await updateStatus.mutateAsync({ id: reservation.id, status: 'consommé' });
      toast.success("Session terminée !");
    } catch (e: any) {
      console.error("Erreur de clôture individuelle :", e);
      toast.error(`Erreur : ${e.message || e}`, { position: "bottom-center" }); // MODIFIÉ (Affiche l'erreur exacte)
    }
  }

  return (
    <div className="flex flex-col sm:flex-row items-center gap-4 bg-black/40 p-2 rounded-2xl border border-white/5 shadow-xl">
      
      <div className="min-w-[100px] flex justify-center">
        {reservation.status === 'en cours' ? (
          <LiveCountdown 
            endTime={reservation.end_time} 
            isStarted={true} 
            className="shadow-neon-violet" 
            isPaused={reservation.is_paused}
            pausedRemainingSeconds={reservation.paused_remaining_seconds}
          />
        ) : (
          <span className="text-[9px] font-black text-white/20 uppercase tracking-[0.2em]">Terminal</span>
        )}
      </div>

      <div className="flex gap-2">
        {/* BOUTON 1 : PLAY / REPRENDRE DE PAUSE */}
        {(reservation.status === 'pending' || reservation.status === 'interrompu' || (reservation.status === 'en cours' && reservation.is_paused)) && (
          <button 
            onClick={async () => {
              if (reservation.is_paused) {
                try {
                  await resumeReservation.mutateAsync(reservation.id);
                  toast.success("Session reprise !");
                } catch (e) {
                  toast.error("Erreur de reprise");
                }
              } else {
                handleStart();
              }
            }}
            className="p-3 rounded-full bg-blue-600 text-white hover:scale-110 shadow-lg shadow-blue-500/20 transition-all"
            title={reservation.is_paused ? "Relancer le chronomètre (Play)" : "Démarrer"}
          >
            <Play size={18} fill="currentColor" />
          </button>
        )}

        {/* BOUTON 2 : FINI */}
        {reservation.status === 'en cours' && (
          <button 
            onClick={handleComplete}
            className="p-3 rounded-full bg-green-500 text-black hover:scale-110 shadow-lg shadow-green-500/20"
            title="Terminer (100%)"
          >
            <CheckCircle2 size={18} />
          </button>
        )}

        {/* BOUTON 3 : PAUSE (Jaune) */}
        {reservation.status === 'en cours' && !reservation.is_paused && (
          <button 
            onClick={async () => {
              try {
                await pauseReservation.mutateAsync(reservation.id);
                toast.success("Session mise en pause !");
              } catch (e) {
                toast.error("Erreur de pause");
              }
            }}
            className="p-3 rounded-full bg-yellow-500 text-black hover:scale-110 shadow-lg shadow-yellow-500/20"
            title="Mettre en pause"
          >
            <Pause size={18} fill="currentColor" />
          </button>
        )}

        {/* BOUTON 4 : RESTE (INTERROMPRE) */}
        {reservation.status === 'en cours' && (
          <button 
            onClick={handleStopWithCredit}
            className="p-3 rounded-full bg-orange-500 text-black hover:scale-110 shadow-lg shadow-orange-500/20"
            title="Arrêt partiel (Créditer reste)"
          >
            <Timer size={18} />
          </button>
        )}

        {/* BOUTON 5 : ANNULER / SUPPRIMER */}
        <button 
          onClick={() => {
            if(reservation.status === 'pending') {
              updateStatus.mutate({ id: reservation.id, status: 'annulé' })
            } else {
              if(confirm("Supprimer définitivement cet enregistrement ?")) deleteReservation.mutate(reservation.id)
            }
          }}
          className={cn(
            "p-3 rounded-full transition-all shadow-lg",
            reservation.status === 'pending' ? "bg-red-600 text-white shadow-red-500/20" : "bg-white/5 text-red-500 border border-red-500/20"
          )}
          title={reservation.status === 'pending' ? "Annuler" : "Supprimer de l'historique"}
        >
          {reservation.status === 'pending' ? <X size={18} /> : <Trash2 size={18} />}
        </button>
      </div>
    </div>
  )
}
</file>

<file path="src/components/dashboard/GiftHoursAdmin.tsx">
import { useState } from 'react'
import { useQuery, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { NeonButton } from '@/components/ui/NeonButton'
import { Gift, Loader2 } from 'lucide-react'
import { toast } from 'react-hot-toast'

interface Props {
  boxClass: string
  boxStyle: any
}

export function GiftHoursAdmin({ boxClass, boxStyle }: Props) {
  const queryClient = useQueryClient()
  const [targetUserId, setTargetUserId] = useState('')
  const [hoursToGift, setHoursToGift] = useState<number | ''>('')
  const [isPending, setIsPending] = useState(false)

  // MODIFIÉ : Chargement robuste des joueurs bénéficiaires (gère les colonnes de valeurs NULL)
  const { data: gamers, isLoading } = useQuery({
    queryKey: ['admin_available_gift_gamers'],
    queryFn: async () => {
      // Charger l'ensemble des profils sans filtre SQL restrictif pour éviter les sauts de lignes NULL
      const { data, error } = await supabase
        .from('users_metadata')
        .select('user_id, display_name, is_admin');
      
      if (error) throw error;

      // Filtrer en JS : Exclure uniquement les administrateurs (prend en charge is_admin = true, false ou null)
      return (data || []).filter(g => g.is_admin !== true);
    }
  });

  const handleGiftSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!targetUserId) return toast.error("Sélectionnez un bénéficiaire.", { position: "bottom-center" });
    if (!hoursToGift || hoursToGift <= 0) return toast.error("Montant d'heures invalide.", { position: "bottom-center" });

    const targetGamer = gamers?.find(g => g.user_id === targetUserId);
    if (!confirm(`Offrir ${hoursToGift} heures de crédit de temps à @${targetGamer?.display_name} ?`)) return;

    setIsPending(true);
    try {
      // 1. Récupérer le solde actuel de crédit temps du joueur
      const { data: lp, error: fetchErr } = await supabase
        .from('loyalty_points')
        .select('time_credit_minutes')
        .eq('user_id', targetUserId)
        .maybeSingle();

      if (fetchErr) throw fetchErr;

      const giftedMinutes = Number(hoursToGift) * 60;
      const newCreditMinutes = (lp?.time_credit_minutes || 0) + giftedMinutes;

      // 2. Mettre à jour son crédit de temps en base de données
      const { error: updateErr } = await supabase
        .from('loyalty_points')
        .update({ time_credit_minutes: newCreditMinutes })
        .eq('user_id', targetUserId);

      if (updateErr) throw updateErr;

      // 3. Lui envoyer une notification d'alerte festive
      await supabase.from('notifications').insert([{
        user_id: targetUserId,
        message: `🎁 CADEAU : L'administration vous a offert ${hoursToGift} heure(s) de crédit temps cumulable ! Activez-les depuis votre Espace membre.`
      }]);

      toast.success(`Cadeau de ${hoursToGift}h envoyé avec succès !`, {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid hsl(45, 100%, 50%)', // Néon Or/Jaune
          borderRadius: '1rem',
          boxShadow: '0 0 15px rgba(234, 179, 8, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      });

      setTargetUserId('');
      setHoursToGift('');
      queryClient.invalidateQueries({ queryKey: ['admin_users'] });
      queryClient.invalidateQueries({ queryKey: ['loyalty_points'] });
    } catch (err: any) {
      console.error(err);
      toast.error(`Échec de l'envoi : ${err.message || err}`, { position: "bottom-center" });
    } finally {
      setIsPending(false);
    }
  };

  return (
    <section className={boxClass} style={boxStyle}>
      <div className="flex items-center justify-between mb-6 text-white text-left">
        <h3 className="font-display uppercase tracking-widest text-[10px] text-yellow-500 font-black flex items-center gap-2">
          <Gift size={14} className="text-yellow-500 animate-bounce" />
          Offrir des Heures (Cadeau / Récompense)
        </h3>
      </div>

      {isLoading ? (
        <div className="py-6 flex justify-center"><Loader2 className="animate-spin text-yellow-500" size={20} /></div>
      ) : (
        <form onSubmit={handleGiftSubmit} className="space-y-4 text-left">
          <div className="space-y-1.5">
            <label className="text-[8px] uppercase font-black text-white/40">Bénéficiaire</label>
            <select
              value={targetUserId}
              onChange={e => setTargetUserId(e.target.value)}
              className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-amber-500"
            >
              <option value="" className="bg-background">Sélectionner un joueur...</option>
              {gamers?.map(g => (
                <option key={g.user_id} value={g.user_id} className="bg-background" translate="no">
                  {g.display_name}
                </option>
              ))}
            </select>
          </div>

          <div className="space-y-1.5">
            <label className="text-[8px] uppercase font-black text-white/40">Nombre d'heures à offrir</label>
            <input
              required
              type="number"
              placeholder="Ex: 2 ou 5"
              value={hoursToGift}
              onChange={e => setHoursToGift(e.target.value === '' ? '' : Number(e.target.value))}
              className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-amber-500 focus:ring-0"
            />
          </div>

          <NeonButton
            type="submit"
            variant="orange"
            disabled={isPending}
            className="w-full py-3 text-[10px] font-black flex items-center justify-center gap-2"
            style={{ borderColor: 'rgba(234, 179, 8, 0.4)', color: '#eab308' }}
          >
            <Gift size={12} />
            {isPending ? "ENVOI..." : "OFFRIR LES HEURES"}
          </NeonButton>
        </form>
      )}
    </section>
  )
}
</file>

<file path="src/components/dashboard/LiveCountdown.tsx">
import { useLiveTimer } from '@/hooks/useLiveTimer'
import { Timer, Pause } from 'lucide-react' // MODIFIÉ : Ajout de l'icône de Pause
import { cn } from '@blinkdotnew/ui'

interface LiveCountdownProps {
  endTime: string
  isStarted: boolean
  className?: string
  isPaused?: boolean // AJOUTÉ
  pausedRemainingSeconds?: number // AJOUTÉ
}

export function LiveCountdown({ endTime, isStarted, className, isPaused, pausedRemainingSeconds }: LiveCountdownProps) {
  const { display, isOver } = useLiveTimer(endTime, isStarted)

  if (!isStarted) return null;

  // Calcul du format d'affichage statique si la session est en pause
  let displayValue = display;
  if (isPaused && pausedRemainingSeconds !== undefined && pausedRemainingSeconds !== null) {
    const mins = Math.floor(pausedRemainingSeconds / 60);
    const secs = pausedRemainingSeconds % 60;
    displayValue = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  return (
    <div className={cn(
      "flex items-center gap-2 px-3 py-1 rounded-lg font-black font-display text-lg shadow-lg animate-fade-in",
      isOver ? "bg-red-500 text-white animate-pulse" : (isPaused ? "bg-yellow-500 text-black shadow-yellow-500/20" : "bg-primary text-black"), // Couleur jaune en pause
      className
    )}>
      {isPaused ? <Pause size={18} className="animate-pulse" /> : <Timer size={18} className={isOver ? "animate-spin" : ""} />}
      <span>{isPaused ? `PAUSÉ : ${displayValue}` : (isOver ? "TEMPS ÉCOULÉ" : displayValue)}</span>
    </div>
  )
}
</file>

<file path="src/components/dashboard/ManiTransfer.tsx">
import { useState } from 'react'
import { useQuery } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from '@/hooks/useAuth'
import { useManiTransfer } from '@/hooks/useManiTransfer'
import { NeonButton } from '@/components/ui/NeonButton'
import { Send, Loader2 } from 'lucide-react'
import { toast } from 'react-hot-toast'
import { cn } from '@blinkdotnew/ui'

interface Props {
  boxClass: string
  boxStyle: any
}

export function ManiTransfer({ boxClass, boxStyle }: Props) {
  const { user } = useAuth()
  const { transferMani } = useManiTransfer()
  const [receiverId, setReceiverId] = useState('')
  const [amount, setAmount] = useState<number | ''>('')

  // MODIFIÉ : Chargement robuste des joueurs (prend en charge les valeurs de colonnes NULL)
  const { data: gamers, isLoading } = useQuery({
    queryKey: ['available_transfer_gamers'],
    queryFn: async () => {
      // On récupère l'ensemble des profils sans filtre SQL restrictif
      const { data, error } = await supabase
        .from('users_metadata')
        .select('user_id, display_name, is_admin');
      
      if (error) throw error;

      // Filtrage JS robuste : Exclure soi-même et tout compte marqué Admin (gère is_admin = true, false ou null)
      return (data || []).filter(g => g.user_id !== user?.id && g.is_admin !== true);
    },
    enabled: !!user
  });

  const handleTransferSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!receiverId) return toast.error("Veuillez sélectionner un destinataire.", { position: "bottom-center" });
    if (!amount || amount <= 0) return toast.error("Veuillez saisir un montant de MANI valide.", { position: "bottom-center" });

    const targetGamer = gamers?.find(g => g.user_id === receiverId);
    if (!confirm(`Confirmer le transfert de ${amount} MANI à @${targetGamer?.display_name} ?`)) return;

    try {
      await transferMani.mutateAsync({ receiverId, amount: Number(amount) });
      toast.success(`Transfert de ${amount} MANI effectué !`, {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid hsl(180, 100%, 50%)', // Bordure Néon Cyan
          borderRadius: '1rem',
          boxShadow: '0 0 15px hsl(180, 100%, 50%, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      });
      setReceiverId('');
      setAmount('');
    } catch (err: any) {
      console.error(err);
      toast.error(`Échec du transfert : ${err.message || err}`, { position: "bottom-center" });
    }
  };

  return (
    <section className={boxClass} style={boxStyle}>
      <div className="flex items-center justify-between mb-6 text-white text-left">
        <h3 className="font-display uppercase tracking-widest text-[10px] text-muted-foreground font-black flex items-center gap-2">
          <Send size={14} className="text-secondary" />
          Transférer des MANI
        </h3>
      </div>

      {isLoading ? (
        <div className="py-6 flex justify-center"><Loader2 className="animate-spin text-secondary" size={20} /></div>
      ) : (
        <form onSubmit={handleTransferSubmit} className="space-y-4 text-left">
          <div className="space-y-1.5">
            <label className="text-[8px] uppercase font-black text-white/40">Destinataire</label>
            <select
              value={receiverId}
              onChange={e => setReceiverId(e.target.value)}
              className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-secondary"
            >
              <option value="" className="bg-background">Sélectionner un joueur...</option>
              {gamers?.map(g => (
                <option key={g.user_id} value={g.user_id} className="bg-background" translate="no">
                  {g.display_name}
                </option>
              ))}
            </select>
          </div>

          <div className="space-y-1.5">
            <label className="text-[8px] uppercase font-black text-white/40">Montant (MANI)</label>
            <input
              type="number"
              placeholder="Ex: 5"
              value={amount}
              onChange={e => setAmount(e.target.value === '' ? '' : Number(e.target.value))}
              className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-secondary focus:ring-0"
            />
          </div>

          <NeonButton
            type="submit"
            variant="cyan"
            disabled={transferMani.isPending}
            className="w-full py-3 text-[10px] font-black flex items-center justify-center gap-2"
          >
            <Send size={12} />
            {transferMani.isPending ? "TRANSFERT EN COURS..." : "ENVOYER LES JETONS"}
          </NeonButton>
        </form>
      )}
    </section>
  )
}
</file>

<file path="src/components/dashboard/RagnarokAdmin.tsx">
import { useQuery } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useResolveChallenge } from '@/hooks/useRagnarok'
import { Swords, Loader2, Trophy, Award } from 'lucide-react'
import { toast } from 'react-hot-toast'
import { format } from 'date-fns'
import { fr } from 'date-fns/locale'

interface Props {
  boxClass: string
  boxStyle: any
}

export function RagnarokAdmin({ boxClass, boxStyle }: Props) {
  const resolveChallenge = useResolveChallenge()

  // Charger tous les défis acceptés de la salle de jeux (status = 'active')
  const { data: activeChallenges, isLoading } = useQuery({
    queryKey: ['all_active_challenges'],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('ragnarok_challenges')
        .select(`
          *,
          challenger_metadata:challenger_id ( display_name ),
          challenged_metadata:challenged_id ( display_name )
        `)
        .eq('status', 'active')
        .order('created_at', { ascending: true })

      if (error) throw error
      return data || []
    }
  })

  const handleDeclareWinner = async (challengeId: string, winnerId: string, winnerName: string) => {
    if (!confirm(`Déclarer @${winnerName} vainqueur de ce duel Ragnarok ? Les mises seront appliquées et transférées.`)) return;

    try {
      await resolveChallenge.mutateAsync({ challengeId, winnerId })
      toast.success(`Victoire de @${winnerName} validée !`, {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid hsl(30, 100%, 50%)', // Néon Orange
          borderRadius: '1rem',
          boxShadow: '0 0 15px rgba(249, 115, 22, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      })
    } catch (err) {
      toast.error("Erreur technique de validation", { position: "bottom-center" })
    }
  }

  if (!activeChallenges || activeChallenges.length === 0) return null

  return (
    <section className={boxClass} style={boxStyle}>
      <h3 className="text-xl font-display font-black uppercase mb-6 text-accent flex items-center gap-3">
        <Swords size={22} className="text-accent animate-pulse" />
        Défis Ragnarok en cours ({activeChallenges.length})
      </h3>

      {isLoading ? (
        <div className="py-6 flex justify-center"><Loader2 className="animate-spin text-accent" size={24} /></div>
      ) : (
        <div className="space-y-6">
          {activeChallenges.map((challenge: any) => {
            const cName = challenge.challenger_metadata?.display_name;
            const dName = challenge.challenged_metadata?.display_name;

            return (
              <div key={challenge.id} className="p-5 rounded-3xl bg-white/5 border border-white/5 flex flex-col gap-4 text-white">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/5 pb-3">
                  <div>
                    <p className="text-sm font-black uppercase tracking-widest text-glow-orange text-accent">
                      @ {cName} vs @ {dName}
                    </p>
                    <span className="text-[9px] font-black uppercase tracking-wider text-white/30">
                      Du : {format(new Date(challenge.scheduled_at), 'dd MMMM yyyy à HH:mm', { locale: fr })}
                    </span>
                  </div>
                  <span className="text-[9px] font-black uppercase px-3 py-1 rounded-lg bg-orange-500/10 text-orange-500 border border-orange-500/20 animate-pulse shrink-0">
                    FIGHT ACTIVE
                  </span>
                </div>

                {/* Détail des mises asymétriques */}
                <div className="grid grid-cols-2 gap-4 text-center text-[10px] font-bold uppercase tracking-tight p-3 bg-black/40 rounded-2xl border border-white/5">
                  <div>
                    <span className="text-white/40 block mb-1">Mise @{cName}</span>
                    <span className="text-white text-xs font-black">{challenge.amount} {challenge.currency_type}</span>
                  </div>
                  <div>
                    <span className="text-white/40 block mb-1">Mise @{dName} (50%)</span>
                    <span className="text-white text-xs font-black">{challenge.challenged_wager} {challenge.currency_type}</span>
                  </div>
                </div>

                {/* Saisie du vainqueur */}
                <div className="space-y-2 pt-2">
                  <p className="text-[9px] font-black uppercase text-white/40 tracking-wider">Désigner le vainqueur physique :</p>
                  <div className="flex gap-3">
                    <button
                      onClick={() => handleDeclareWinner(challenge.id, challenge.challenger_id, cName)}
                      disabled={resolveChallenge.isPending}
                      className="flex-1 py-3 bg-primary hover:bg-primary/80 text-white rounded-2xl text-[9px] font-black uppercase tracking-widest transition-all flex items-center justify-center gap-2 border border-primary/40 shadow-neon-violet"
                    >
                      <Trophy size={12} />
                      @{cName} Gagne
                    </button>
                    <button
                      onClick={() => handleDeclareWinner(challenge.id, challenge.challenged_id, dName)}
                      disabled={resolveChallenge.isPending}
                      className="flex-1 py-3 bg-secondary hover:bg-secondary/80 text-black rounded-2xl text-[9px] font-black uppercase tracking-widest transition-all flex items-center justify-center gap-2 border border-secondary/40 shadow-neon-cyan"
                    >
                      <Award size={12} />
                      @{dName} Gagne
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>
  )
}
</file>

<file path="src/components/dashboard/RagnarokChallenge.tsx">
import { useState } from 'react'
import { useQuery } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from '@/hooks/useAuth'
import { useUserMetadata } from '@/hooks/useUserMetadata'
import { useRagnarok } from '@/hooks/useRagnarok'
import { NeonButton } from '@/components/ui/NeonButton'
import { Swords, Loader2 } from 'lucide-react'
import { toast } from 'react-hot-toast'
import { cn } from '@blinkdotnew/ui'
import { format } from 'date-fns'
import { fr } from 'date-fns/locale'

interface Props {
  boxClass: string
  boxStyle: any
}

import { useMyMembershipRequests } from '@/hooks/useTeamMembership' // AJOUTÉ

export function RagnarokChallenge({ boxClass, boxStyle }: Props) {
  const { user } = useAuth()
  const { data: metadata } = useUserMetadata()
  const { myChallenges, createChallenge, respondToChallenge } = useRagnarok()

  // Charger toutes mes teams d'équipes approuvées en direct
  const { data: myMembershipRequests } = useMyMembershipRequests() // AJOUTÉ
  const approvedTeams = myMembershipRequests?.filter(r => r.status === 'approved').map(r => r.team_id) || [];
  const hasTeams = approvedTeams.length > 0;

  const [showForm, setShowForm] = useState(false)
  const [challengedId, setChallengedId] = useState('')
  const [currencyType, setCurrencyType] = useState<'MANI' | 'Hours'>('MANI')
  const [amount, setAmount] = useState<number | ''>('')
  const [scheduleDate, setScheduledDate] = useState(new Date().toISOString().split('T')[0])
  const [scheduleTime, setScheduledTime] = useState('15:00')
  const [selectedDuelTeam, setSelectedDuelTeam] = useState('') // AJOUTÉ : Team choisie pour le défi

  // Forcer la sélection automatique de la première équipe disponible s'il n'y a pas encore de choix
  const activeDuelTeam = selectedDuelTeam || approvedTeams[0] || '';

  // MODIFIÉ : Charge les adversaires de la Team choisie pour l'arène de duel
  const { data: teamMembers, isLoading: membersLoading } = useQuery({
    queryKey: ['team_opponents', activeDuelTeam],
    queryFn: async () => {
      if (!activeDuelTeam) return []
      const { data, error } = await supabase
        .from('users_metadata')
        .select('user_id, display_name, is_admin, team_membership_requests!inner(team_id, status)')
        .eq('team_membership_requests.team_id', activeDuelTeam)
        .eq('team_membership_requests.status', 'approved')
        .eq('is_admin', false);
      if (error) throw error;
      return (data || []).filter(g => g.user_id !== user?.id);
    },
    enabled: !!user && !!activeDuelTeam
  })

  const handleChallengeSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!hasTeams) return toast.error("Vous devez rejoindre une Team avant de pouvoir lancer des défis.", { position: "bottom-center" })
    if (!challengedId) return toast.error("Sélectionnez un adversaire éligible.", { position: "bottom-center" })
    if (!amount || amount <= 0) return toast.error("Montant de mise invalide.", { position: "bottom-center" })

    const scheduledAt = new Date(`${scheduleDate}T${scheduleTime}`).toISOString()

    try {
      await createChallenge.mutateAsync({
        challengedId,
        currencyType,
        amount: Number(amount),
        scheduledAt
      })
      toast.success("Défi Ragnarok lancé avec succès !", {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid hsl(30, 100%, 50%)', // Néon Orange
          borderRadius: '1rem',
          boxShadow: '0 0 15px rgba(249, 115, 22, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      })
      setChallengedId('')
      setAmount('')
      setShowForm(false)
    } catch (err: any) {
      console.error(err)
      toast.error(`Échec du duel : ${err.message || err}`, { position: "bottom-center" });
    }
  }

  if (!hasTeams) {
    return (
      <section className={boxClass} style={boxStyle}>
        <div className="flex items-center gap-2 mb-4 text-left text-white">
          <Swords size={14} className="text-muted-foreground" />
          <h3 className="font-display uppercase tracking-widest text-[10px] text-muted-foreground font-black">Ragnarok Duel</h3>
        </div>
        <p className="text-[10px] italic text-left text-white/20 uppercase tracking-widest leading-relaxed">
          🔒 Rejoignez au moins une Team validée dans l'onglet Communauté pour débloquer l'arène des défis Ragnarok.
        </p>
      </section>
    )
  }

  return (
    <section className={boxClass} style={boxStyle}>
      <div className="flex items-center justify-between mb-6 text-white text-left">
        <h3 className="font-display uppercase tracking-widest text-[10px] text-muted-foreground font-black flex items-center gap-2">
          <Swords size={14} className="text-accent animate-pulse" />
          Arène Ragnarok (PVP)
        </h3>
        <button 
          onClick={() => setShowForm(!showForm)}
          className="text-[9px] font-black uppercase text-accent tracking-widest hover:underline focus:outline-none"
        >
          {showForm ? "Fermer" : "Lancer un Défi"}
        </button>
      </div>

      {/* LISTE DES DEFIS EN COURS */}
      {!showForm ? (
        <div className="space-y-4 max-h-[300px] overflow-y-auto pr-1 custom-scrollbar text-left text-white">
          {myChallenges.isLoading ? (
            <div className="py-6 flex justify-center"><Loader2 className="animate-spin text-accent" size={20} /></div>
          ) : myChallenges.data && myChallenges.data.length > 0 ? (
            myChallenges.data.map((challenge) => {
              const isChallenger = challenge.challenger_id === user?.id;
              const opponentName = isChallenger 
                ? challenge.challenged_metadata?.display_name 
                : challenge.challenger_metadata?.display_name;

              return (
                <div key={challenge.id} className="p-4 rounded-2xl bg-white/5 border border-white/5 hover:border-accent/30 transition-all flex flex-col gap-3">
                  <div className="flex items-center justify-between gap-3 border-b border-white/5 pb-2">
                    <div>
                      <p className="text-xs font-bold uppercase tracking-wider" translate="no">
                        {isChallenger ? `Défi contre @${opponentName}` : `Proposé par @${opponentName}`}
                      </p>
                      <span className="text-[8px] font-black uppercase tracking-wider text-white/30">
                        Le {format(new Date(challenge.scheduled_at), 'dd/MM à HH:mm', { locale: fr })}
                      </span>
                    </div>
                    <span className={cn(
                      "text-[8px] font-black uppercase px-2.5 py-1 rounded-full border",
                      challenge.status === 'active' ? "bg-green-500/10 text-green-500 border-green-500/20" : "bg-accent/10 text-accent border-accent/20"
                    )}>
                      {challenge.status === 'active' ? 'Fight !' : 'Attente'}
                    </span>
                  </div>

                  <div className="flex justify-between items-center text-[10px] font-bold uppercase tracking-tight">
                    <span className="text-white/40">Mise en jeu</span>
                    <span className="text-accent text-glow-orange font-black">
                      {isChallenger ? `${challenge.amount}` : `${challenge.challenged_wager}`} {challenge.currency_type}
                    </span>
                  </div>

                  {/* Actions de consensus (Fight ou Fuir) pour l'adversaire défié */}
                  {!isChallenger && challenge.status === 'pending' && (
                    <div className="flex gap-2 pt-2 border-t border-white/5">
                      <button
                        onClick={() => respondToChallenge.mutate({ challengeId: challenge.id, action: 'Fight' })}
                        disabled={respondToChallenge.isPending}
                        className="flex-1 py-2 bg-green-500 hover:bg-green-600 text-black rounded-xl text-[10px] font-black uppercase tracking-widest transition-all shadow-lg shadow-green-500/10"
                      >
                        FIGHT !
                      </button>
                      <button
                        onClick={() => respondToChallenge.mutate({ challengeId: challenge.id, action: 'Fuir' })}
                        disabled={respondToChallenge.isPending}
                        className="flex-1 py-2 bg-red-500 hover:bg-red-600 text-white rounded-xl text-[10px] font-black uppercase tracking-widest transition-all"
                      >
                        FUIR
                      </button>
                    </div>
                  )}
                </div>
              );
            })
          ) : (
            <p className="text-[10px] italic text-center text-white/25 uppercase tracking-widest py-8 leading-relaxed">
              L'arène est calme... <br />Lancez un défi à un membre de votre Team !
            </p>
          )}
        </div>
      ) : (
        /* FORMULAIRE DE CRÉATION DE DÉFI */
        <form onSubmit={handleChallengeSubmit} className="space-y-4 text-left text-white animate-fade-in">
                
                {/* AJOUTÉ : Choix de la Team pour le défi (S'affiche si membre de plusieurs Teams) */}
                <div className="space-y-1.5">
                  <label className="text-[8px] uppercase font-black text-white/40 font-black">Choisir la Team du Duel</label>
                  <select
                    value={activeDuelTeam}
                    onChange={e => { setSelectedDuelTeam(e.target.value); setChallengedId(''); }}
                    className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none"
                  >
                    {approvedTeams.map(tId => (
                      <option key={tId} value={tId} className="bg-background">Team - {tId}</option>
                    ))}
                  </select>
                </div>

                <div className="space-y-1.5">
                  <label className="text-[8px] uppercase font-black text-white/40">Adversaire éligible</label>
            {membersLoading ? (
              <div className="flex justify-center py-2"><Loader2 className="animate-spin text-accent" size={16} /></div>
            ) : (
              <select
                required
                value={challengedId}
                onChange={e => setChallengedId(e.target.value)}
                className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-accent"
              >
                <option value="" className="bg-background">Sélectionner un rival...</option>
                {teamMembers?.map(g => (
                  <option key={g.user_id} value={g.user_id} className="bg-background" translate="no">
                    {g.display_name}
                  </option>
                ))}
              </select>
            )}
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div className="space-y-1.5">
              <label className="text-[8px] uppercase font-black text-white/40">Enjeu</label>
              <select
                value={currencyType}
                onChange={e => setCurrencyType(e.target.value as 'MANI' | 'Hours')}
                className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none"
              >
                <option value="MANI" className="bg-background">Jetons MANI</option>
                <option value="Hours" className="bg-background">Heures de Rang</option>
              </select>
            </div>

            <div className="space-y-1.5">
              <label className="text-[8px] uppercase font-black text-white/40">Montant</label>
              <input
                required
                type="number"
                placeholder="Ex: 10"
                value={amount}
                onChange={e => setAmount(e.target.value === '' ? '' : Number(e.target.value))}
                className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-accent"
              />
            </div>
          </div>

          <div className="grid grid-cols-2 gap-4 border-t border-white/5 pt-4">
            <div className="space-y-1.5">
              <label className="text-[8px] uppercase font-black text-white/40">Date</label>
              <input
                required
                type="date"
                value={scheduleDate}
                onChange={e => setScheduledDate(e.target.value)}
                className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-accent text-center font-bold"
              />
            </div>

            <div className="space-y-1.5">
              <label className="text-[8px] uppercase font-black text-white/40">Heure</label>
              <input
                required
                type="time"
                value={scheduleTime}
                onChange={e => setScheduledTime(e.target.value)}
                className="w-full bg-white/5 border border-white/10 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-accent text-center font-bold"
              />
            </div>
          </div>

          <div className="border-t border-white/5 pt-4">
            <NeonButton
              type="submit"
