        <div className="space-y-4">
          {currentPrivileges.map((priv) => {
            const claimRecord = myClaims.data?.find((c: any) => c.privilege_key === priv.key)
            const isApproved = claimRecord?.status === 'approved'
            const isPending = claimRecord?.status === 'pending'

            return (
              <div 
                key={priv.key}
                className="p-4 rounded-2xl bg-white/[0.02] border border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
              >
                <div>
                  <div className="flex items-center gap-3">
                    <input 
                      type="checkbox"
                      checked={isApproved}
                      disabled
                      className="w-4 h-4 rounded border-white/10 text-secondary focus:ring-0 cursor-not-allowed"
                    />
                    <span className={`text-xs font-bold ${isApproved ? "line-through opacity-40 text-green-500" : "text-white"}`}>
                      {priv.label}
                    </span>
                  </div>
                  <p className="text-[10px] text-muted-foreground mt-1 ml-7">{priv.desc}</p>
                </div>

                <div className="shrink-0 flex items-center gap-2 pl-7 sm:pl-0">
                  {priv.type === 'manual' ? (
                    isApproved ? (
                      <span className="text-[8px] font-black uppercase px-2.5 py-1 rounded bg-green-500/10 text-green-500 border border-green-500/20">
                        Consommé à vie
                      </span>
                    ) : isPending ? (
                      <span className="text-[8px] font-black uppercase px-2.5 py-1 rounded bg-yellow-500/10 text-yellow-500 border border-yellow-500/20 animate-pulse">
                        En attente
                      </span>
                    ) : (
                      <button
                        onClick={() => handleClaimSubmit(priv.key, priv.label)}
                        className="px-3 py-1.5 bg-secondary text-black hover:bg-secondary/80 rounded-xl text-[9px] font-black uppercase tracking-wider transition-colors"
                      >
                        Consommer
                      </button>
                    )
                  ) : (
                    <span className="text-[8px] font-black uppercase px-2.5 py-1 rounded bg-white/5 text-white/40 border border-white/5">
                      Automatique
                    </span>
                  )}
                </div>
              </div>
            )
          })}
        </div>
      )}
    </section>
  )
}
</file>

<file path="src/components/dashboard/GiftHoursHistory.tsx">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { Gift, Trash2, Loader2 } from 'lucide-react'
import { toast } from 'react-hot-toast'
import { format } from 'date-fns'
import { fr } from 'date-fns/locale'

interface Props {
  boxClass: string
  boxStyle: any
}

export function GiftHoursHistory({ boxClass, boxStyle }: Props) {
  const queryClient = useQueryClient()

  // Charger en temps réel l'historique des crédits d'heures offertes
  const { data: logs, isLoading: logsLoading } = useQuery({
    queryKey: ['gift_hours_logs'],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('gift_hours_logs')
        .select('*, users_metadata:user_id(display_name)')
        .order('created_at', { ascending: false });
      if (error) throw error;
      return data || [];
    }
  });

  // Mutation pour supprimer définitivement une ligne d'historique
  const deleteLogMutation = useMutation({
    mutationFn: async (logId: string) => {
      const { error } = await supabase
        .from('gift_hours_logs')
        .delete()
        .eq('id', logId);
      if (error) throw error;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['gift_hours_logs'] });
      toast.success("Ligne d'historique effacée avec succès !");
    }
  });

  return (
    <section className={boxClass} style={boxStyle}>
      <div className="flex items-center gap-4 mb-12 border-b border-white/5 pb-8 text-white text-left">
        <Gift className="text-yellow-500 animate-bounce" size={28} />
        <h2 className="text-3xl font-display uppercase tracking-wider">Historique des Crédits Offerts</h2>
      </div>

      {logsLoading ? (
        <div className="py-12 flex justify-center"><Loader2 className="animate-spin text-yellow-500" size={32} /></div>
      ) : logs && logs.length > 0 ? (
        <div className="space-y-4 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar text-left text-white">
          {logs.map((log: any) => (
            <div key={log.id} className="p-5 rounded-[2rem] bg-white/5 border border-white/5 flex items-center justify-between gap-6 hover:border-yellow-500/20 transition-all duration-300">
              <div>
                <p className="font-bold text-sm">Vous avez offert <span className="text-yellow-500 font-black">{(log.hours * 60)} minutes</span></p>
                <div className="flex items-center gap-4 mt-1.5 text-[10px] text-white/30 font-black uppercase tracking-wider">
                  <span translate="no">Bénéficiaire : @{log.users_metadata?.display_name}</span>
                  <span>•</span>
                  <span>Le {format(new Date(log.created_at), 'dd/MM à HH:mm', { locale: fr })}</span>
                </div>
              </div>
              <button 
                onClick={() => {
                  if (confirm("Voulez-vous supprimer définitivement cette ligne d'historique de la base de données ?")) {
                    deleteLogMutation.mutate(log.id);
                  }
                }}
                className="p-3 bg-red-500/10 text-red-500 rounded-xl hover:bg-red-500 hover:text-white border border-red-500/20 transition-all shrink-0 shadow-lg"
                title="Supprimer"
              >
                <Trash2 size={16} />
              </button>
            </div>
          ))}
        </div>
      ) : (
        <p className="text-xs italic text-center text-white/20 uppercase tracking-widest py-8">Aucun historique de cadeaux disponible</p>
      )}
    </section>
  )
}
</file>

<file path="src/components/dashboard/ManiTransferHistory.tsx">
import { useQuery } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from '@/hooks/useAuth'
import { Send, ArrowDownLeft, ArrowUpRight, Loader2 } from 'lucide-react'
import { format } from 'date-fns'
import { fr } from 'date-fns/locale'

interface Props {
  boxClass: string
  boxStyle: any
}

export function ManiTransferHistory({ boxClass, boxStyle }: Props) {
  const { user } = useAuth()

  // Charger en direct l'historique des transferts (Masquage de 48 heures pour le joueur)
  const { data: transfers, isLoading } = useQuery({
    queryKey: ['my_mani_transfers', user?.id],
    queryFn: async () => {
      if (!user) return []

      const { data, error } = await supabase
        .from('mani_transfers')
        .select(`
          *,
          sender:sender_id ( display_name ),
          receiver:receiver_id ( display_name )
        `)
        .or(`sender_id.eq.${user.id},receiver_id.eq.${user.id}`)
        .order('created_at', { ascending: false })

      if (error) throw error

      // Appliquer la barrière de 48 heures pour l'historique de transfert
      const now = new Date();
      const fortyEightHoursAgo = new Date(now.getTime() - 48 * 60 * 60 * 1000);

      return (data || []).filter((tx: any) => {
        const createdAt = new Date(tx.created_at);
        return createdAt >= fortyEightHoursAgo;
      });
    },
    enabled: !!user
  })

  return (
    <section className={boxClass} style={boxStyle}>
      <div className="flex items-center justify-between mb-6 text-white text-left">
        <h3 className="font-display uppercase tracking-widest text-[10px] text-muted-foreground font-black flex items-center gap-2">
          <Send size={14} className="text-secondary" />
          Historique des Transferts
        </h3>
      </div>

      {isLoading ? (
        <div className="py-6 flex justify-center"><Loader2 className="animate-spin text-secondary" size={20} /></div>
      ) : transfers && transfers.length > 0 ? (
        <div className="space-y-3 max-h-[180px] overflow-y-auto pr-1 custom-scrollbar text-left text-white">
          {transfers.map((tx: any) => {
            const isSender = tx.sender_id === user?.id;
            const partnerName = isSender ? tx.receiver?.display_name : tx.sender?.display_name;

            return (
              <div key={tx.id} className="p-3.5 rounded-2xl bg-white/5 border border-white/5 flex items-center justify-between gap-4 text-white hover:border-secondary/20 transition-all duration-300 animate-fade-in">
                <div className="flex items-center gap-3">
                  {/* Icône de flux de transfert colorée (Vert = Reçu, Rouge = Envoyé) */}
                  <div className={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 border ${isSender ? 'bg-red-500/10 text-red-500 border-red-500/20' : 'bg-green-500/10 text-green-500 border-green-500/20'}`}>
                    {isSender ? <ArrowUpRight size={14} /> : <ArrowDownLeft size={14} />}
                  </div>
                  <div>
                    <p className="text-xs font-bold">
                      {isSender ? `Envoyé à @${partnerName}` : `Reçu de @${partnerName}`}
                    </p>
                    <span className="text-[8px] font-black uppercase tracking-wider text-white/30">
                      Le {format(new Date(tx.created_at), 'dd/MM à HH:mm', { locale: fr })}
                    </span>
                  </div>
                </div>
                <span className={`text-sm font-black ${isSender ? 'text-red-500' : 'text-green-500'}`}>
                  {isSender ? '-' : '+'}{tx.amount} M
                </span>
              </div>
            )
          })}
        </div>
      ) : (
        <p className="text-[9px] italic text-center text-white/20 uppercase tracking-widest py-6">Aucun transfert effectué</p>
      )}
    </section>
  )
}
</file>

