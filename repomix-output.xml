            />
            <input
              type="text"
              placeholder="Pseudo Joueur 2"
              value={p2}
              onChange={e => setP2(e.target.value)}
              className="bg-white/5 border border-white/10 rounded-xl p-3 text-xs text-white"
            />
            <input
              type="text"
              placeholder="Pseudo Vainqueur"
              value={winner}
              onChange={e => setWinner(e.target.value)}
              className="bg-white/5 border border-white/10 rounded-xl p-3 text-xs text-white"
            />
