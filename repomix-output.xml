import { useState } from 'react'
import { useTeamLeaderboard } from '@/hooks/useCommunityStats'
import { Trophy, Star, Loader2 } from 'lucide-react'
import { cn } from '@blinkdotnew/ui'
import { format } from 'date-fns'
