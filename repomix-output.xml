                <div>
                  <div className="text-[10px] font-mono uppercase tracking-wider text-secondary mb-1">
                    {evt.date_str} · {evt.time_str}
                  </div>
                  <h4 className="text-base font-black uppercase text-white leading-tight mb-2">
                    {evt.title}
                  </h4>
                  <p className="text-xs text-white/70 font-sans mb-4 line-clamp-3">
                    {evt.description}
                  </p>

                  <div className="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-[10px] font-mono text-amber-300 mb-4 flex items-center gap-1.5">
                    <Trophy size={13} className="shrink-0" />
                    <span>{evt.reward_text}</span>
                  </div>
                </div>

                <button
                  type="button"
                  onClick={() => handleToggleAttendance(evt.id)}
                  className={`w-full py-2.5 rounded-xl border text-[10px] font-mono uppercase font-black cursor-pointer transition-all flex items-center justify-center gap-2 ${
                    evt.user_is_registered
                      ? 'bg-emerald-500/20 border-emerald-500 text-emerald-300 shadow-[0_0_15px_rgba(16,185,129,0.3)]'
                      : 'bg-white/5 hover:bg-white/10 border-white/20 text-white'
                  }`}
                >
                  {evt.user_is_registered ? (
                    <>
                      <CheckCircle2 size={14} className="text-emerald-400" /> Présence Confirmée
                    </>
                  ) : (
                    'Confirmer ma Présence'
                  )}
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/community/CreateTeamModal.tsx">
import React, { useState } from 'react';
import { X, Shield, Sparkles } from 'lucide-react';
import { CyberCard } from '@/components/ui/CyberCard';
import { NeonButton } from '@/components/ui/NeonButton';
import { supabase } from '@/lib/supabase';
import { toast } from 'react-hot-toast';

interface CreateTeamModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess: () => void;
}

export function CreateTeamModal({ isOpen, onClose, onSuccess }: CreateTeamModalProps) {
  const [name, setName] = useState('');
  const [tagline, setTagline] = useState('');
  const [color, setColor] = useState('#06b6d4');
  const [image, setImage] = useState('https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=800');
  const [joinFee, setJoinFee] = useState(5000);
  const [monthlyFee, setMonthlyFee] = useState(2000);
  const [loading, setLoading] = useState(false);

  if (!isOpen) return null;

  const colorOptions = [
    { label: 'Cyan Néon', value: '#06b6d4' },
    { label: 'Violet Sanctuary', value: '#a855f7' },
    { label: 'Or Ragnarök', value: '#eab308' },
    { label: 'Vert Brazza', value: '#10b981' },
    { label: 'Rouge Fatal', value: '#ef4444' },
    { label: 'Orange Sunset', value: '#f97316' }
  ];

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name.trim()) return;

    setLoading(true);
    try {
      const id = name.trim().toLowerCase().replace(/\s+/g, '_');
      const { error: teamErr } = await supabase.from('teams').insert([{
        id,
        name: name.toUpperCase().trim(),
        tagline: tagline.trim(),
        color,
        image
      }]);
      if (teamErr) throw teamErr;

      await supabase.from('team_configs').insert([{
        team_id: id,
        join_fee: Number(joinFee),
        monthly_fee: Number(monthlyFee),
        payment_phone: '+242 06 612 34 56'
      }]);

      toast.success(`Team ${name.toUpperCase()} créée avec succès !`);
      onSuccess();
      onClose();
    } catch (err: any) {
      toast.error(err.message || "Erreur lors de la création de la team");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="fixed inset-0 z-[9999] bg-black/85 backdrop-blur-md flex items-center justify-center p-4 animate-fade-in font-display">
      <CyberCard variant="cyan" hoverEffect={false} className="w-full max-w-lg p-6 md:p-8 relative text-left">
        <button
          onClick={onClose}
          className="absolute top-5 right-5 text-white/50 hover:text-white"
        >
          <X size={18} />
        </button>

        <div className="flex items-center gap-2 mb-2">
          <Shield size={18} className="text-secondary" />
          <span className="text-[10px] font-mono uppercase text-secondary font-black tracking-widest">
            Administration des Clans
          </span>
        </div>

        <h3 className="text-2xl font-black uppercase text-white mb-5">
          Créer une Nouvelle Team Officielle
        </h3>

        <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Nom de la Team</label>
            <input
              required
              type="text"
              placeholder="Ex: APEX PREDATORS"
              value={name}
              onChange={(e) => setName(e.target.value)}
              className="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-secondary uppercase font-bold"
            />
          </div>

          <div>
            <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Devise ou Cri de ralliement</label>
            <input
              type="text"
              placeholder="Ex: Les maîtres de la vitesse et de la précision."
              value={tagline}
              onChange={(e) => setTagline(e.target.value)}
              className="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-secondary font-sans"
            />
          </div>

          <div>
            <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Couleur Néon du Clan</label>
            <div className="flex flex-wrap gap-2">
              {colorOptions.map((c) => (
                <button
                  type="button"
                  key={c.value}
                  onClick={() => setColor(c.value)}
                  className={`px-3 py-1.5 rounded-xl border text-[10px] font-mono uppercase flex items-center gap-2 cursor-pointer transition-all ${
                    color === c.value
                      ? 'border-white bg-white/20 text-white shadow-md'
                      : 'border-white/10 bg-white/5 text-white/60'
                  }`}
                >
                  <span className="w-3 h-3 rounded-full" style={{ backgroundColor: c.value }} />
                  {c.label}
                </button>
              ))}
            </div>
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div>
              <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Frais d'Adhésion (FCFA)</label>
              <input
                type="number"
                value={joinFee}
                onChange={(e) => setJoinFee(Number(e.target.value))}
                className="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-secondary font-mono"
              />
            </div>
            <div>
              <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Cotisation Mensuelle (FCFA)</label>
              <input
                type="number"
                value={monthlyFee}
                onChange={(e) => setMonthlyFee(Number(e.target.value))}
                className="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-secondary font-mono"
              />
            </div>
          </div>

          <div className="flex gap-3 pt-3">
            <NeonButton type="button" variant="ghost" onClick={onClose} className="flex-1 py-3 text-xs">
              Annuler
            </NeonButton>
            <NeonButton type="submit" variant="violet" sweep disabled={loading} className="flex-1 py-3 text-xs">
              {loading ? "Création..." : "Enregistrer la Team"}
            </NeonButton>
          </div>
        </form>
      </CyberCard>
    </div>
  );
}
</file>

<file path="src/components/community/FaceToFaceArena.tsx">
import React, { useState } from 'react';
import { Swords, Trophy, Flame, Plus, Shield, Check, Clock, Coins, User } from 'lucide-react';
import { NeonButton } from '@/components/ui/NeonButton';
import { toast } from 'react-hot-toast';
import { cyberAudio } from '@/lib/cyberAudio';
import { useAuth } from '@/hooks/useAuth';

export interface Challenge {
  id: string;
  game: string;
  creator: string;
  creatorRank: string;
  stake: string; // e.g. "1 MANI", "Pour l'Honneur", "2 MANI"
  time: string;
  format: string; // e.g. "10 min match", "First to 5"
  status: 'open' | 'accepted' | 'completed';
  opponent?: string;
}

const INITIAL_CHALLENGES: Challenge[] = [
  {
    id: 'ch-1',
    game: 'EA Sports FC 24',
    creator: 'Darius_Brazza',
    creatorRank: 'Élite',
    stake: '1 MANI',
    time: 'Aujourd\'hui 17:30',
    format: 'Match Classique 10 min · Real Madrid vs All',
    status: 'open'
  },
  {
    id: 'ch-2',
    game: 'Tekken 8',
    creator: 'Kazuya_Mikalou',
    creatorRank: 'Pro',
    stake: 'Pour l\'Honneur',
    time: 'Aujourd\'hui 18:15',
    format: 'First to 5 (FT5) · Sans handicap',
    status: 'open'
  },
  {
    id: 'ch-3',
    game: 'Mortal Kombat 1',
    creator: 'Cyborg_Maya',
    creatorRank: 'Légende',
    stake: '2 MANI',
    time: 'Ce soir 20:00',
    format: 'Best of 3 · Arène Tournoi',
    status: 'open'
  }
];

export function FaceToFaceArena() {
  const { user } = useAuth();
  const [challenges, setChallenges] = useState<Challenge[]>(INITIAL_CHALLENGES);
  const [showModal, setShowModal] = useState(false);
  const [form, setForm] = useState({
    game: 'EA Sports FC 24',
    format: 'Match standard 10 min',
    stake: '1 MANI',
    time: 'Aujourd\'hui 18:00'
  });

  const handleAccept = (ch: Challenge) => {
    cyberAudio.playSuccess();
    setChallenges((prev) =>
      prev.map((c) =>
        c.id === ch.id
          ? { ...c, status: 'accepted', opponent: user?.user_metadata?.display_name || 'Vous' }
          : c
      )
    );
    toast.success(`⚔️ Défi accepté contre ${ch.creator} sur ${ch.game} ! Rendez-vous au Lounge.`, {
      icon: '🏆',
      position: 'bottom-center'
    });
  };

  const handleCreate = (e: React.FormEvent) => {
    e.preventDefault();
    cyberAudio.playSuccess();

    const newCh: Challenge = {
      id: `ch-${Date.now()}`,
      game: form.game,
      creator: user?.user_metadata?.display_name || 'Gamer_Anonyme',
      creatorRank: 'Amateur',
      stake: form.stake,
      time: form.time,
      format: form.format,
      status: 'open'
    };

    setChallenges([newCh, ...challenges]);
    setShowModal(false);
    toast.success("Votre défi 1v1 est publié dans l'Arène du Sanctuary !", { position: 'bottom-center' });
  };

  return (
    <div className="bg-[#05070c] border border-white/10 rounded-3xl p-6 sm:p-8 backdrop-blur-xl relative overflow-hidden font-display my-10">
      {/* Background Glow */}
      <div className="absolute top-0 right-0 w-80 h-80 bg-primary/10 blur-[100px] pointer-events-none rounded-full" />

      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-white/10 gap-4">
        <div>
          <div className="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-primary mb-1">
            <Swords size={16} />
            <span>Pool de Rivalité & Face-à-Face</span>
          </div>
          <h3 className="text-2xl sm:text-3xl font-black uppercase text-white tracking-tight">
            Arène 1v1 <span className="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Brazzaville</span>
          </h3>
          <p className="text-xs sm:text-sm text-white/60 font-sans mt-1">
            Lancez un duel à un membre du hub ou relevez un défi en direct dans l'arène de tournoi.
          </p>
        </div>

        <button
          onClick={() => {
            setShowModal(true);
            cyberAudio.playClick();
          }}
          className="px-4 py-2.5 rounded-xl bg-gradient-to-r from-primary to-secondary text-white font-black text-xs uppercase tracking-wider hover:opacity-90 transition-all cursor-pointer shadow-neon-violet flex items-center gap-2 self-start sm:self-auto"
        >
          <Plus size={14} />
          <span>Lancer un Défi</span>
        </button>
      </div>

      {/* Challenge Cards Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-6">
        {challenges.map((ch) => {
          const isOpen = ch.status === 'open';

          return (
            <div
              key={ch.id}
              className={`rounded-2xl border p-4.5 flex flex-col justify-between transition-all duration-300 relative ${
                isOpen
                  ? 'border-white/10 bg-white/[0.03] hover:border-secondary/50 hover:bg-white/[0.05]'
                  : 'border-emerald-500/30 bg-emerald-500/5 opacity-80'
              }`}
            >
              <div>
                <div className="flex items-center justify-between mb-3">
                  <span className="text-[10px] font-mono uppercase tracking-wider text-secondary font-black">
                    {ch.game}
                  </span>
                  <span
                    className={`text-[9px] font-mono px-2 py-0.5 rounded border ${
                      ch.stake.includes('MANI')
                        ? 'text-amber-400 border-amber-500/30 bg-amber-500/10'
                        : 'text-white/60 border-white/10 bg-white/5'
                    }`}
                  >
                    Mise : {ch.stake}
                  </span>
                </div>

                <div className="flex items-center gap-2.5 mb-3">
                  <div className="w-8 h-8 rounded-full bg-gradient-to-tr from-primary to-secondary p-0.5 shrink-0">
                    <div className="w-full h-full rounded-full bg-black flex items-center justify-center text-[11px] font-black">
                      {ch.creator[0]}
                    </div>
                  </div>
                  <div>
                    <div className="text-sm font-black text-white">{ch.creator}</div>
                    <div className="text-[9.5px] font-mono text-white/50">Rang : {ch.creatorRank}</div>
                  </div>
                </div>

                <p className="text-xs text-white/70 font-sans mb-3 line-clamp-2">
