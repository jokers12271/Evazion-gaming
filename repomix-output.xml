<file path="src/components/community/LfgMatchmakingBoard.tsx">
import React, { useState } from 'react';
import { Users, Gamepad2, Calendar, Phone, Plus, X, Search, CheckCircle } from 'lucide-react';
import { CyberCard } from '@/components/ui/CyberCard';
import { NeonButton } from '@/components/ui/NeonButton';
import { useCommunityStore, LfgPost } from '@/lib/communityData';
import { useAuth } from '@/hooks/useAuth';
import { useLoyalty } from '@/hooks/useLoyalty';
import { getRank } from '@/lib/ranks';
import { toast } from 'react-hot-toast';
import { cyberAudio } from '@/lib/cyberAudio';

export function LfgMatchmakingBoard() {
  const { user } = useAuth();
  const { data: loyalty } = useLoyalty();
  const userRank = getRank(loyalty?.total_hours || 0);

  const communityDataStore = useCommunityStore();
  const posts: LfgPost[] = communityDataStore.getLfgPosts();
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [filterGame, setFilterGame] = useState('ALL');

  // Form states
  const [game, setGame] = useState('EA SPORTS FC 26');
  const [mode, setMode] = useState<'1v1 Sparring' | 'Ranked Duo' | 'Squad 4v4' | 'Co-op Chill'>('1v1 Sparring');
  const [schedule, setSchedule] = useState('');
  const [note, setNote] = useState('');
  const [whatsapp, setWhatsapp] = useState('+242 06 ');

  const filteredPosts = filterGame === 'ALL' ? posts : posts.filter(p => p.game === filterGame);

  const handleCreatePost = (e: React.FormEvent) => {
    e.preventDefault();
    if (!user) {
      toast.error("Veuillez vous connecter pour publier une annonce");
      return;
    }
    if (!schedule.trim() || !note.trim()) {
      toast.error("Veuillez remplir les horaires et vos disponibilités");
      return;
    }

    cyberAudio.playSuccess();
    communityDataStore.addLfgPost({
      user_id: user.id,
      user_name: user.user_metadata?.display_name || 'Gamer',
      user_avatar: user.user_metadata?.avatar_url,
      rank_name: userRank.name,
      game,
      platform: 'PS5 Pro',
      mode,
      schedule,
      note,
      whatsapp_number: whatsapp.trim() || undefined
    });

    setIsModalOpen(false);
    setSchedule('');
    setNote('');
    toast.success("Annonce de matchmaking publiée sur le tableau ! 🎯", { position: 'bottom-center' });
  };

  const handleDelete = (id: string) => {
    communityDataStore.deleteLfgPost(id);
    toast.success("Annonce supprimée");
  };

  return (
    <div className="space-y-6 text-left">
      {/* En-tête et filtres */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/10">
        <div>
          <h3 className="text-xl md:text-2xl font-black uppercase text-white font-display flex items-center gap-2">
            <Users className="text-secondary" size={22} /> Tableau de Recherche de Joueurs & Rivaux (LFG)
          </h3>
          <p className="text-xs text-white/50 font-sans mt-0.5">
            Trouvez un coéquipier pour grimper en Ranked ou un rival pour vous entraîner sur les PS5 Pro du Sanctuary.
          </p>
        </div>

        <NeonButton
          size="sm"
          variant="cyan"
          sweep
          onClick={() => {
            if (!user) {
              toast.error("Connectez-vous pour déposer une annonce");
              return;
            }
            setIsModalOpen(true);
          }}
          className="shrink-0 text-xs py-2 px-4"
        >
          <Plus size={14} className="mr-1.5" /> Déposer une Annonce
        </NeonButton>
      </div>

      {/* Filtres de jeu */}
      <div className="flex flex-wrap gap-2">
        {['ALL', 'EA SPORTS FC 26', 'TEKKEN 8', 'CALL OF DUTY: BO6', 'MORTAL KOMBAT 1'].map((g) => (
          <button
            key={g}
            onClick={() => setFilterGame(g)}
            className={`px-3 py-1.5 rounded-xl border text-[10px] font-mono font-black uppercase cursor-pointer transition-all ${
              filterGame === g
                ? 'bg-secondary/20 border-secondary text-white shadow-neon-cyan'
                : 'bg-white/5 border-white/10 text-white/60 hover:text-white'
            }`}
          >
            {g === 'ALL' ? 'Tous les Jeux' : g}
          </button>
        ))}
      </div>

      {/* Grille des annonces */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {filteredPosts.map((post) => (
          <div
            key={post.id}
            className="p-5 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-white/20 transition-all flex flex-col justify-between font-display"
          >
            <div>
              <div className="flex items-start justify-between gap-2 mb-3">
                <div className="flex items-center gap-2.5">
                  <img
                    src={post.user_avatar || `https://api.dicebear.com/7.x/bottts/svg?seed=${post.user_name}`}
                    alt=""
                    className="w-9 h-9 rounded-xl object-cover border border-white/20"
                  />
                  <div>
                    <div className="text-xs font-black uppercase text-white leading-tight">
                      {post.user_name}
                    </div>
                    <div className="text-[9px] font-mono text-secondary">
                      Rang {post.rank_name}
                    </div>
                  </div>
                </div>

                <span className="px-2 py-0.5 rounded-md bg-white/10 text-white/80 text-[8px] font-mono uppercase">
                  {post.mode}
                </span>
              </div>

              <div className="text-xs font-black text-white uppercase tracking-tight mb-1 text-primary">
                {post.game}
              </div>

              <p className="text-xs text-white/70 font-sans mb-3 line-clamp-3">
                "{post.note}"
              </p>

              <div className="text-[10px] font-mono text-amber-400/90 mb-4 flex items-center gap-1.5">
                <Calendar size={12} /> {post.schedule}
              </div>
            </div>

            <div className="pt-3 border-t border-white/5 flex items-center justify-between gap-2">
              {post.whatsapp_number ? (
                <a
                  href={`https://wa.me/${post.whatsapp_number.replace(/\D/g, '')}?text=Salut%20${encodeURIComponent(post.user_name)},%20j'ai%20vu%20ton%20annonce%20sur%20The%20Sanctuary%20pour%20jouer%20%C3%A0%20${encodeURIComponent(post.game)}%20!`}
                  target="_blank"
                  rel="noreferrer"
                  className="px-3 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 text-[10px] font-mono font-black uppercase flex items-center gap-1.5 transition-all"
                >
                  <Phone size={12} /> Contacter WhatsApp
                </a>
              ) : (
                <span className="text-[9px] font-mono text-white/40">RDV Direct en Salle</span>
              )}

              {user?.id === post.user_id && (
                <button
                  type="button"
                  onClick={() => handleDelete(post.id)}
                  className="text-[9px] font-mono uppercase text-red-400 hover:text-red-300 cursor-pointer"
                >
                  Supprimer
                </button>
              )}
            </div>
          </div>
        ))}
      </div>

      {/* Modale d'ajout d'annonce */}
      {isModalOpen && (
        <div className="fixed inset-0 z-[9999] bg-black/85 backdrop-blur-md flex items-center justify-center p-4 animate-fade-in font-display">
          <CyberCard variant="cyan" hoverEffect={false} className="w-full max-w-lg p-6 md:p-8 relative text-left">
            <button
              onClick={() => setIsModalOpen(false)}
              className="absolute top-5 right-5 text-white/60 hover:text-white"
            >
              <X size={18} />
            </button>

            <h3 className="text-xl font-black uppercase text-white mb-1">
              Publier une Annonce de Matchmaking
            </h3>
            <p className="text-xs text-white/50 font-sans mb-5">
              Votre proposition sera affichée pour tous les membres du Sanctuaire.
            </p>

            <form onSubmit={handleCreatePost} className="space-y-4">
              <div>
                <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Discipline / Jeu</label>
                <select
                  value={game}
                  onChange={(e) => setGame(e.target.value)}
                  className="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-secondary"
                >
                  <option value="EA SPORTS FC 26">EA SPORTS FC 26</option>
                  <option value="TEKKEN 8">TEKKEN 8</option>
                  <option value="MORTAL KOMBAT 1">MORTAL KOMBAT 1</option>
                  <option value="CALL OF DUTY: BO6">CALL OF DUTY: BO6</option>
                  <option value="GRAN TURISMO 7">GRAN TURISMO 7</option>
                </select>
              </div>

              <div>
                <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Mode de Session</label>
                <div className="grid grid-cols-2 gap-2">
                  {(['1v1 Sparring', 'Ranked Duo', 'Squad 4v4', 'Co-op Chill'] as const).map((m) => (
                    <button
                      type="button"
                      key={m}
                      onClick={() => setMode(m)}
                      className={`p-2 rounded-xl border text-[10px] font-mono uppercase font-black cursor-pointer transition-all ${
                        mode === m
                          ? 'border-secondary bg-secondary/20 text-white'
                          : 'border-white/10 bg-white/5 text-white/60'
                      }`}
                    >
                      {m}
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Créneau Prévu au Sanctuaire</label>
                <input
                  required
                  type="text"
                  placeholder="Ex: Samedi 16h - 18h ou Ce soir dès 20h"
                  value={schedule}
                  onChange={(e) => setSchedule(e.target.value)}
                  className="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-secondary font-sans"
                />
              </div>

              <div>
                <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Numéro WhatsApp (Optionnel pour contact direct)</label>
                <input
                  type="text"
                  placeholder="+242 06 123 45 67"
                  value={whatsapp}
                  onChange={(e) => setWhatsapp(e.target.value)}
                  className="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-secondary font-mono"
                />
              </div>

              <div>
                <label className="text-[9px] font-mono uppercase text-white/50 block mb-1">Message & Objectif de la session</label>
                <textarea
                  required
                  rows={2}
                  placeholder="Précisez votre niveau, ce que vous souhaitez travailler ou le défi..."
                  value={note}
                  onChange={(e) => setNote(e.target.value)}
                  className="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-secondary font-sans resize-none"
                />
              </div>

              <div className="flex gap-3 pt-2">
                <NeonButton type="button" variant="ghost" onClick={() => setIsModalOpen(false)} className="flex-1 py-3 text-xs">
                  Annuler
                </NeonButton>
                <NeonButton type="submit" variant="cyan" sweep className="flex-1 py-3 text-xs">
                  Publier l'Annonce
                </NeonButton>
              </div>
            </form>
          </CyberCard>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/community/SocialFeedWall.tsx">
import React, { useState } from 'react';
import { Flame, Crown, Zap, Target, Send, MessageSquare, Sparkles, Video, Trophy } from 'lucide-react';
import { CyberCard } from '@/components/ui/CyberCard';
import { NeonButton } from '@/components/ui/NeonButton';
import { useCommunityStore, SocialPost } from '@/lib/communityData';
import { useAuth } from '@/hooks/useAuth';
import { toast } from 'react-hot-toast';
import { cyberAudio } from '@/lib/cyberAudio';
import { formatDistanceToNow } from 'date-fns';
import { fr } from 'date-fns/locale';

export function SocialFeedWall() {
  const { user } = useAuth();
  const communityDataStore = useCommunityStore();
  const posts: SocialPost[] = communityDataStore.getSocialPosts();
  const [newContent, setNewContent] = useState('');
  const [selectedGame, setSelectedGame] = useState('EA SPORTS FC 26');
  const [postType, setPostType] = useState<'exploit' | 'clip' | 'announcement'>('exploit');
  const [isSubmitting, setIsSubmitting] = useState(false);

  const handleReact = (postId: string, reaction: 'fire' | 'goat' | 'bolt' | 'clutch') => {
    if (!user) {
      toast.error("Connectez-vous pour réagir aux exploits !");
      return;
    }
    cyberAudio.playClick();
    communityDataStore.reactToPost(postId, reaction, user.id);
  };

  const handleCreatePost = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newContent.trim()) return;
    if (!user) {
      toast.error("Veuillez vous connecter pour publier sur le mur de la salle");
      return;
    }

    setIsSubmitting(true);
    cyberAudio.playSuccess();
    communityDataStore.addSocialPost({
      author_id: user.id,
      author_name: user.user_metadata?.display_name || 'Gamer',
      author_avatar: user.user_metadata?.avatar_url,
      content: newContent.trim(),
      type: postType,
      game: selectedGame
    });

    setNewContent('');
    setIsSubmitting(false);
    toast.success("Exploit partagé sur le mur du Sanctuary ! 🔥", { position: 'bottom-center' });
  };

  return (
    <div className="space-y-6 text-left">
      {/* Formulaire de publication rapide */}
      <CyberCard variant="violet" hoverEffect={false} className="p-6">
        <div className="flex items-center gap-2 mb-3 pb-2 border-b border-white/10">
          <Sparkles size={16} className="text-primary" />
          <span className="text-xs font-black uppercase tracking-wider text-white">
            Partager un Exploit ou une Action d'Anthologie
          </span>
        </div>

        <form onSubmit={handleCreatePost} className="space-y-3">
          <textarea
            required
            rows={2}
            value={newContent}
            onChange={(e) => setNewContent(e.target.value)}
            placeholder="Racontez votre plus belle victoire, un combo meurtrier ou un but d'anthologie sur nos écrans..."
            className="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-primary font-sans resize-none"
          />

          <div className="flex flex-wrap items-center justify-between gap-3 pt-1">
            <div className="flex items-center gap-2">
              <select
                value={selectedGame}
                onChange={(e) => setSelectedGame(e.target.value)}
                className="bg-black/50 border border-white/10 rounded-lg px-2.5 py-1.5 text-[10px] font-mono uppercase text-white/80 focus:outline-none focus:border-primary"
              >
                <option value="EA SPORTS FC 26">EA SPORTS FC 26</option>
                <option value="TEKKEN 8">TEKKEN 8</option>
                <option value="MORTAL KOMBAT 1">MORTAL KOMBAT 1</option>
                <option value="CALL OF DUTY: BO6">CALL OF DUTY: BO6</option>
                <option value="GRAN TURISMO 7">GRAN TURISMO 7</option>
              </select>

              <div className="flex rounded-lg bg-black/40 border border-white/10 p-0.5">
                <button
                  type="button"
                  onClick={() => setPostType('exploit')}
                  className={`px-2.5 py-1 rounded text-[9px] font-mono uppercase font-black cursor-pointer transition-all ${
                    postType === 'exploit' ? 'bg-primary text-black' : 'text-white/60 hover:text-white'
                  }`}
                >
                  Exploit
                </button>
                <button
                  type="button"
                  onClick={() => setPostType('clip')}
                  className={`px-2.5 py-1 rounded text-[9px] font-mono uppercase font-black cursor-pointer transition-all ${
                    postType === 'clip' ? 'bg-secondary text-black' : 'text-white/60 hover:text-white'
                  }`}
                >
                  Highlight
                </button>
              </div>
            </div>

            <NeonButton
              type="submit"
              size="sm"
              variant="violet"
              disabled={isSubmitting || !newContent.trim()}
              className="py-1.5 px-4 text-[10px]"
            >
              <Send size={12} className="mr-1.5" /> Publier
            </NeonButton>
          </div>
        </form>
      </CyberCard>

      {/* Flux de posts */}
      <div className="space-y-4">
        {posts.map((post) => {
          const userReaction = user ? post.user_reactions?.[user.id] : null;

          return (
            <div
              key={post.id}
              className="p-5 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-white/20 transition-all font-display"
            >
              <div className="flex items-start justify-between gap-4 mb-3">
                <div className="flex items-center gap-3">
                  <img
                    src={post.author_avatar || `https://api.dicebear.com/7.x/bottts/svg?seed=${post.author_name}`}
                    alt={post.author_name}
                    className="w-10 h-10 rounded-xl object-cover border border-white/20"
                  />
                  <div>
                    <div className="text-xs font-black uppercase text-white flex items-center gap-2">
                      <span>{post.author_name}</span>
                      {post.type === 'duel_result' && (
                        <span className="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[8px] font-mono">
                          Victoire 1v1
                        </span>
                      )}
                      {post.type === 'exploit' && (
                        <span className="px-2 py-0.5 rounded-full bg-primary/20 text-primary border border-primary/30 text-[8px] font-mono">
                          Exploit Salle
                        </span>
                      )}
                      {post.type === 'clip' && (
                        <span className="px-2 py-0.5 rounded-full bg-secondary/20 text-secondary border border-secondary/30 text-[8px] font-mono">
                          Highlight
                        </span>
                      )}
                    </div>
                    <div className="text-[10px] font-mono text-white/40 flex items-center gap-2 mt-0.5">
                      <span className="text-secondary font-bold">{post.game}</span>
                      <span>·</span>
                      <span>
                        {formatDistanceToNow(new Date(post.created_at), { addSuffix: true, locale: fr })}
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <p className="text-xs md:text-sm text-white/90 font-sans leading-relaxed mb-4 pl-1">
                {post.content}
              </p>

              {/* Boutons de réactions */}
              <div className="flex flex-wrap items-center gap-2 pt-2 border-t border-white/5">
                <button
                  type="button"
                  onClick={() => handleReact(post.id, 'fire')}
                  className={`px-3 py-1.5 rounded-xl border text-xs font-mono font-black flex items-center gap-1.5 cursor-pointer transition-all active:scale-95 ${
                    userReaction === 'fire'
                      ? 'bg-amber-500/20 border-amber-500 text-amber-300 shadow-neon-orange'
                      : 'bg-white/5 border-white/10 text-white/70 hover:bg-white/10 hover:text-white'
                  }`}
                >
                  <Flame size={13} className="text-amber-400" />
                  <span>{post.likes.fire}</span>
                </button>

                <button
                  type="button"
                  onClick={() => handleReact(post.id, 'goat')}
                  className={`px-3 py-1.5 rounded-xl border text-xs font-mono font-black flex items-center gap-1.5 cursor-pointer transition-all active:scale-95 ${
                    userReaction === 'goat'
                      ? 'bg-purple-500/20 border-purple-500 text-purple-300 shadow-neon-violet'
                      : 'bg-white/5 border-white/10 text-white/70 hover:bg-white/10 hover:text-white'
                  }`}
                >
                  <Crown size={13} className="text-purple-400" />
                  <span>{post.likes.goat}</span>
                </button>

                <button
                  type="button"
                  onClick={() => handleReact(post.id, 'bolt')}
                  className={`px-3 py-1.5 rounded-xl border text-xs font-mono font-black flex items-center gap-1.5 cursor-pointer transition-all active:scale-95 ${
                    userReaction === 'bolt'
                      ? 'bg-cyan-500/20 border-cyan-500 text-cyan-300 shadow-neon-cyan'
                      : 'bg-white/5 border-white/10 text-white/70 hover:bg-white/10 hover:text-white'
                  }`}
                >
                  <Zap size={13} className="text-cyan-400" />
                  <span>{post.likes.bolt}</span>
                </button>

                <button
                  type="button"
                  onClick={() => handleReact(post.id, 'clutch')}
                  className={`px-3 py-1.5 rounded-xl border text-xs font-mono font-black flex items-center gap-1.5 cursor-pointer transition-all active:scale-95 ${
                    userReaction === 'clutch'
                      ? 'bg-emerald-500/20 border-emerald-500 text-emerald-300'
                      : 'bg-white/5 border-white/10 text-white/70 hover:bg-white/10 hover:text-white'
                  }`}
                >
                  <Target size={13} className="text-emerald-400" />
                  <span>{post.likes.clutch}</span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}
</file>

<file path="src/components/community/TeamHqModal.tsx">
import React from 'react';
import { X, Shield, Crown, Users, Trophy, Flame, Swords, Calendar } from 'lucide-react';
import { CyberCard } from '@/components/ui/CyberCard';
import { NeonButton } from '@/components/ui/NeonButton';

interface TeamHqModalProps {
  team: any;
  members: any[];
  config?: any;
  onClose: () => void;
  onJoin?: () => void;
  isMember?: boolean;
}

export function TeamHqModal({ team, members, config, onClose, onJoin, isMember }: TeamHqModalProps) {
  if (!team) return null;

  return (
    <div className="fixed inset-0 z-[9999] bg-black/85 backdrop-blur-xl flex items-center justify-center p-4 animate-fade-in font-display">
      <CyberCard
        variant="cyan"
        hoverEffect={false}
        className="w-full max-w-2xl max-h-[90vh] overflow-y-auto custom-scrollbar p-6 md:p-8 relative text-left"
        overlay={
          <div className="absolute inset-0 pointer-events-none overflow-hidden opacity-25">
            <img src={team.image} alt={team.name} className="w-full h-full object-cover scale-110" />
            <div className="absolute inset-0 bg-gradient-to-t from-background via-background/90 to-background/50" />
          </div>
        }
      >
        <button
          onClick={onClose}
          className="absolute top-5 right-5 p-2 rounded-xl bg-white/10 text-white/70 hover:text-white transition-all cursor-pointer z-20"
        >
          <X size={18} />
        </button>

        <div className="relative z-10">
          <div className="flex items-center gap-3 mb-3">
            <span
              className="w-4 h-4 rounded-full shadow-lg"
              style={{ backgroundColor: team.color }}
            />
            <span className="px-3 py-1 rounded-full bg-white/10 border border-white/20 text-[9px] font-mono font-black uppercase tracking-widest text-secondary">
              Quartier Général de Clan
            </span>
          </div>

          <h2 className="text-3xl md:text-4xl font-black uppercase text-white tracking-tight">
            {team.name}
          </h2>
          <p className="text-xs md:text-sm text-white/70 italic font-sans mt-1">
            "{team.tagline}"
          </p>

          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6">
            <div className="p-3 rounded-xl bg-black/50 border border-white/10 text-center">
              <div className="text-[9px] font-mono uppercase text-white/40">Effectif</div>
              <div className="text-lg font-black text-white">{members.length} Gamers</div>
            </div>
            <div className="p-3 rounded-xl bg-black/50 border border-white/10 text-center">
              <div className="text-[9px] font-mono uppercase text-white/40">Cotisation</div>
              <div className="text-lg font-black text-secondary">{config?.monthly_fee || 2000} FCFA</div>
            </div>
            <div className="p-3 rounded-xl bg-black/50 border border-white/10 text-center">
              <div className="text-[9px] font-mono uppercase text-white/40">Adhésion</div>
              <div className="text-lg font-black text-amber-400">{config?.join_fee || 5000} FCFA</div>
            </div>
            <div className="p-3 rounded-xl bg-black/50 border border-white/10 text-center">
              <div className="text-[9px] font-mono uppercase text-white/40">Statut Clan</div>
              <div className="text-lg font-black text-emerald-400">Actif · Top Tier</div>
            </div>
          </div>

          {/* Roster & Capitaine */}
          <div className="space-y-4 mb-6">
            <div className="flex items-center justify-between pb-2 border-b border-white/10">
              <span className="text-xs font-black uppercase tracking-wider text-white flex items-center gap-2">
                <Users size={16} className="text-secondary" /> Roster Officiel ({members.length})
              </span>
              <span className="text-[9px] font-mono text-white/40 uppercase">
                Salle The Sanctuary
              </span>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-48 overflow-y-auto pr-1">
              {members.length === 0 ? (
                <p className="text-xs text-white/40 italic p-3">Aucun membre validé pour le moment.</p>
              ) : (
                members.map((m: any, idx: number) => {
                  const profile = Array.isArray(m.users_metadata) ? m.users_metadata[0] : m.users_metadata;
                  const isCapitaine = idx === 0;

                  return (
                    <div
                      key={m.user_id || idx}
                      className="p-2.5 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-between"
                    >
                      <div className="flex items-center gap-2.5">
                        <img
                          src={profile?.avatar_url || `https://api.dicebear.com/7.x/bottts/svg?seed=${profile?.display_name || idx}`}
                          alt=""
                          className="w-8 h-8 rounded-lg object-cover border border-white/20"
                        />
                        <div>
                          <div className="text-xs font-bold text-white flex items-center gap-1.5">
                            {profile?.display_name || 'Gamer'}
                            {isCapitaine && (
                              <Crown size={12} className="text-amber-400 fill-amber-400 shrink-0" />
                            )}
                          </div>
                          <div className="text-[9px] font-mono text-white/40">
                            {isCapitaine ? 'Capitaine de Clan' : 'Membre Titulaire'}
                          </div>
                        </div>
                      </div>
                      <span className="text-[8px] font-mono uppercase px-2 py-0.5 rounded bg-white/10 text-white/60">
                        {isCapitaine ? 'LEADER' : 'JOUEUR'}
                      </span>
                    </div>
                  );
                })
              )}
            </div>
          </div>

          {/* Avantages de Clan */}
          <div className="p-4 rounded-xl bg-gradient-to-r from-secondary/10 to-primary/10 border border-secondary/30 mb-6">
            <div className="text-xs font-black uppercase text-secondary mb-1 flex items-center gap-1.5">
              <Trophy size={14} /> Avantages Membres du Clan
            </div>
            <ul className="text-[11px] font-sans text-white/70 space-y-1 list-disc list-inside">
              <li>Sessions d'entraînement réservées le mardi et jeudi soir au Sanctuary.</li>
              <li>Partage des victoires en tournoi et bonus de MANI de groupe.</li>
              <li>Accès prioritaire aux consoles PS5 Pro lors des gros tournois de clan.</li>
            </ul>
          </div>

          {/* Actions */}
          <div className="flex gap-3">
            <NeonButton variant="ghost" onClick={onClose} className="flex-1 py-3 text-xs">
              Fermer
            </NeonButton>
            {!isMember && onJoin && (
              <NeonButton variant="violet" sweep onClick={onJoin} className="flex-1 py-3 text-xs">
                Postuler dans cette Team
              </NeonButton>
            )}
          </div>
        </div>
      </CyberCard>
    </div>
  );
}
</file>

<file path="src/components/community/TournamentBracket.tsx">
import { useState } from 'react'
import { Trophy, Users, Swords, Sparkles, CheckCircle2, Flame, Award } from 'lucide-react'
import { CyberCard } from '@/components/ui/CyberCard'
import { NeonButton } from '@/components/ui/NeonButton'
import { cn } from '@blinkdotnew/ui'
import { toast } from 'react-hot-toast'

interface MatchNode {
  id: string
  round: '16e' | '8e' | 'Quarts' | 'Demies' | 'Finale'
  player1: string
  player2: string
  score1: number | null
  score2: number | null
  winner: string | null
  status: 'live' | 'upcoming' | 'finished'
}

const MOCK_BRACKET: MatchNode[] = [
  // Quarts
  { id: 'q1', round: 'Quarts', player1: 'Darius_B', player2: 'Kazuya99', score1: 3, score2: 1, winner: 'Darius_B', status: 'finished' },
  { id: 'q2', round: 'Quarts', player1: 'KingZlatan', player2: 'StephBizz', score1: 2, score2: 3, winner: 'StephBizz', status: 'finished' },
  { id: 'q3', round: 'Quarts', player1: 'JinKazama', player2: 'Hwoarang', score1: 1, score2: 2, winner: 'Hwoarang', status: 'finished' },
  { id: 'q4', round: 'Quarts', player1: 'NicoPro', player2: 'GamerBZV', score1: null, score2: null, winner: null, status: 'live' },
  // Demies
  { id: 's1', round: 'Demies', player1: 'Darius_B', player2: 'StephBizz', score1: 2, score2: 1, winner: 'Darius_B', status: 'live' },
  { id: 's2', round: 'Demies', player1: 'Hwoarang', player2: 'En attente', score1: null, score2: null, winner: null, status: 'upcoming' },
  // Finale
  { id: 'f1', round: 'Finale', player1: 'Darius_B', player2: 'En attente', score1: null, score2: null, winner: null, status: 'upcoming' },
]

export function TournamentBracket() {
  const [predictions, setPredictions] = useState<Record<string, string>>({})
  const [voted, setVoted] = useState<Record<string, boolean>>({})

  const handleVote = (matchId: string, player: string) => {
    setPredictions({ ...predictions, [matchId]: player })
    setVoted({ ...voted, [matchId]: true })
    toast.success(`Pronostic enregistré pour ${player} ! (+2 MANI en jeu)`, { position: 'bottom-center' })
  }

  return (
    <div className="space-y-8 animate-fade-in text-left">
      <div className="flex flex-col md:flex-row items-center justify-between gap-4 border-b border-white/5 pb-6">
        <div className="flex items-center gap-3">
          <div className="w-12 h-12 rounded-2xl bg-secondary/15 border border-secondary/40 flex items-center justify-center text-secondary">
            <Swords size={24} />
          </div>
          <div>
            <h2 className="text-2xl md:text-3xl font-display font-black uppercase text-white">
              Arbre de Tournoi <span className="text-secondary italic">Interactif</span>
            </h2>
            <p className="text-[10px] font-mono uppercase tracking-widest text-white/50">
              Suivi des brackets en direct • Pronostiquez et gagnez des MANI
            </p>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* QUARTS DE FINALE */}
        <div className="space-y-4">
          <h3 className="text-xs font-black uppercase tracking-widest text-secondary text-center mb-4">QUARTS DE FINALE</h3>
          {MOCK_BRACKET.filter(m => m.round === 'Quarts').map(m => (
            <CyberCard key={m.id} accentColor="#06b6d4" className="p-4 space-y-3">
              <div className="flex justify-between items-center text-[9px] font-mono text-white/40">
                <span>MATCH #{m.id.toUpperCase()}</span>
                <span className={cn(
                  "px-2 py-0.5 rounded font-black uppercase",
                  m.status === 'finished' ? "bg-green-500/20 text-green-400" : "bg-cyan-500/20 text-cyan-400 animate-pulse"
                )}>
                  {m.status === 'finished' ? 'TERMINÉ' : 'EN COURS'}
                </span>
              </div>

              <div className="space-y-2 text-xs font-bold uppercase">
                <div className={cn("flex justify-between p-2 rounded-xl bg-white/5", m.winner === m.player1 && "border border-secondary text-secondary")}>
                  <span>{m.player1}</span>
                  <span className="font-mono">{m.score1 ?? '-'}</span>
                </div>
                <div className={cn("flex justify-between p-2 rounded-xl bg-white/5", m.winner === m.player2 && "border border-secondary text-secondary")}>
                  <span>{m.player2}</span>
                  <span className="font-mono">{m.score2 ?? '-'}</span>
                </div>
              </div>

              {m.status !== 'finished' && !voted[m.id] && (
                <div className="pt-2 border-t border-white/5 flex gap-2">
                  <button onClick={() => handleVote(m.id, m.player1)} className="flex-1 py-1 text-[8px] font-black uppercase bg-secondary/20 hover:bg-secondary/30 text-secondary rounded-lg">
                    Prono {m.player1}
                  </button>
                  <button onClick={() => handleVote(m.id, m.player2)} className="flex-1 py-1 text-[8px] font-black uppercase bg-secondary/20 hover:bg-secondary/30 text-secondary rounded-lg">
                    Prono {m.player2}
                  </button>
                </div>
              )}
              {voted[m.id] && (
                <p className="text-[9px] text-center text-green-400 font-mono font-bold">✓ Prono validé ({predictions[m.id]})</p>
              )}
            </CyberCard>
          ))}
        </div>

        {/* DEMIES FINALES */}
        <div className="space-y-4">
          <h3 className="text-xs font-black uppercase tracking-widest text-primary text-center mb-4">DEMIES FINALES</h3>
          {MOCK_BRACKET.filter(m => m.round === 'Demies').map(m => (
            <CyberCard key={m.id} accentColor="#a855f7" className="p-4 space-y-3">
              <div className="flex justify-between items-center text-[9px] font-mono text-white/40">
                <span>MATCH #{m.id.toUpperCase()}</span>
                <span className="px-2 py-0.5 rounded font-black uppercase bg-purple-500/20 text-purple-400 animate-pulse">
                  {m.status === 'live' ? 'EN COURS' : 'BIENTÔT'}
                </span>
              </div>

              <div className="space-y-2 text-xs font-bold uppercase">
                <div className={cn("flex justify-between p-2 rounded-xl bg-white/5", m.winner === m.player1 && "border border-primary text-primary")}>
                  <span>{m.player1}</span>
                  <span className="font-mono">{m.score1 ?? '-'}</span>
                </div>
                <div className={cn("flex justify-between p-2 rounded-xl bg-white/5", m.winner === m.player2 && "border border-primary text-primary")}>
                  <span>{m.player2}</span>
                  <span className="font-mono">{m.score2 ?? '-'}</span>
                </div>
              </div>
            </CyberCard>
          ))}
        </div>

        {/* GRANDE FINALE */}
        <div className="space-y-4">
          <h3 className="text-xs font-black uppercase tracking-widest text-amber-400 text-center mb-4">GRANDE FINALE</h3>
          {MOCK_BRACKET.filter(m => m.round === 'Finale').map(m => (
            <CyberCard key={m.id} accentColor="#f59e0b" className="p-6 space-y-4 border-amber-500/40 shadow-[0_0_25px_rgba(245,158,11,0.2)]">
              <div className="text-center">
                <Trophy size={32} className="text-amber-400 mx-auto mb-2 animate-bounce" />
                <span className="text-[10px] font-mono font-black uppercase text-amber-400">TITRE SUPRÊME DU SANCTUARY</span>
              </div>

              <div className="space-y-2 text-xs font-bold uppercase">
                <div className="flex justify-between p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300">
                  <span>{m.player1}</span>
                  <span className="font-mono">FINALISTE</span>
                </div>
                <div className="flex justify-between p-3 rounded-xl bg-white/5 text-white/40">
                  <span>{m.player2}</span>
                  <span className="font-mono">-</span>
                </div>
              </div>
            </CyberCard>
          ))}
        </div>
      </div>
    </div>
  )
}
</file>

<file path="src/components/dashboard/AdminPlayerList.tsx">
import React, { useState } from 'react';
import { User, Search, Eye, Zap } from 'lucide-react';
import { Link } from '@tanstack/react-router';
import { getRank } from '@/lib/ranks';

export function AdminPlayerList({
  users,
  boxClass,
  boxStyle,
  ManiIcon
}: {
  users?: any[];
  boxClass: string;
  boxStyle: any;
  ManiIcon: any;
}) {
  const [search, setSearch] = useState('');

  const filtered = (users || []).filter((u: any) =>
    (u.display_name || '').toLowerCase().includes(search.toLowerCase())
  );

  return (
    <section className={boxClass} style={boxStyle}>
      <div className="flex items-center justify-between mb-4 text-white">
        <h3 className="text-sm font-black uppercase flex items-center gap-2">
          <User size={18} className="text-amber-400" /> Annuaire des Joueurs ({users?.length || 0})
        </h3>
      </div>

      <div className="relative mb-3">
        <Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-white/30" />
        <input
          type="search"
          placeholder="Rechercher par pseudo..."
          value={search}
          onChange={e => setSearch(e.target.value)}
          className="w-full bg-white/5 border border-white/10 rounded-xl py-2 pl-9 pr-3 text-xs text-white placeholder:text-white/20 focus:outline-none focus:border-amber-400"
        />
      </div>

      <div className="space-y-2 max-h-[220px] overflow-y-auto pr-1 custom-scrollbar">
        {filtered.map((player: any) => {
          const lp = Array.isArray(player.loyalty_points) ? player.loyalty_points[0] : player.loyalty_points;
          const rank = getRank(lp?.total_hours || 0);

          return (
            <div
              key={player.user_id}
              className="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.03] border border-white/5 hover:border-amber-500/30 transition-all text-white"
            >
              <div className="flex items-center gap-2.5">
                <div className="w-8 h-8 rounded-lg overflow-hidden bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
                  {player.avatar_url ? (
                    <img src={player.avatar_url} alt="" className="w-full h-full object-cover" />
                  ) : (
                    <User size={14} className="text-white/30" />
                  )}
                </div>
                <div className="text-left">
                  <p className="text-xs font-black uppercase leading-tight truncate max-w-[120px]" translate="no">
                    @{player.display_name}
                  </p>
                  <span className="text-[8px] font-mono" style={{ color: rank.color }}>
                    Rang {rank.name} • {lp?.total_hours || 0}H
                  </span>
                </div>
              </div>

              <div className="flex items-center gap-2">
                <Link
                  to={`/dashboard/player/${player.user_id}`}
                  className="p-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500 hover:text-black text-amber-400 border border-amber-500/20 text-[9px] font-mono font-black uppercase flex items-center gap-1 transition-all"
                >
                  <Eye size={12} /> Fiche
                </Link>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  );
}
