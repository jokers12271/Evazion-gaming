                                    {isOccupied ? (isManuallyOccupied ? 'BLOQUÉ' : 'OCCUPÉ') : 'DISPO'}
                                  </span>
                                </div>
                              </button>

                              {/* COMMANDES ADMIN RAPIDES */}
                              {isAdmin && (
