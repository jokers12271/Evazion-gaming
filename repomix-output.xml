              </div>
              <div className="text-lg font-black uppercase text-white">
                {liveFinal.player2.name}
              </div>
              <div className="text-xs font-mono text-primary mt-1">
                Score actuel : {liveFinal.player2.score}
              </div>
            </button>
          </div>

          {/* Choix de mise MANI (Réservé aux Spectateurs & Joueurs) */}
          {isAdmin ? (
            <div className="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-left">
              <div className="text-xs font-mono text-amber-300">
