        const { data: expiredInd, error: indErr } = await supabase
          .from('reservations')
          .select('id')
          .eq('status', 'en cours')
          .eq('is_paused', false)
          .lte('end_time', now);

        if (!indErr && expiredInd && expiredInd.length > 0) {
          for (const res of expiredInd) {
            await supabase
              .from('reservations')
              .update({ status: 'consommé' })
