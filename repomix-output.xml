<file path="src/pages/Login.tsx">
import { useState } from 'react'
import { useAuth } from '@/hooks/useAuth'
import { supabase } from '@/lib/supabase'
import { NeonButton } from '@/components/ui/NeonButton'
import { Link, useNavigate } from '@tanstack/react-router'
import { LogIn, Mail, Lock, X, Loader2, KeyRound } from 'lucide-react'
import { toast } from 'react-hot-toast'

export function Login() {
  const { login, verifyOtpAndCreateProfile, resendVerificationCode } = useAuth()
  const navigate = useNavigate()
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [loading, setLoading] = useState(false)

  // États pour la modale "Mot de passe oublié"
  const [isForgotOpen, setIsForgotOpen] = useState(false)
  const [forgotEmail, setForgotEmail] = useState('')
  const [forgotLoading, setForgotLoading] = useState(false)

  // États pour la validation différée "E-mail non confirmé"
  const [isConfirmModalOpen, setIsConfirmModalOpen] = useState(false)
  const [confirmCode, setConfirmCode] = useState('')
  const [confirmLoading, setConfirmLoading] = useState(false)

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault()
    setLoading(true)
    try {
      await login(email, password)
      toast.success("Connexion confirmée au compte !", {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid hsl(270, 90%, 60%)',
          borderRadius: '1rem',
          boxShadow: '0 0 15px hsl(270, 90%, 60%, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      });
      navigate({ to: '/dashboard' });
    } catch (error: any) {
      console.error(error);
      // Gérer l'état où l'utilisateur n'a pas encore validé son adresse e-mail
      if (error.message?.includes("Email not confirmed") || error.message?.includes("not confirmed")) {
        toast.error("Votre adresse e-mail n'a pas encore été vérifiée.", { duration: 5000 })
        setIsConfirmModalOpen(true) // Ouvrir la modale d'activation OTP
      } else {
        toast.error("Identifiants de connexion incorrects")
      }
    } finally {
      setLoading(false)
    }
  }

  // Traiter la validation tardive de l'OTP
  const handleConfirmEmailOtp = async (e: React.FormEvent) => {
    e.preventDefault()
    if (confirmCode.length < 6) return

    setConfirmLoading(true)
    try {
      // Valide l'e-mail et crée le profil
      await verifyOtpAndCreateProfile(email, confirmCode, email.split('@')[0], '')
      toast.success("E-mail validé avec succès ! Connexion en cours...", { position: "bottom-center" })
      setIsConfirmModalOpen(false)
      navigate({ to: '/dashboard' })
    } catch (err: any) {
      toast.error(err.message || "Code incorrect ou expiré.")
    } finally {
      setConfirmLoading(false)
    }
  }

  const handleResendConfirmCode = async () => {
    try {
      await resendVerificationCode(email)
      toast.success("Un nouveau code a été envoyé sur votre e-mail.")
    } catch (err: any) {
      toast.error(err.message || "Erreur d'envoi du code.")
    }
  }

  const handleForgotPasswordSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!forgotEmail.trim()) return

    setForgotLoading(true)
    try {
      const { error } = await supabase.auth.resetPasswordForEmail(forgotEmail, {
        redirectTo: window.location.origin + '/reset-password',
      })
      if (error) throw error

      toast.success("E-mail de récupération envoyé ! Vérifiez votre boîte de réception.", {
        position: "bottom-center",
        duration: 6000
      })
      setIsForgotOpen(false)
      setForgotEmail('')
    } catch (err: any) {
      toast.error(err.message || "Erreur lors de l'envoi de l'e-mail.")
    } finally {
      setForgotLoading(false)
    }
  }

  return (
    <div className="pt-24 md:pt-40 pb-16 md:pb-24 min-h-screen flex items-center justify-center bg-background px-4 relative">
      <div className="max-w-md w-full glass p-10 rounded-[2.5rem] border-white/5">
        <h1 className="text-3xl font-display uppercase text-center mb-8">Connexion</h1>
        <form onSubmit={handleLogin} className="space-y-6 text-left">
          <div>
            <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Email</label>
            <div className="relative mt-2">
              <Mail className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
              <input required type="email" placeholder="Saisir votre adresse Gmail" className="w-full bg-white/5 border border-white/10 rounded-xl py-4 pl-12 text-white focus:outline-none focus:border-primary text-xs" value={email} onChange={(e) => setEmail(e.target.value)} />
            </div>
          </div>
          <div>
            <div className="flex justify-between items-center ml-1">
              <label className="text-[10px] uppercase font-black text-primary tracking-widest">Mot de passe</label>
              <button 
                type="button" 
                onClick={() => setIsForgotOpen(true)}
                className="text-[8px] font-black uppercase text-white/40 hover:text-white transition-colors"
              >
                Mot de passe oublié ?
              </button>
            </div>
            <div className="relative mt-2">
              <Lock className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
              <input required type="password" placeholder="Saisir votre mot de passe" className="w-full bg-white/5 border border-white/10 rounded-xl py-4 pl-12 text-white focus:outline-none focus:border-primary text-xs" value={password} onChange={(e) => setPassword(e.target.value)} />
            </div>
          </div>
          <NeonButton disabled={loading} className="w-full py-4">{loading ? "Identification..." : "Accéder au Hub"}</NeonButton>
        </form>
        <p className="mt-8 text-center text-xs text-muted-foreground uppercase">Nouveau ? <Link to="/register" className="text-primary font-bold">Créer un compte</Link></p>
      </div>

      {/* POP-UP : MOT DE PASSE OUBLIÉ */}
      {isForgotOpen && (
        <div className="fixed inset-0 bg-black/85 backdrop-blur-md z-[9999] flex items-center justify-center p-4 animate-fade-in text-center text-white font-display">
          <div className="glass p-8 md:p-10 rounded-[2.5rem] border-2 border-primary shadow-neon-violet max-w-sm w-full relative">
            <button 
              onClick={() => setIsForgotOpen(false)}
              className="absolute top-6 right-6 text-white/40 hover:text-white transition-colors focus:outline-none"
            >
              <X size={20} />
            </button>

            <div className="w-12 h-12 bg-primary/20 rounded-xl flex items-center justify-center mx-auto mb-4 border border-primary/30">
              <Mail className="text-primary animate-pulse" size={24} />
            </div>

            <h3 className="text-xl font-black uppercase text-primary mb-2">Récupération de compte</h3>
            <p className="text-[9px] uppercase tracking-widest text-white/40 font-black mb-6">Un e-mail de réinitialisation vous sera envoyé</p>

            <form onSubmit={handleForgotPasswordSubmit} className="space-y-4 text-left">
              <div className="space-y-1.5">
                <label className="text-[9px] uppercase font-black text-white/40 tracking-wider">Saisissez votre e-mail d'inscription</label>
                <input
                  required
                  type="email"
                  placeholder="nom@exemple.com"
                  value={forgotEmail}
                  onChange={e => setForgotEmail(e.target.value)}
                  className="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-primary"
                />
              </div>

              <div className="pt-2">
                <NeonButton 
                  type="submit" 
                  variant="violet" 
                  disabled={forgotLoading}
                  className="w-full py-3 text-[10px] font-black flex items-center justify-center gap-2"
                >
                  {forgotLoading && <Loader2 className="animate-spin" size={12} />}
                  {forgotLoading ? "ENVOI EN COURS..." : "RÉINITIALISER MON MOT DE PASSE"}
                </NeonButton>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* POP-UP : ADRESSE E-MAIL NON CONFIRMÉE */}
      {isConfirmModalOpen && (
        <div className="fixed inset-0 bg-black/85 backdrop-blur-md z-[9999] flex items-center justify-center p-4 animate-fade-in text-center text-white font-display">
          <div className="glass p-8 md:p-10 rounded-[2.5rem] border-2 border-secondary shadow-neon-cyan max-w-sm w-full relative">
            <button 
              onClick={() => setIsConfirmModalOpen(false)}
              className="absolute top-6 right-6 text-white/40 hover:text-white transition-colors focus:outline-none"
            >
              <X size={20} />
            </button>

            <div className="w-12 h-12 bg-secondary/20 rounded-xl flex items-center justify-center mx-auto mb-4 border border-secondary/30">
              <KeyRound className="text-secondary animate-pulse" size={24} />
            </div>

            <h3 className="text-xl font-black uppercase text-secondary mb-2">Compte non validé</h3>
            <p className="text-[9px] uppercase tracking-widest text-white/40 font-black mb-6">Saisissez le code reçu sur {email}</p>

            <form onSubmit={handleConfirmEmailOtp} className="space-y-4 text-left">
              <div className="space-y-1.5">
                <label className="text-[9px] uppercase font-black text-white/40 tracking-wider">Code à 6 chiffres</label>
                <input
                  required
                  type="text"
                  maxLength={6}
                  placeholder="Ex: 123456"
                  value={confirmCode}
                  onChange={e => setConfirmCode(e.target.value.replace(/\D/g, ''))}
                  className="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-xs text-white text-center font-black tracking-[0.25em]"
                />
              </div>

              <div className="flex flex-col gap-3 pt-2">
                <NeonButton 
                  type="submit" 
                  variant="cyan" 
                  disabled={confirmLoading}
                  className="w-full py-3 text-[10px] font-black flex items-center justify-center gap-2"
                >
                  {confirmLoading && <Loader2 className="animate-spin" size={12} />}
                  {confirmLoading ? "VALIDATION..." : "ACTIVER MON COMPTE"}
                </NeonButton>
                
                <button
                  type="button"
                  onClick={handleResendConfirmCode}
                  className="text-[9px] font-black uppercase tracking-widest text-white/40 hover:text-white transition-colors text-center"
                >
                  Renvoyer un code de validation
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  )
}
</file>

<file path="src/pages/News.tsx">
import { useState } from 'react'
import { useNews } from '@/hooks/useNews'
import { useUserMetadata } from '@/hooks/useUserMetadata'
import { NeonButton } from '@/components/ui/NeonButton'
import { Calendar, Tag, Trash2, Plus, X, Image as ImageIcon, Loader2 } from 'lucide-react'
import { format } from 'date-fns'
import { fr } from 'date-fns/locale'
import { cn } from '@blinkdotnew/ui'
import { toast } from 'react-hot-toast'

export function News() {
  const { news, addNews, deleteNews } = useNews()
  const { data: metadata } = useUserMetadata()
  const isAdmin = (metadata as any)?.is_admin

  // États pour le formulaire d'ajout
  const [showAddForm, setShowAddForm] = useState(false)
  const [title, setTitle] = useState('')
  const [excerpt, setExcerpt] = useState('')
  const [category, setCategory] = useState('Salle')
  const [imageUrl, setImageUrl] = useState('')
  const [selectedArticle, setSelectedArticle] = useState<any | null>(null) // AJOUTÉ : État de l'article en cours de lecture

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    try {
      await addNews.mutateAsync({
        title,
        excerpt,
        category,
        image: imageUrl || 'https://images.unsplash.com/photo-1606144042614-b2417e99c4e3?q=80&w=800'
      })
      toast.success("Article publié !")
      setShowAddForm(false)
      setTitle(''); setExcerpt(''); setImageUrl('')
    } catch (err) {
      toast.error("Erreur lors de la publication")
    }
  }

  return (
    <div className="pt-24 md:pt-40 pb-16 md:pb-24 min-h-screen bg-background relative overflow-hidden animate-fade-in">
      {/* Fond d'écran immersif de la page */}
      <div className="absolute inset-0 z-0 pointer-events-none">
        <div className="absolute inset-0 bg-gradient-to-b from-background/10 via-background/80 to-background z-10" />
        <img 
          src="https://images.unsplash.com/photo-1509198397868-475647b2a1e5?q=80&w=1600" 
          className="w-full h-full object-cover opacity-20" 
          alt="news backdrop"
        />
      </div>
      <div className="container mx-auto px-4 max-w-6xl relative z-20">
        
        <header className="mb-20 text-center">
          <h1 className="text-6xl md:text-8xl font-display font-black uppercase tracking-tighter text-white">
            ACTUALITÉS <span className="text-secondary italic">GAMING</span>
          </h1>
          <p className="text-muted-foreground uppercase text-xs tracking-[0.3em] font-bold mt-4">
            Suivez le flux du Hub en temps réel
          </p>

          {/* Bouton pour ouvrir le formulaire (Visible uniquement Admin) */}
          {isAdmin && (
            <button 
              onClick={() => setShowAddForm(!showAddForm)}
              className="mt-10 flex items-center gap-2 mx-auto bg-primary text-black px-6 py-3 rounded-full font-black uppercase text-xs hover:scale-105 transition-all shadow-neon-violet"
            >
              {showAddForm ? <X size={18}/> : <Plus size={18}/>}
              {showAddForm ? "Annuler" : "Rédiger un article"}
            </button>
          )}
        </header>

        {/* FORMULAIRE ADMIN (DYNAMIQUE) */}
        {isAdmin && showAddForm && (
          <div className="mb-20 glass p-8 rounded-[2rem] border-primary/20 animate-fade-in">
            <h2 className="text-xl font-display uppercase mb-8 text-primary">Nouvel Article</h2>
            <form onSubmit={handleSubmit} className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <input required placeholder="Titre de l'article" className="bg-white/5 border border-white/10 rounded-xl p-4 text-white" value={title} onChange={(e) => setTitle(e.target.value)} />
              <select className="bg-white/5 border border-white/10 rounded-xl p-4 text-white" value={category} onChange={(e) => setCategory(e.target.value)}>
                <option value="Salle">Salle</option>
                <option value="Tournois">Tournois</option>
                <option value="Global">Global</option>
                <option value="Promo">Promo</option>
              </select>
              <input placeholder="URL de l'image (Lien Unsplash par ex.)" className="bg-white/5 border border-white/10 rounded-xl p-4 text-white col-span-1 md:col-span-2" value={imageUrl} onChange={(e) => setImageUrl(e.target.value)} />
              <textarea required placeholder="Contenu court de l'article..." className="bg-white/5 border border-white/10 rounded-xl p-4 text-white col-span-1 md:col-span-2 h-32" value={excerpt} onChange={(e) => setExcerpt(e.target.value)} />
              <NeonButton disabled={addNews.isPending} className="col-span-1 md:col-span-2 py-4">
                {addNews.isPending ? "Publication..." : "PUBLIER SUR LE HUB"}
              </NeonButton>
            </form>
          </div>
        )}

        {/* LISTE DES ARTICLES */}
        {news.isLoading ? (
          <div className="flex justify-center py-20"><Loader2 className="animate-spin text-primary" size={40}/></div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {news.data?.map((item) => (
              <article key={item.id} className="group glass border-white/5 rounded-[2.5rem] overflow-hidden flex flex-col hover:border-secondary/30 transition-all duration-500">
                <div className="aspect-[16/10] overflow-hidden relative">
                   
                   {/* AJOUTÉ : Gestion de l'affichage des avatars face-à-face (Si défi actif) ou du portrait de vainqueur (Si résolu) */}
                   {item.category === 'Ragnarok' && (item as any).challenger_avatar_url && (item as any).challenged_avatar_url ? (
                     <div className="w-full h-full bg-[#040405] flex items-center justify-center gap-6 px-6 relative border-b border-white/5 overflow-hidden">
                       {/* Avatar du Challenger (Leader) */}
                       <div className="w-16 h-16 rounded-2xl overflow-hidden border-2 border-primary shadow-neon-violet relative shrink-0">
                         <img src={(item as any).challenger_avatar_url || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=150'} className="w-full h-full object-cover" alt="challenger" />
                       </div>
                       
                       {/* Symbole d'affrontement VS */}
                       <div className="w-10 h-10 rounded-full bg-accent/20 border border-accent/40 flex items-center justify-center shrink-0 shadow-neon-orange z-10">
                         <span className="font-display font-black text-xs text-accent">VS</span>
                       </div>

                       {/* Avatar du Défié */}
                       <div className="w-16 h-16 rounded-2xl overflow-hidden border-2 border-secondary shadow-neon-cyan relative shrink-0">
                         <img src={(item as any).challenged_avatar_url || 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=150'} className="w-full h-full object-cover" alt="challenged" />
                       </div>
                     </div>
                   ) : item.category === 'Ragnarok' && (item as any).winner_avatar_url ? (
                     // Si victoire résolue : Affiche uniquement l'avatar rond du champion auréolé d'or
                     <div className="w-full h-full bg-[#040405] flex flex-col items-center justify-center p-6 relative border-b border-white/5 overflow-hidden">
                       <div className="w-20 h-20 rounded-full overflow-hidden border-4 border-yellow-500 shadow-[0_0_25px_rgba(234,179,8,0.5)] relative shrink-0">
