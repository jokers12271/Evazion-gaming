      icon: <Users size={28} />
    },
    {
      title: "Cotisations & Gestion des frais",
      desc: "Définissez les frais d'intégration et les cotisations de chaque Team d'un clic. Approuvez ou refusez les demandes d'adhésions reçues.",
      icon: <Landmark size={28} />
