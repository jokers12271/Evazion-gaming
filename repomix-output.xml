<file path="src/components/tournaments/TournamentBracket.tsx">
import React, { useState } from 'react';
import { Trophy, Swords, Edit3, Check, Flame, Users, Sparkles } from 'lucide-react';
import { useTournamentStore, BracketMatch } from '@/lib/tournamentData';
import { CyberCard } from '@/components/ui/CyberCard';
import { toast } from 'react-hot-toast';
import { cyberAudio } from '@/lib/cyberAudio';

export function TournamentBracket({ isAdmin }: { isAdmin: boolean }) {
  const tournamentDataStore = useTournamentStore();
  const matches: BracketMatch[] = tournamentDataStore.getBracketMatches();
  const [editingMatchId, setEditingMatchId] = useState<string | null>(null);
  const [score1, setScore1] = useState(0);
  const [score2, setScore2] = useState(0);

  const quarters = matches.filter(m => m.round === 'quarters');
  const semis = matches.filter(m => m.round === 'semis');
  const final = matches.find(m => m.round === 'final');

  const handleOpenEdit = (m: BracketMatch) => {
    setEditingMatchId(m.id);
    setScore1(m.player1.score ?? 0);
    setScore2(m.player2.score ?? 0);
  };

  const handleSaveScore = (match: BracketMatch) => {
    cyberAudio.playSuccess();
    const winnerId = score1 > score2 ? match.player1.id : (score2 > score1 ? match.player2.id : undefined);
    tournamentDataStore.updateMatchScore(match.id, score1, score2, winnerId);
    setEditingMatchId(null);
    toast.success("Score du match validé avec succès ! ⚽", { position: 'bottom-center' });
  };

  const renderMatchCard = (m: BracketMatch) => {
    const isEditing = editingMatchId === m.id;
    const isLive = m.status === 'live';

    return (
      <div
        key={m.id}
        className={`p-3.5 rounded-xl border transition-all relative ${
          isLive
            ? 'bg-gradient-to-r from-red-500/10 via-purple-500/10 to-transparent border-red-500/50 shadow-[0_0_20px_rgba(239,68,68,0.2)]'
            : 'bg-black/50 border-white/10 hover:border-white/20'
        }`}
      >
        <div className="flex items-center justify-between text-[9px] font-mono uppercase text-white/40 mb-2">
          <span>{m.round_label} · {m.station_label}</span>
          {isLive ? (
            <span className="px-2 py-0.5 rounded-full bg-red-500/20 text-red-400 border border-red-500/40 font-black animate-pulse flex items-center gap-1">
              <Flame size={10} /> EN DIRECT
            </span>
          ) : (
            <span>{m.scheduled_time}</span>
          )}
        </div>

        {/* Joueur 1 */}
        <div className={`flex items-center justify-between p-2 rounded-lg mb-1.5 transition-all ${
          m.winner_id === m.player1.id ? 'bg-emerald-500/15 border border-emerald-500/30' : 'bg-white/[0.02]'
        }`}>
          <div className="flex items-center gap-2 overflow-hidden">
            <span className="font-bold text-xs uppercase text-white truncate">
              {m.player1.name}
            </span>
            {m.player1.team && (
              <span className="text-[8px] font-mono text-white/40 truncate hidden sm:inline">
                [{m.player1.team}]
              </span>
            )}
          </div>
          <span className="text-xs font-mono font-black px-2 py-0.5 rounded bg-black/60 text-white ml-2">
            {m.player1.score ?? '-'}
          </span>
        </div>

        {/* Joueur 2 */}
        <div className={`flex items-center justify-between p-2 rounded-lg transition-all ${
          m.winner_id === m.player2.id ? 'bg-emerald-500/15 border border-emerald-500/30' : 'bg-white/[0.02]'
        }`}>
          <div className="flex items-center gap-2 overflow-hidden">
            <span className="font-bold text-xs uppercase text-white truncate">
              {m.player2.name}
            </span>
            {m.player2.team && (
              <span className="text-[8px] font-mono text-white/40 truncate hidden sm:inline">
                [{m.player2.team}]
              </span>
            )}
          </div>
          <span className="text-xs font-mono font-black px-2 py-0.5 rounded bg-black/60 text-white ml-2">
            {m.player2.score ?? '-'}
          </span>
        </div>

        {/* Admin Saisie Score */}
        {isAdmin && !isEditing && (
          <button
            type="button"
            onClick={() => handleOpenEdit(m)}
            className="w-full mt-2 py-1 rounded bg-white/5 hover:bg-white/10 text-[8px] font-mono uppercase text-white/60 hover:text-white flex items-center justify-center gap-1 cursor-pointer transition-all"
          >
            <Edit3 size={10} /> Arbitrer le score
          </button>
        )}

        {isEditing && (
          <div className="mt-2 p-2 bg-black/80 rounded-lg border border-secondary/40 space-y-2">
            <div className="flex items-center justify-center gap-2 text-xs font-mono">
              <input
                type="number"
                min="0"
                value={score1}
                onChange={(e) => setScore1(Number(e.target.value))}
                className="w-12 bg-white/10 border border-white/20 rounded p-1 text-center text-white font-bold"
              />
              <span className="text-white/40">-</span>
              <input
                type="number"
                min="0"
                value={score2}
                onChange={(e) => setScore2(Number(e.target.value))}
                className="w-12 bg-white/10 border border-white/20 rounded p-1 text-center text-white font-bold"
              />
            </div>
            <div className="flex gap-1.5">
              <button
                type="button"
                onClick={() => setEditingMatchId(null)}
                className="flex-1 py-1 rounded bg-white/10 text-[8px] font-mono uppercase text-white/60 cursor-pointer"
              >
                Annuler
              </button>
              <button
                type="button"
                onClick={() => handleSaveScore(m)}
                className="flex-1 py-1 rounded bg-secondary text-black text-[8px] font-mono uppercase font-black cursor-pointer"
              >
                Valider
              </button>
            </div>
          </div>
        )}
      </div>
    );
  };

  return (
    <div className="space-y-6 text-left font-display">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/10">
        <div>
          <h3 className="text-xl md:text-2xl font-black uppercase text-white flex items-center gap-2">
            <Swords className="text-secondary" size={22} /> Arbre de Tournoi Interactif (Playoff Bracket)
          </h3>
          <p className="text-xs text-white/50 font-sans mt-0.5">
            Suivi des confrontations en temps réel depuis les quarts de finale jusqu'au sacre suprême.
          </p>
        </div>
        <div className="flex items-center gap-2">
          <span className="px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[9px] font-mono uppercase text-emerald-400 font-bold flex items-center gap-1.5">
            <Sparkles size={11} /> Synchronisé avec les pupitres
          </span>
        </div>
      </div>

      {/* Colonnes de l'Arbre */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
        {/* Quarts */}
        <div className="space-y-4">
          <div className="text-xs font-black uppercase tracking-wider text-secondary flex items-center justify-between pb-2 border-b border-white/10">
            <span>Quarts de Finale (Bo1)</span>
            <span className="text-[9px] font-mono text-white/40">4 Matchs</span>
          </div>
          <div className="space-y-3">
            {quarters.map(renderMatchCard)}
          </div>
        </div>

        {/* Demies */}
        <div className="space-y-4">
          <div className="text-xs font-black uppercase tracking-wider text-primary flex items-center justify-between pb-2 border-b border-white/10">
            <span>Demi-Finales (Bo3)</span>
            <span className="text-[9px] font-mono text-white/40">2 Matchs</span>
          </div>
          <div className="space-y-6 pt-4">
            {semis.map(renderMatchCard)}
          </div>
        </div>

        {/* Grande Finale */}
        <div className="space-y-4">
          <div className="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center justify-between pb-2 border-b border-white/10">
            <span className="flex items-center gap-1.5"><Trophy size={14} /> Grande Finale (Bo3)</span>
            <span className="text-[9px] font-mono text-amber-400 font-bold">150 000 FCFA</span>
          </div>
          <div className="pt-12">
            {final && renderMatchCard(final)}
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

