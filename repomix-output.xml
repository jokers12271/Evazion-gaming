import { useParams, useNavigate } from '@tanstack/react-router'
import { useQuery } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { NeonButton } from '@/components/ui/NeonButton'
import { User, Clock, ChevronLeft, Loader2, Zap, CheckCircle2 } from 'lucide-react'
import { getRank } from '@/lib/ranks'
import { cn } from '@blinkdotnew/ui'
import { toast } from 'react-hot-toast'
import { useReservations } from '@/hooks/useReservations'
import { useUserMetadata, useToggleBanPlayer } from '@/hooks/useUserMetadata' // AJOUTÉ

export function PlayerDetail() {
  const { playerId } = useParams({ from: '/dashboard/player/$playerId' })
  const navigate = useNavigate()
  const { createReservation } = useReservations()
  const { data: adminMetadata } = useUserMetadata() // AJOUTÉ : Pour vérifier si l'utilisateur connecté est admin
  const toggleBanPlayer = useToggleBanPlayer() // AJOUTÉ

  const isAdmin = adminMetadata?.is_admin || false;

  const { data: player, isLoading } = useQuery({
    queryKey: ['player', playerId],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('users_metadata')
        .select('*, loyalty_points(*)')
        .eq('user_id', playerId)
        .maybeSingle()
      if (error) throw error
      return data
    }
  })

  if (isLoading) return <div className="pt-40 flex justify-center bg-background min-h-screen"><Loader2 className="animate-spin text-primary" size={40} /></div>
  if (!player) return <div className="pt-40 text-center text-white bg-background min-h-screen">Joueur introuvable</div>

  const loyalty = Array.isArray(player.loyalty_points) ? player.loyalty_points[0] : player.loyalty_points;
  const rank = getRank(loyalty?.total_hours || 0)

  const handleQuickStart = async () => {
    const station = window.prompt("Numéro de station ? (Ex: PS5_1)")
    const minutes = window.prompt("Durée en minutes ? (Ex: 60)")
    
    if (station && minutes) {
      const start = new Date().toISOString()
      const end = new Date(Date.now() + parseInt(minutes) * 60000).toISOString()
      
      try {
        await createReservation.mutateAsync({
          station_id: station,
          start_time: start,
          end_time: end,
          display_name: player.display_name,
          status: 'pending', // MODIFIÉ : Créée en attente pour être démarrée manuellement (Play)
          user_id: playerId // On force l'ID du joueur scanné
        })
        toast.success(`Session de ${minutes}min créée sur ${station}. Activez-la sur le Dashboard !`)
        navigate({ to: '/dashboard' })
      } catch (e) {
        toast.error("Erreur lors du lancement")
      }
    }
  }

  return (
    <div className="pt-24 md:pt-40 pb-16 md:pb-24 min-h-screen bg-background text-white">
      <div className="container mx-auto px-4 max-w-2xl">
        <button onClick={() => navigate({ to: '/dashboard' })} className="flex items-center gap-2 text-muted-foreground mb-8 hover:text-white transition-colors uppercase text-[10px] font-black tracking-widest">
          <ChevronLeft size={16} /> Retour Dashboard
        </button>

        <div className={cn("glass p-10 rounded-[3rem] border-t-[12px] shadow-2xl animate-fade-in", rank.border)}>
          <div className="flex flex-col items-center text-center mb-10">
            <div className={cn("w-32 h-32 rounded-[2rem] flex items-center justify-center mb-6 shadow-2xl overflow-hidden border-2", rank.border)}>
              {player.avatar_url ? <img src={player.avatar_url} className="w-full h-full object-cover" alt="p" /> : <User size={64} className={rank.label} />}
            </div>
            <h1 className="text-4xl font-display font-black uppercase tracking-tighter" translate="no">{player.display_name}</h1>
            <div className={cn("mt-4 px-6 py-2 rounded-full text-[10px] font-black uppercase tracking-widest border shadow-lg", rank.bg, rank.label, rank.border)}>
              Rang {rank.name}
            </div>
          </div>

          <div className="grid grid-cols-2 gap-6 mb-12">
            <div className="glass bg-white/5 p-6 rounded-3xl text-center border border-white/5">
              <p className="text-[10px] uppercase font-black text-white/40 mb-2 tracking-widest">Solde</p>
              <div className="text-3xl font-display font-black text-secondary flex items-center justify-center gap-2">
                {loyalty?.points || 0} <img src="/mani.jpg" className="w-6 h-6 rounded-full" alt="M" />
              </div>
            </div>
            <div className="glass bg-white/5 p-6 rounded-3xl text-center border border-white/5">
              <p className="text-[10px] uppercase font-black text-white/40 mb-2 tracking-widest">Temps</p>
              <div className="text-3xl font-display font-black text-white">{loyalty?.total_hours || 0} H</div>
            </div>
          </div>

          <div className="space-y-4">
            <NeonButton className="w-full py-6 text-base font-black uppercase tracking-widest" onClick={handleQuickStart}>
              <CheckCircle2 className="mr-2" /> Démarrer Session Live
            </NeonButton>
            <p className="text-center text-[9px] uppercase font-bold text-white/20 tracking-widest">
              Action réservée au terminal d'administration
            </p>
          </div>

          {/* AJOUTÉ : Panneau de modération (Exclure, Bannir, ou Débannir) */}
          {isAdmin && (
            <div className="mt-8 border-t border-white/5 pt-6 space-y-4 text-left">
              <p className="text-[10px] font-black uppercase text-white/40 tracking-wider">Contrôle de Modération Admin :</p>
              <NeonButton 
                variant={player.is_banned ? "ghost" : "orange"}
                className="w-full py-4 text-xs font-black tracking-widest shadow-lg shadow-red-500/10"
                style={player.is_banned ? { borderColor: '#ef4444', color: '#ef4444' } : {}}
                onClick={async () => {
                  if (confirm(player.is_banned ? `Réactiver et débannir le compte de @${player.display_name} ?` : `Bannir définitivement @${player.display_name} du Sanctuary pour non-respect du règlement ?`)) {
                    try {
                      await toggleBanPlayer.mutateAsync({ userId: player.user_id, isBanned: !player.is_banned });
                      toast.success(player.is_banned ? "Joueur débanni avec succès !" : "Joueur banni du Sanctuary !");
                      navigate({ to: '/dashboard' });
                    } catch (err) {
                      toast.error("Échec de l'opération de modération");
                    }
                  }
                }}
              >
                {player.is_banned ? "RÉACTIVER LE COMPTE (DÉBANNIR)" : "BANNIR LE JOUEUR DU SANCTUARY"}
              </NeonButton>
            </div>
          )}

        </div>
      </div>
    </div>
  )
}
</file>

<file path="src/pages/Register.tsx">
import { useState } from 'react'
import { useAuth } from '@/hooks/useAuth'
import { NeonButton } from '@/components/ui/NeonButton'
import { Link, useNavigate } from '@tanstack/react-router'
import { UserPlus, Mail, Lock, User, KeyRound, Loader2, ImageIcon } from 'lucide-react'
import { toast } from 'react-hot-toast'

export function Register() {
  const { signUp, checkDisplayNameUniqueness, verifyOtpAndCreateProfile, resendVerificationCode } = useAuth()
  const navigate = useNavigate()
  
  // États du formulaire principal
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [displayName, setDisplayName] = useState('')
  const [avatarUrl, setAvatarUrl] = useState('')
  
  // États de l'écran OTP
  const [step, setStep] = useState<'form' | 'verify'>('form')
  const [verificationCode, setVerificationCode] = useState('')
  const [loading, setLoading] = useState(false)
  const [resending, setResending] = useState(false)

  const validatePasswordStrength = (pass: string): string | null => {
    const hasUppercase = /[A-Z]/.test(pass);
    const hasLowercase = /[a-z]/.test(pass);
    const hasDigit = /[0-9]/.test(pass);
    const hasSpecial = /[^A-Za-z0-9]/.test(pass);
    const isAtLeast6Char = pass.length >= 6;

    if (!isAtLeast6Char) return "Le mot de passe doit faire au moins 6 caractères.";
    if (!hasUppercase) return "Le mot de passe doit contenir au moins une lettre majuscule (A-Z).";
    if (!hasLowercase) return "Le mot de passe doit contenir au moins une lettre minuscule (a-z).";
    if (!hasDigit) return "Le mot de passe doit contenir au moins un chiffre (0-9).";
    if (!hasSpecial) return "Le mot de passe doit contenir au moins un caractère spécial (ex: @, $, !, %).";

    return null;
  }

  // Étape 1 : Soumission initiale (Création de compte temporaire + Envoi OTP)
  const handleRegister = async (e: React.FormEvent) => {
    e.preventDefault()

    const passwordError = validatePasswordStrength(password)
    if (passwordError) {
      return toast.error(passwordError, { position: "bottom-center" })
    }

    setLoading(true)
    try {
      // Vérifier le pseudo en premier
      await checkDisplayNameUniqueness(displayName)
      
      // Lancer la création du compte (déclenche l'envoi de l'OTP par e-mail)
      await signUp(email, password)
      
      toast.success("Code de vérification envoyé à votre adresse e-mail !", {
        position: "bottom-center",
        duration: 5000
      })
      
      setStep('verify') // Passer à l'écran de vérification OTP
    } catch (error: any) {
      console.error(error)
      toast.error(error.message || "Erreur d'inscription")
    } finally {
      setLoading(false)
    }
  }

  // Étape 2 : Validation de l'OTP à 6 chiffres
  const handleVerifyOtp = async (e: React.FormEvent) => {
    e.preventDefault()
    if (verificationCode.length < 6) {
      return toast.error("Le code de vérification doit comporter 6 chiffres.")
    }

    setLoading(true)
    try {
      await verifyOtpAndCreateProfile(email, verificationCode, displayName, avatarUrl)
      
      toast.success("E-mail vérifié ! Votre compte est officiellement actif.", {
        position: "bottom-center",
        style: {
          background: '#040405',
          color: '#ffffff',
          border: '2px solid hsl(180, 100%, 50%)',
          borderRadius: '1rem',
          boxShadow: '0 0 15px hsl(180, 100%, 50%, 0.4)',
          fontSize: '11px',
          fontWeight: '900',
          textTransform: 'uppercase',
          letterSpacing: '0.15em',
          padding: '12px 24px'
        }
      })
      navigate({ to: '/dashboard' })
    } catch (error: any) {
      console.error(error)
      toast.error(error.message || "Code incorrect ou expiré. Réessayez.")
    } finally {
      setLoading(false)
    }
  }

  const handleResendCode = async () => {
    setResending(true)
    try {
      await resendVerificationCode(email)
      toast.success("Un nouveau code a été envoyé sur votre e-mail.")
    } catch (err: any) {
      toast.error(err.message || "Impossible de renvoyer le code.")
    } finally {
      setResending(false)
    }
  }

  return (
    <div className="pt-24 md:pt-40 pb-16 md:pb-24 min-h-screen flex items-center justify-center bg-background px-4">
      <div className="max-w-md w-full glass p-10 rounded-[2.5rem] border-white/5 relative">
        
        {step === 'form' ? (
          /* FORMULAIRE D'INSCRIPTION STANDARD */
          <>
            <div className="text-center mb-10">
              <div className="w-24 h-24 rounded-full mx-auto mb-6 border-2 border-primary shadow-neon-violet overflow-hidden bg-white/5 flex items-center justify-center">
                {avatarUrl ? (
                  <img src={avatarUrl} alt="Preview" className="w-full h-full object-cover" />
                ) : (
                  <UserPlus className="text-primary/40" size={40} />
                )}
              </div>
              <h1 className="text-3xl font-display uppercase tracking-tighter text-white">Rejoindre l'Elite</h1>
            </div>

            <form onSubmit={handleRegister} className="space-y-5 text-left">
              <div>
                <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Nom de Gamer</label>
                <input required className="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-white mt-1 focus:outline-none focus:border-primary text-xs" value={displayName} onChange={(e) => setDisplayName(e.target.value)} />
              </div>

              <div>
                <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Photo de profil (URL)</label>
                <div className="relative mt-1">
                  <ImageIcon className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
                  <input 
                    placeholder="https://..." 
                    className="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-12 text-white focus:outline-none focus:border-primary text-xs" 
                    value={avatarUrl} 
                    onChange={(e) => setAvatarUrl(e.target.value)} 
                  />
                </div>
              </div>

              <div>
                <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Email</label>
                <input required type="email" placeholder="Saisir votre adresse Gmail" className="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-white mt-1 focus:outline-none focus:border-primary text-xs" value={email} onChange={(e) => setEmail(e.target.value)} />
              </div>

              <div>
                <label className="text-[10px] uppercase font-black text-primary tracking-widest ml-1">Mot de passe</label>
                <input required type="password" placeholder="Mot de passe fort requis" className="w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-white mt-1 focus:outline-none focus:border-primary text-xs" value={password} onChange={(e) => setPassword(e.target.value)} />
                
                <div className="mt-2.5 ml-1 space-y-1 text-[8px] uppercase font-black text-white/40 tracking-wider">
                  <span className="text-primary font-black block mb-1">Critères de sécurité requis :</span>
                  <ul className="list-disc pl-3.5 space-y-1">
                    <li>Au moins 6 caractères</li>
                    <li>Au moins une lettre majuscule (A-Z)</li>
                    <li>Au moins une lettre minuscule (a-z)</li>
                    <li>Au moins un chiffre (0-9)</li>
                    <li>Au moins un caractère spécial (ex: @, $, !, %)</li>
                  </ul>
                </div>
              </div>

              <NeonButton disabled={loading} className="w-full py-4 mt-4">
                {loading ? <Loader2 className="animate-spin" size={16} /> : "Créer ma carte de membre"}
              </NeonButton>
            </form>
          </>
        ) : (
          /* ÉCRAN DE VALIDATION DU CODE DE VÉRIFICATION (OTP) */
          <>
            <div className="text-center mb-10">
              <div className="w-16 h-16 bg-secondary/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-secondary/50">
                <KeyRound className="text-secondary animate-pulse" size={32} />
              </div>
              <h1 className="text-3xl font-display uppercase tracking-tighter text-white">Vérifier l'E-mail</h1>
              <p className="text-white/40 text-[9px] font-black uppercase mt-2 tracking-[0.2em] leading-relaxed">
                Saisissez le code de validation à 6 chiffres envoyé à l'adresse <br />
                <span className="text-secondary font-black block mt-1 lowercase tracking-normal">{email}</span>
              </p>
            </div>

            <form onSubmit={handleVerifyOtp} className="space-y-6 text-left">
              <div>
                <label className="text-[10px] uppercase font-black text-secondary tracking-widest ml-1">Code de confirmation (6 chiffres)</label>
                <div className="relative mt-2">
                  <KeyRound className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" size={18} />
                  <input 
                    required 
                    type="text" 
                    maxLength={6}
                    placeholder="Ex: 123456" 
                    className="w-full bg-white/5 border border-white/10 rounded-xl py-4 pl-12 text-white focus:outline-none focus:border-secondary text-center font-black tracking-[0.5em] text-lg" 
                    value={verificationCode} 
                    onChange={(e) => setVerificationCode(e.target.value.replace(/\D/g, ''))} 
                  />
                </div>
              </div>

              <div className="flex flex-col gap-4">
                <NeonButton variant="cyan" disabled={loading} className="w-full py-4 flex items-center justify-center gap-2">
                  {loading ? <Loader2 className="animate-spin" size={16} /> : "Confirmer mon compte"}
                </NeonButton>
                
                <button
                  type="button"
                  disabled={resending}
                  onClick={handleResendCode}
                  className="text-[9px] font-black uppercase tracking-widest text-white/40 hover:text-white transition-colors text-center"
                >
                  {resending ? "Renvoi en cours..." : "Renvoyer un nouveau code"}
                </button>
              </div>
            </form>
          </>
        )}
      </div>
    </div>
  )
}
</file>

<file path="src/pages/Reservation.tsx">
import { useState } from 'react'
import { useReservations } from '@/hooks/useReservations'
import { useUserMetadata } from '@/hooks/useUserMetadata' 
import { NeonButton } from '@/components/ui/NeonButton'
import { useAuth } from '@/hooks/useAuth'
import { Clock, Monitor, AlertCircle, Power, PowerOff, CheckCircle2, Activity, Users, Lock } from 'lucide-react'
import { cn } from '@blinkdotnew/ui'
import { toast } from 'react-hot-toast'
import { useStationsStatus } from '@/hooks/useStationsStatus'
import { useStationManagement } from '@/hooks/useStationManagement'
import { useQuery } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { usePrivileges } from '@/hooks/usePrivileges'
import { getRank } from '@/lib/ranks'
import { useLoyalty } from '@/hooks/useLoyalty'

const DURATIONS = [
  { label: '⚡ 15 min', value: 15, price: 500 },
  { label: '🔥 30 min', value: 30, price: 1000 },
  { label: '🎮 1h', value: 60, price: 1500 },
  { label: '🏆 1h30', value: 90, price: 2000 },
  { label: '📦 Pack 4h', value: 240, price: 5000 },
  { label: '👑 Pack Légende 5h', value: 300, price: 5000 }, // AJOUTÉ : Pack Légende
];

export function Reservation() {
  const { isAuthenticated, user } = useAuth()
  const { reservations, createReservation } = useReservations()
  const { data: metadata } = useUserMetadata() 
  const { data: occupiedStations } = useStationsStatus() 
  const { manualStates, toggleStation } = useStationManagement()
  const { checkWeeklyBonusUsed } = usePrivileges()
  const { data: loyalty } = useLoyalty()

  const isAdmin = (metadata as any)?.is_admin;

  // Détermination du VRAI cumul d'heures et du VRAI rang actuel
  const userHours = loyalty?.total_hours || 0
  const userRank = getRank(userHours)

  // 1. Définition de la valeur théorique du bonus hebdomadaire selon le rang
  const theoreticalBonus = 
    userRank.name === 'Novice' || userRank.name === 'Amateur' ? 15 : 
    userRank.name === 'Semi-Pro' ? 30 : 0

  // 2. Appel de la vérification dynamique sur la base de données
  const hasUsedWeeklyBonusQuery = checkWeeklyBonusUsed(theoreticalBonus)
  const hasAlreadyUsedWeeklyBonus = hasUsedWeeklyBonusQuery.data || false

  // 3. Application du bonus si éligible (Avec Stacking & Remplacement par l'Elite)
  let privilegeMinutesBonus = 0
  let privilegeAppliedLabel = ''

  if (isAuthenticated && !isAdmin) {
    if ((userRank.name === 'Novice' || userRank.name === 'Amateur') && !hasAlreadyUsedWeeklyBonus) {
      privilegeMinutesBonus = 15
      privilegeAppliedLabel = '🎁 Privilège Novice/Amateur : +15 min offertes ajoutées à votre 1ère session de la semaine !'
    } else if (userRank.name === 'Semi-Pro' && !hasAlreadyUsedWeeklyBonus) {
      privilegeMinutesBonus = 30
      privilegeAppliedLabel = '🎁 Privilège Semi-Pro : +30 min offertes ajoutées à votre 1ère session de la semaine !'
    } else if (userRank.name === 'Pro' || userRank.name === 'Elite') {
      privilegeMinutesBonus = 15
      privilegeAppliedLabel = `🎁 Privilège ${userRank.name} : +15 min offertes ajoutées d'office sur toutes vos sessions !`
    } else if (userRank.name === 'Légende') {
      privilegeMinutesBonus = 30
      privilegeAppliedLabel = '🎁 Privilège Légende : +30 min offertes ajoutées d\'office sur toutes vos sessions !'
    } else if (userRank.name === 'Iconique' || userRank.name === 'Divin') {
      privilegeMinutesBonus = 60
      privilegeAppliedLabel = `🎁 Privilège ${userRank.name} : +1h de session offerte ajoutée d'office sur toutes vos sessions !`
    }
  }

  // Le reste du fichier demeure inchangé
  const stations = Array.from({ length: 10 }, (_, i) => ({
    id: `PS5_${i + 1}`,
    name: `Station ${i + 1}`,
  }))

  const totalOccupied = stations.filter(station => {
    const isManuallyOccupied = manualStates?.find(s => s.station_id === station.id)?.is_manual_occupied;
    const isAutoOccupied = occupiedStations?.includes(station.id);
    return isAutoOccupied || isManuallyOccupied;
  }).length;
  const occupancyRate = Math.round((totalOccupied / 10) * 100);

  const activeSessions = reservations?.filter((res: any) => res.status === 'en cours') || [];
  
  const [selectedStation, setSelectedStation] = useState<string | null>(null)
  const [selectedDuration, setSelectedDuration] = useState<number>(60)
  const [totalPrice, setTotalPrice] = useState<number>(1500)
  const [selectedDate, setSelectedDate] = useState<string>(new Date().toISOString().split('T')[0])
  const [selectedTime, setSelectedTime] = useState<string>('14:00')
  const [showSuccessModal, setShowSuccessModal] = useState<boolean>(false)


  // LOGIQUE DE CONFIRMATION AVEC ENREGISTREMENT DU BONUS ET NOTIFICATIONS
  const handleBooking = async () => {
    if (!isAuthenticated || !user) { 
      toast.error("Connexion requise pour réserver une session");
      window.location.href = '/login'; 
      return; 
    }
    if (!selectedStation) { toast.error('Choisissez un poste'); return; }

    const finalDuration = selectedDuration + privilegeMinutesBonus // Application du bonus
    const startTime = new Date(`${selectedDate}T${selectedTime}`)
    const endTime = new Date(startTime.getTime() + finalDuration * 60000) // Date de fin augmentée de la durée totale (Base + Bonus)

    const hasConflict = reservations?.some((res: any) => {
      if (res.station_id !== selectedStation || res.status === 'annulé') return false;
      const resStart = new Date(res.start_time);
      const resEnd = new Date(res.end_time);
      return (startTime < resEnd && endTime > resStart);
    });

    if (hasConflict) {
      toast.error("Ce créneau est déjà réservé sur ce poste.");
      return;
    }

    try {
      // 1. Créer la réservation avec enregistrement du bonus appliqué
      await createReservation.mutateAsync({
        station_id: selectedStation,
        start_time: startTime.toISOString(),
        end_time: endTime.toISOString(),
        display_name: metadata?.display_name || user?.email || 'Gamer',
        status: 'pending',
        bonus_minutes_applied: privilegeMinutesBonus // Transmission de la valeur numérique du bonus
      })

      // 2. Si un bonus a été appliqué, envoyer automatiquement les deux notifications
      if (privilegeMinutesBonus > 0) {
        const displayName = metadata?.display_name || 'Gamer'

        // A. Notification pour le joueur
        await supabase.from('notifications').insert([{
          user_id: user.id,
          message: `Félicitations ! Vos +${privilegeMinutesBonus} min de privilège de Rang ont été automatiquement ajoutées à votre session sur ${selectedStation}.`
        }])

        // B. Notification pour l'administrateur
        const { data: admins } = await supabase
          .from('users_metadata')
          .select('user_id')
          .eq('is_admin', true)

        if (admins && admins.length > 0) {
          const adminNotifs = admins.map(admin => ({
            user_id: admin.user_id,
            message: `Le joueur @${displayName} a bénéficié de +${privilegeMinutesBonus} min de privilège automatique sur sa session (${selectedStation}).`
          }))
          await supabase.from('notifications').insert(adminNotifs)
        }
      }

      setShowSuccessModal(true);
    } catch (error: any) {
      console.error("Détails de l'erreur de réservation :", error);
      toast.error(`Erreur de réservation : ${error.message || error}`);
    }
  }

