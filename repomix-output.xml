<file path="src/components/tournaments/TournamentPredictions.tsx">
import React, { useState } from 'react';
import { Coins, Trophy, Sparkles, AlertCircle, CheckCircle2 } from 'lucide-react';
import { CyberCard } from '@/components/ui/CyberCard';
import { NeonButton } from '@/components/ui/NeonButton';
import { useTournamentStore, TournamentPrediction } from '@/lib/tournamentData';
import { useAuth } from '@/hooks/useAuth';
import { useUserMetadata } from '@/hooks/useUserMetadata';
import { toast } from 'react-hot-toast';
import { cyberAudio } from '@/lib/cyberAudio';

export function TournamentPredictions() {
  const { user } = useAuth();
  const { data: metadata } = useUserMetadata();
  const isAdmin = metadata?.is_admin || user?.user_metadata?.is_admin || false;

  const tournamentDataStore = useTournamentStore();
  const predictions: TournamentPrediction[] = tournamentDataStore.getPredictions();
  const [wagerAmount, setWagerAmount] = useState<number>(2);
  const [selectedWinner, setSelectedWinner] = useState<{ id: string; name: string } | null>({
    id: 'p-1',
    name: 'Kratos_CG'
  });

  const matches = tournamentDataStore.getBracketMatches();
  const liveFinal = matches.find(m => m.round === 'final');

  const handlePlaceBet = () => {
    if (!user) {
      toast.error("Veuillez vous connecter pour participer aux pronostics en jetons MANI !");
      return;
    }
    if (!selectedWinner || !liveFinal) return;

    cyberAudio.playSuccess();
    tournamentDataStore.placePrediction(
      user.id,
      user.user_metadata?.display_name || 'Gamer',
      liveFinal.id,
      selectedWinner.id,
      selectedWinner.name,
      wagerAmount
    );

    toast.success(`Pronostic enregistré : ${wagerAmount} MANI misés sur ${selectedWinner.name} ! 👑`, {
      position: 'bottom-center'
    });
  };

  return (
    <div className="space-y-6 text-left font-display">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/10">
        <div>
          <h3 className="text-xl md:text-2xl font-black uppercase text-white flex items-center gap-2">
