                        )}
                      </div>
                    </CyberCard>
                  );
                })}
              </div>
            </section>
          </div>
        )}

        {/* ONGLET 2 : CLASSEMENTS & HALL OF FAME */}
        {activeTab === 'leaderboard' && (
          <div className="space-y-12">
