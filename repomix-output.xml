import { useState } from 'react';
import { STATIONS } from './useStationsStatus';

export interface Station {
  id: string;
  name: string;
  zone: string;
  is_active?: boolean;
}

const DEFAULT_STATIONS: Station[] = STATIONS.map((id, index) => ({
  id,
  name: `Console #${index + 1}`,
  zone: index < 5 ? 'LIGNE NORD' : 'LIGNE SUD',
  is_active: true
}));

export function useStations() {
  const [stations, setStations] = useState<Station[]>(() => {
    const saved = localStorage.getItem('sanctuary_stations_catalog');
    if (saved) {
      try {
        return JSON.parse(saved);
      } catch {}
    }
    return DEFAULT_STATIONS;
  });

  return {
    stations
  };
}

export function groupStationsByZone(stations: Station[]) {
  const groups: { zone: string; stations: Station[] }[] = [];
  const map = new Map<string, Station[]>();

  for (const s of stations) {
    const list = map.get(s.zone) || [];
    list.push(s);
    map.set(s.zone, list);
  }

  for (const [zone, list] of map.entries()) {
    groups.push({ zone, stations: list });
  }

  return groups;
}
</file>

