@import url('https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap');
@import url('https://api.fontshare.com/v2/css?f[]=clash-display@200,300,400,500,600,700&display=swap');

/* ─────────────────────────────────────────────────────────────────────────────
   Blink UI Theme CSS
   REQUIRED for @blinkdotnew/ui components to render correctly.
   BlinkUIProvider adds .theme-{name} + .dark/.light to <html>,
   activating the matching CSS variable set below.
   ───────────────────────────────────────────────────────────────────────────── */
@import '@blinkdotnew/ui/styles';

