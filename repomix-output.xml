import { useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from './useAuth'

export function useManiTransfer() {
  const { user } = useAuth()
  const queryClient = useQueryClient()

  const transferMani = useMutation({
    mutationFn: async ({ receiverId, amount }: { receiverId: string, amount: number }) => {
      if (!user) throw new Error("Vous devez être connecté.")
      if (user.id === receiverId) throw new Error("Vous ne pouvez pas vous transférer des MANI à vous-même.")

      // Appel de la fonction de transaction atomique sécurisée en base de données
      const { error } = await supabase.rpc('transfer_mani', {
        sender_id_param: user.id,
        receiver_id_param: receiverId,
        amount_param: amount
      })

      if (error) throw error
    },
    onSuccess: () => {
      // Rafraîchir les soldes de points et de cagnottes
      queryClient.invalidateQueries({ queryKey: ['loyalty_points'] })
      queryClient.invalidateQueries({ queryKey: ['favorites'] })
    }
  })

  return { transferMani }
}
</file>

<file path="src/hooks/useMonthlyWinner.ts">
import { useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'
import { useAuth } from './useAuth'
import { useUserMetadata } from './useUserMetadata'
import { format, subMonths } from 'date-fns'
import { fr } from 'date-fns/locale'

export function useCheckAndProclaimWinner() {
  const { user } = useAuth()
  const { data: metadata } = useUserMetadata()
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async () => {
      if (!user) return

      // Déterminer le mois précédent à clôturer (ex: si on est en juin, on évalue mai '05-2026')
      const prevMonthDate = subMonths(new Date(), 1)
      const prevMonthYear = format(prevMonthDate, 'MM-yyyy')

      // A. Vérifier si un vainqueur a déjà été proclamé pour ce mois
      const { data: existing, error: fetchErr } = await supabase
        .from('monthly_winners')
        .select('*')
        .eq('month_year', prevMonthYear)
        .maybeSingle()

      if (fetchErr) throw fetchErr
      if (existing) return; // Déjà proclamé, on s'arrête

      // B. Récupérer le classement général complet des jetons
      const { data: generalList, error: genErr } = await supabase
        .from('loyalty_points')
        .select('user_id, display_name, points')
        .order('points', { ascending: false })

      if (genErr) throw genErr

      // C. Récupérer toutes les victoires des Teams du mois précédent
      const { data: teamStatsList, error: teamErr } = await supabase
        .from('team_stats')
        .select('user_id, team_id, victories')
        .eq('month_year', prevMonthYear)
        .order('victories', { ascending: false })

      if (teamErr) throw teamErr

      if (!generalList || generalList.length === 0) return;

      // D. Formule : Trouver le joueur dont la somme des deux classements est la plus basse
      let bestWinnerId = '';
      let bestWinnerName = '';
      let lowestScore = 999999;

      generalList.forEach((userRow, genIndex) => {
        const genRank = genIndex + 1; // Position générale (1-indexed)

        // Récupérer les stats de ce joueur dans ses Teams
        const userTeamStats = teamStatsList?.filter(s => s.user_id === userRow.user_id) || [];
        
        if (userTeamStats.length > 0) {
          userTeamStats.forEach(stat => {
            // Calculer sa position au sein de cette Team spécifique
            const teamSiblings = teamStatsList?.filter(s => s.team_id === stat.team_id) || [];
            const teamRank = teamSiblings.findIndex(s => s.user_id === userRow.user_id) + 1;

            const score = genRank + teamRank;

            // Garder la somme la plus petite possible
            if (score < lowestScore) {
              lowestScore = score;
              bestWinnerId = userRow.user_id;
              bestWinnerName = userRow.display_name;
            }
          });
        }
      });

      // E. Si un gagnant est trouvé, enregistrer et proclamer
      if (bestWinnerId) {
        // Enregistrer en base de données
        const { error: winErr } = await supabase
          .from('monthly_winners')
          .insert([{
            month_year: prevMonthYear,
            user_id: bestWinnerId,
            score: lowestScore
          }]);

        if (winErr) throw winErr;

        // Publier l'article de victoire sur la page Actualités
        const monthName = format(prevMonthDate, 'MMMM yyyy', { locale: fr });
        
        await supabase
          .from('news')
          .insert([{
            title: `👑 JOUEUR DU MOIS : FÉLICITATIONS À @${bestWinnerName} !`,
            excerpt: `En ce 1er du mois, nous proclamons officiellement @${bestWinnerName} comme le JOUEUR DU MOIS de ${monthName} ! Grâce à sa régularité exemplaire (somme des positions la plus faible dans sa Team et au général), il remporte le prestige du Sanctuary et les privilèges de caisse associés !`,
            category: 'Global',
            image: 'https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=600'
          }]);
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['news'] })
    }
  })
}
</file>

<file path="src/hooks/useNews.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'

export interface NewsItem {
  id: string
  title: string
  excerpt: string
  content?: string
  category: string
  image: string
  is_pinned?: boolean
  view_count?: number
  created_at: string
}

export const NEWS_CATEGORIES = ['Salle', 'Compétition', 'Communauté', 'Tournois', 'Privilèges']

export function isRagnarok(item: any): boolean {
  const cat = (item?.category || '').toLowerCase()
  const title = (item?.title || '').toLowerCase()
  return cat.includes('ragnarok') || title.includes('ragnarok')
}

export function newsImage(item: any): string {
  if (isRagnarok(item)) {
    return 'https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&q=80&w=800'
  }
  return item?.image || item?.image_url || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=800'
}

export function newsSummary(item: any): string {
  return item?.excerpt || item?.content?.slice(0, 160) || ''
}

export function useNews() {
  const queryClient = useQueryClient()

  const newsQuery = useQuery({
    queryKey: ['news'],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('news')
        .select('*')
        .order('created_at', { ascending: false })
      if (error) throw error
      return (data || []) as NewsItem[]
    }
  })

  const addNews = useMutation({
    mutationFn: async (payload: Partial<NewsItem>) => {
      const { data, error } = await supabase
        .from('news')
        .insert({ ...payload, view_count: 1 })
      if (error) throw error
      return data
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['news'] })
  })

  const updateNews = useMutation({
    mutationFn: async ({ id, ...payload }: { id: string } & Partial<NewsItem>) => {
      const { data, error } = await supabase.from('news').update(payload).eq('id', id)
      if (error) throw error
      return data
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['news'] })
  })

  const deleteNews = useMutation({
    mutationFn: async (id: string) => {
      const { error } = await supabase.from('news').delete().eq('id', id)
      if (error) throw error
      return id
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['news'] })
  })

  const togglePin = useMutation({
    mutationFn: async ({ id, is_pinned }: { id: string; is_pinned: boolean }) => {
      const { error } = await supabase.from('news').update({ is_pinned }).eq('id', id)
      if (error) throw error
      return { id, is_pinned }
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['news'] })
  })

  const registerView = useMutation({
    mutationFn: async (id: string) => {
      const item = newsQuery.data?.find((n) => n.id === id)
      const newCount = (item?.view_count || 0) + 1
      const { error } = await supabase.from('news').update({ view_count: newCount }).eq('id', id)
      if (error) throw error
      return { id, newCount }
    },
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['news'] })
  })

  return {
    news: newsQuery,
    addNews,
    updateNews,
    deleteNews,
    togglePin,
    registerView,
    withSchema: true
  }
}
</file>

<file path="src/hooks/useSanctuaryStatus.ts">
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { supabase } from '@/lib/supabase'

export function useSanctuaryStatus() {
  const queryClient = useQueryClient()

  // 1. Lire le statut actuel en direct
  const { data: statusData, isLoading } = useQuery({
    queryKey: ['sanctuary_status'],
    queryFn: async () => {
      const { data, error } = await supabase
        .from('community_settings')
        .select('value')
        .eq('key', 'sanctuary_status')
        .maybeSingle()

      if (error) throw error
      return data?.value || 'ouvert'
    },
    refetchInterval: 15000 // Actualisation dynamique toutes les 15 secondes
  })

  const currentStatus = statusData || 'ouvert'

  // 2. Modifier le statut d'ouverture (Admins)
  const toggleStatus = useMutation({
    mutationFn: async (newStatus: 'ouvert' | 'fermé') => {
      const { error } = await supabase
        .from('community_settings')
        .update({ value: newStatus, updated_at: new Date().toISOString() })
        .eq('key', 'sanctuary_status')

      if (error) throw error
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['sanctuary_status'] })
    }
  })

  return { currentStatus, isLoading, toggleStatus }
}
</file>

